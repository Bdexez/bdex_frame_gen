#version 450
// global_motion: the dominant translation between the two frames at the
// coarsest pyramid level, by exhaustive search over a radius much wider than
// the block matcher's. The hierarchical matcher follows at most about
// R * 2^(levels-1) pixels a frame from its coarsest level: a fast camera
// turn in a game (a mouse flick: 180+ px a frame at 1440p) goes past it, and
// the whole picture breaks up. Adding a level instead makes the coarsest
// blocks so large that objects moving on their own are averaged into the
// camera (measured: a game-like scene with independent objects lost 1.3 dB).
// The matcher's coarsest level now tries this vector as a second search
// centre per block (block_match.comp, pc.global), so the blocks keep their
// size and the reach grows to the camera's motion.
//   mode 0: one workgroup per candidate shift d, the mean |prev(p) - cur(p + d)|
//           over the frame's inner area (a margin of the radius all round,
//           every other pixel) into costs[];
//   mode 1: one workgroup, the lowest cost (first on ties) into the 1x1 image.
layout(local_size_x = 256) in;

layout(binding = 0) uniform sampler2D lumaPrev;  // coarsest level
layout(binding = 1) uniform sampler2D lumaCur;
layout(std430, binding = 2) buffer Costs { float cost[]; } costs;
layout(binding = 3, rg32f) uniform writeonly image2D globalOut;  // (motion prev -> cur, level pixels)

layout(push_constant) uniform PC {
    ivec2 size;   // level size
    int radius;   // search radius (level pixels)
    int mode;
} pc;

shared float partial[256];

void main() {
    const int W = 2 * pc.radius + 1;
    if (pc.mode == 1) {
        // (sequential: at most (2 * 16 + 1)^2 candidates, once a frame)
        if (gl_LocalInvocationID.x != 0u) return;
        int best = (W * W) / 2;  // the zero shift
        float bestCost = costs.cost[best];
        for (int c = 0; c < W * W; ++c)
            if (costs.cost[c] < bestCost) { bestCost = costs.cost[c]; best = c; }
        imageStore(globalOut, ivec2(0), vec4(float(best % W - pc.radius), float(best / W - pc.radius), bestCost, 0.0));
        return;
    }
    const int c = int(gl_WorkGroupID.x);
    const ivec2 d = ivec2(c % W - pc.radius, c / W - pc.radius);
    const ivec2 lo = ivec2(pc.radius), hi = pc.size - pc.radius;  // p + d stays inside
    const ivec2 n = max((hi - lo + 1) / 2, ivec2(0));                // every other pixel
    const int total = n.x * n.y;
    float s = 0.0;
    for (int i = int(gl_LocalInvocationID.x); i < total; i += 256) {
        ivec2 p = lo + 2 * ivec2(i % n.x, i / n.x);
        s += abs(texelFetch(lumaPrev, p, 0).r - texelFetch(lumaCur, p + d, 0).r);
    }
    partial[gl_LocalInvocationID.x] = s;
    barrier();
    for (uint w = 128u; w > 0u; w >>= 1) {
        if (gl_LocalInvocationID.x < w) partial[gl_LocalInvocationID.x] += partial[gl_LocalInvocationID.x + w];
        barrier();
    }
    if (gl_LocalInvocationID.x == 0u) costs.cost[c] = total > 0 ? partial[0] / float(total) : 1e9;
}
