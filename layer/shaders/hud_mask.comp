#version 450
// Learned static-overlay mask (hud_mask). Per render pixel, the number of
// consecutive real frames it stayed unchanged *while the camera moved* (a
// quarter of the pixels changed in the previous pair): HUD elements,
// minimaps, crosshairs reach dozens, moving content almost never does. With
// a fixed camera nothing is learned: a still background that an object then
// crosses is not an overlay (counting any motion — 1 % of the pixels — cost
// 0.3 dB in extrapolation on the demo's fixed-camera scene, the objects cut
// where they crossed long-still background). Any change resets the count. The synthesis
// keeps pixels past the threshold exactly as in the real frame instead of
// moving them with the flow (block flows drag overlay edges along with the
// content behind them).
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D prevSrc;  // previous real frame (render size)
layout(binding = 1) uniform sampler2D curSrc;   // current real frame
layout(binding = 2, rg32f) uniform image2D mask; // r: frames unchanged (while the picture moved); g: static_soft's evidence
layout(std430, binding = 3) buffer Counts { uint changed[2]; } cnt;
layout(binding = 4) uniform sampler2D flowBwd;  // this frame's finest backward flow (level pixels)

layout(push_constant) uniform PC {
    ivec2 size;
    int slot;        // counter written this frame; the other holds the previous pair's
    uint moving;     // changed pixels above which the previous pair counts as camera motion
    vec2 flowInv;    // 1 / (render pixels the flow covers)
    float flowScale; // flow units -> render pixels
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;
    vec3 d = abs(texelFetch(prevSrc, p, 0).rgb - texelFetch(curSrc, p, 0).rgb);
    // Two 8-bit codes of tolerance: dithering and compression noise.
    bool changed = max(d.r, max(d.g, d.b)) > 2.0 / 255.0;
    if (changed) atomicAdd(cnt.changed[pc.slot], 1u);
    bool moving = cnt.changed[1 - pc.slot] > pc.moving;
    vec2 m = imageLoad(mask, p).rg;
    // (a contrasted still pixel — text, an icon's edge — counts twice: a new
    // subtitle line learned in 2 frames instead of 4; a flat still patch of
    // the scene, the usual false overlay, keeps the slow count)
    float s = m.r;
    if (changed) s = 0.0;
    else if (moving) {
        const vec3 L = vec3(0.299, 0.587, 0.114);
        float c0 = dot(texelFetch(curSrc, p, 0).rgb, L);
        float cx = dot(texelFetch(curSrc, min(p + ivec2(1, 0), pc.size - 1), 0).rgb, L);
        float cy = dot(texelFetch(curSrc, min(p + ivec2(0, 1), pc.size - 1), 0).rgb, L);
        s = min(m.r + (max(abs(c0 - cx), abs(c0 - cy)) > 0.08 ? 2.0 : 1.0), 1000.0);
    }
    // static_soft's evidence: a HUD's anti-aliased text never stays quite
    // unchanged (its edge pixels mix the moving scene), but the "still"
    // hypothesis explains it clearly better than the scene's motion, frame
    // after frame — a moving object crossing a pixel does so once. Moving
    // average of that test while the scene at the pixel moves.
    const vec2 q = vec2(p) + 0.5;
    const vec2 B = texture(flowBwd, q * pc.flowInv).xy * pc.flowScale;
    float ev = m.g;
    if (length(B) > 1.0) {
        float still = 0.0, moved = 0.0;
        for (int k = 0; k < 5; ++k) {
            ivec2 o = k == 0 ? ivec2(0) : k == 1 ? ivec2(1, 0) : k == 2 ? ivec2(-1, 0) : k == 3 ? ivec2(0, 1) : ivec2(0, -1);
            ivec2 r = clamp(p + o, ivec2(0), pc.size - 1);
            vec3 b = texelFetch(curSrc, r, 0).rgb;
            still += dot(abs(texelFetch(prevSrc, r, 0).rgb - b), vec3(1.0 / 3.0));
            moved += dot(abs(texture(prevSrc, (vec2(r) + 0.5 + B) / vec2(pc.size)).rgb - b), vec3(1.0 / 3.0));
        }
        const float hit = smoothstep(2.0, 4.0, moved / (still + 0.01)) * (1.0 - smoothstep(0.04, 0.12, still * 0.2));
        ev = mix(ev, hit, 0.35);
    }
    imageStore(mask, p, vec4(s, ev, 0.0, 0.0));
}
