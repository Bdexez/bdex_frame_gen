#version 450
// Per-frame state of the frame generation, kept on the GPU so that nothing
// has to be read back before the frame is presented.
//
// mode 0 — duplicate test: counts the pixels of the level-0 luma pyramid that
// differ between the two pyramid slots (the previous and the current frame).
// mode 1 — update (one invocation): decides whether the current frame repeats
// the previous one, advances the content clock and writes, for every output
// slot, the time t the synthesis should show:
//
// Content time. A real frame shows the game's state at the moment it was
// presented; a repeated frame (the game presenting the same image twice,
// e.g. 30 fps content in a 60 fps loop) shows nothing new, so the content
// clock keeps the time the image *first* appeared. `ageLast` / `agePrev` are
// the ages (ms before now) of the current and the previous distinct images,
// so `interval = agePrev - ageLast` is the real content interval between
// them, which a frame-time spike or a run of duplicates makes differ from the
// smoothed present interval the pacing spreads the outputs over.
//
// Display model (the pacing of swapchain.cpp, non-FIFO): the m frames of a
// present go out at positions 0..m-1, I/m apart, the real frame at position r
// (frame_order.h: r = m-1 interpolation, 0 extrapolation, 1 hybrid), so
// everything shows the game L = I*r/m late and the frame at position j shows
// content time now + I(j-r)/m. t is the position of that content time
// between the two distinct images (0..1, before the real frame), or past the
// current one (1 + s, after it). With a steady frame rate and no duplicates
// this is exactly the fixed position (i/m in interpolation, 1 + i/m in
// extrapolation).
//
// A repeat may also be partial: see `partial` below (HUD over a slower world).
// Duplicates also gate the flow passes: a repeated image carries no motion,
// so the flow of the previous distinct pair is kept (its dispatches get zero
// workgroups through the indirect arguments written here) and extrapolation
// keeps moving along it; the real-frame slot, which would show the stale
// repeat, gets an extrapolated frame instead (the "only on duplicates"
// entries, see FrameGen::recordUpscaleReal).
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D lumaA;  // level-0 luma, pyramid slot 0
layout(binding = 1) uniform sampler2D lumaB;  // level-0 luma, pyramid slot 1

// Layout shared with FrameGen (kState* offsets) and the synthesis shaders.
layout(std430, binding = 2) buffer State {
    float meanCost;   // scene-cut cost (reduce_cost.comp)
    uint dup;         // the current frame repeats the previous one
    uint diffCount;   // mode 0 result: differing level-0 pixels
    float ageLast;    // ms since the current distinct image first appeared
    float agePrev;    // ms since the previous distinct image first appeared
    float interval;   // content interval between them (ms)
    uint repeats;     // repeated frames detected so far (statistics)
    float histDiff;   // scene_hist.comp: how far the brightness distribution moved (scene_cut_hist)
    float t[8];       // per output slot (up to 7 generated frames); [7] = the real frame's slot (extrapolated duplicate)
    float tileCost[64];
    uvec4 gateFull[24];     // dispatch size, w = 1: runs only on duplicates
    uint gateActive[72];    // VkDispatchIndirectCommand per entry
    uint tileDiff[64];      // mode 0: differing level-0 pixels per tile of an 8x8 grid
    uint prevChangedTiles;  // tiles that changed in the previous frame
} st;

layout(push_constant) uniform PC {
    ivec2 size;          // level-0 luma size (mode 0)
    int mode;
    int multiplier;      // frames presented for this real frame
    float sinceLastMs;   // time since the previous present
    float intervalMs;    // smoothed present interval (the pacing's)
    int flags;
    int gateCount;
    uint dupMaxPixels;   // at most this many differing pixels = a repeat
    float displayMs[8];  // FLAG_DISPLAY: predicted display times of outputs 0..6 and the real frame [7]
    int realPos;         // display position of the real frame among the m (frame_order.h): outputs before it are
                         // interpolated, those after it extrapolated (m-1 = interpolation, 0 = extrapolation)
} pc;

#define FLAG_RESET 1   // no usable previous frame: restart the clock
#define FLAG_DEDUP 2   // detect repeats (the previous pair's flow is valid to keep)
#define FLAG_EXTRAP 4  // extrapolation display model
#define FLAG_DISPLAY 8 // displayMs holds the measured-refresh prediction instead of the nominal schedule
#define FLAG_CONTENT 16 // content timing (frame_timing / dedup): measured intervals; else the nominal one

shared uint sCount;
shared uint sTile[64];

void main() {
    if (pc.mode == 0) {
        if (gl_LocalInvocationIndex == 0u) sCount = 0u;
        if (gl_LocalInvocationIndex < 64u) sTile[gl_LocalInvocationIndex] = 0u;
        barrier();
        ivec2 p = ivec2(gl_GlobalInvocationID.xy);
        if (all(lessThan(p, pc.size))) {
            float d = abs(texelFetch(lumaA, p, 0).r - texelFetch(lumaB, p, 0).r);
            if (d > 1.0 / 512.0) {
                atomicAdd(sCount, 1u);
                ivec2 tile = min(p * 8 / pc.size, ivec2(7));
                atomicAdd(sTile[tile.y * 8 + tile.x], 1u);
            }
        }
        barrier();
        if (gl_LocalInvocationIndex == 0u && sCount > 0u) atomicAdd(st.diffCount, sCount);
        if (gl_LocalInvocationIndex < 64u && sTile[gl_LocalInvocationIndex] > 0u)
            atomicAdd(st.tileDiff[gl_LocalInvocationIndex], sTile[gl_LocalInvocationIndex]);
        return;
    }
    if (gl_LocalInvocationIndex != 0u) return;

    bool reset = (pc.flags & FLAG_RESET) != 0;
    bool dedup = !reset && (pc.flags & FLAG_DEDUP) != 0;
    // Partial repeats: a game whose world runs at half the present rate
    // under a HUD or cursor updated every present (30 fps world, 60 fps
    // HUD) never repeats the whole image. It shows as a present where only
    // a few tiles changed right after one where most did — while a static
    // scene with a small moving object changes the same few tiles every
    // present, and is not a repeat.
    uint tilePixels = uint(max(pc.size.x / 8, 1) * max(pc.size.y / 8, 1));
    uint changedTiles = 0u;
    for (int i = 0; i < 64; ++i)
        if (st.tileDiff[i] > max(4u, tilePixels / 2048u)) ++changedTiles;
    bool partial = changedTiles <= 7u && st.prevChangedTiles >= 32u;
    bool dup = dedup && (st.diffCount <= pc.dupMaxPixels || partial);
    st.prevChangedTiles = dedup ? changedTiles : 0u;
    float I = max(pc.intervalMs, 0.5);
    float ageLast = st.ageLast, agePrev = st.agePrev;
    if (reset) {
        ageLast = 0.0;
        agePrev = I;
    } else {
        float dt = clamp(pc.sinceLastMs, 0.0, 1000.0);
        ageLast += dt;
        agePrev += dt;
        if (!dup) { agePrev = ageLast; ageLast = 0.0; }
        agePrev = min(agePrev, ageLast + 1000.0);  // a long pause is not an interval
    }
    float interval = max(agePrev - ageLast, 0.5);
    // Display correction alone (a known refresh grid, frame_timing and dedup
    // off): the content is assumed evenly timed, as by the fixed t.
    float ageT = ageLast;
    if ((pc.flags & FLAG_CONTENT) == 0) { interval = I; ageT = 0.0; }
    int m = max(pc.multiplier, 1);
    for (int i = 1; i < 8; ++i) {
        float t = 0.0;
        // Output i (1-based) shows at display position j; before the real
        // frame it is interpolated, after it extrapolated (frame_order.h).
        int j = i - 1 < pc.realPos ? i - 1 : i;
        bool extrap = j > pc.realPos;
        if (i < m) {
            if ((pc.flags & FLAG_DISPLAY) != 0) {
                // Each frame shows the content of its own display time: the
                // real frame shows "now", so an output displayed d ms after
                // it shows now + d (d < 0 before it, interpolation).
                float d = pc.displayMs[i - 1] - pc.displayMs[7];
                if (extrap) t = 1.0 + clamp((d + ageT) / interval, 0.0, 1.0);
                else t = clamp(1.0 + (d + ageT) / interval, 0.0, 1.0);
            } else {
                // Written as the fixed position plus a correction, so that a
                // steady game (interval == I, no repeat) gets exactly the fixed
                // t (i/m in the pure modes).
                float f = extrap ? float(j - pc.realPos) / float(m) : float(m - pc.realPos + j) / float(m);
                if (extrap) t = 1.0 + clamp(f + ((I - interval) * f + ageLast) / interval, 0.0, 1.0);
                else t = clamp(f + ((interval - I) * (1.0 - f) + ageLast) / interval, 0.0, 1.0);
            }
        }
        st.t[i - 1] = t;
    }
    st.t[7] = 1.0 + clamp(ageLast / interval, 0.0, 1.0);
    st.dup = dup ? 1u : 0u;
    if (dup) st.repeats += 1u;
    st.ageLast = ageLast;
    st.agePrev = agePrev;
    st.interval = interval;
    for (int e = 0; e < pc.gateCount; ++e) {
        uvec4 f = st.gateFull[e];
        bool run = f.w != 0u ? dup : !dup;
        st.gateActive[3 * e + 0] = run ? f.x : 0u;
        st.gateActive[3 * e + 1] = f.y;
        st.gateActive[3 * e + 2] = f.z;
    }
}
