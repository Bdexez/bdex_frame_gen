#version 450
// Synthesises the frame at time t in (0,1) between the previous and current
// frames using both flow fields. Each direction yields a candidate colour by
// approximate backward warping; the candidates are blended with weights
// derived from their photometric consistency, so occluded / mismatched
// regions fall back to the direction that actually agrees.
//
// The result is packed manually into a 32- or 64-bit uint image whose bits are
// copied verbatim into the swapchain image (this keeps us on mandatory storage
// formats regardless of the swapchain format).
#extension GL_GOOGLE_include_directive : require  // #include with glslangValidator too
#include "common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

// false: the lean variant the layer binds while every opt-in below is off
// (bicubic, pixel_vectors, occlusion, static guard / mask, frame timing,
// local cut, extrapolation accel / splat / reveal fill). Their code is then
// compiled out: the inlined Catmull-Rom taps alone raise the register count of
// the whole kernel. Same results as the full variant with the options off.
layout(constant_id = 0) const bool kOptIns = true;
// Which opt-ins this variant compiles in (FrameGen::synthesisVariant: a
// pipeline per set of options in use, built when first needed): the full
// variant has them all, and each one left out frees registers for the rest
// (1440p, the defaults of a discrete GPU: the full variant cost 0.33 ms more
// than the lean one for the same work). Bits: SYNTH_* in framegen_internal.h.
layout(constant_id = 1) const uint kFeatures = 0xFFFFFFFFu;
const bool kBicubic = (kFeatures & 1u) != 0u;
const bool kTiming = (kFeatures & 2u) != 0u;
const bool kLocalCut = (kFeatures & 4u) != 0u;
const bool kAccel = (kFeatures & 8u) != 0u;
const bool kReveal = (kFeatures & 16u) != 0u;
const bool kSplat = (kFeatures & 32u) != 0u;
const bool kPixelVectors = (kFeatures & 64u) != 0u;
const bool kOcclusion = (kFeatures & 256u) != 0u;
const bool kStaticGuard = (kFeatures & 1024u) != 0u;
const bool kStaticMask = (kFeatures & 2048u) != 0u;
const bool kDebugConf = (kFeatures & 4096u) != 0u;

layout(binding = 0) uniform sampler2D prevTex;
layout(binding = 1) uniform sampler2D curTex;
layout(binding = 2) uniform sampler2D flowFwd;  // prev -> cur
layout(binding = 3) uniform sampler2D flowBwd;  // cur -> prev
#ifdef SHARP
layout(binding = 4, rgba16f) uniform writeonly image2D outImg;  // linear, sharpened by a later CAS pass
#elif defined(OUT_64)
layout(binding = 4, rg32ui) uniform writeonly uimage2D outImg;
#else
layout(binding = 4, r32ui) uniform writeonly uimage2D outImg;
#endif
// Frame state (frame_state.comp): scene-cut cost, and with frame_timing /
// dedup the repeat flag and the content-time t of each output slot.
layout(std430, binding = 5) readonly buffer Cost {
    float meanCost;
    uint dup;
    uint diffCount;
    float ageLast;
    float agePrev;
    float interval;
    uint repeats;
    float histDiff;   // scene_hist.comp (scene_cut_hist)
    float t[8];       // [timing - 1]; [7] = the real frame's slot
    float tileCost[64];  // scene_cut_local grid (reduce_cost.comp)
} cost;
layout(std430, binding = 6) readonly buffer SplatMap { uint key[]; } splatMap;  // forward-splat sources (extrapolation, see splat.comp)
layout(binding = 7) uniform sampler2D prevBwdTex;  // previous pair's backward flow (extrapolate_accel)
layout(binding = 8) uniform sampler2D staticMask;  // hud_mask: frames each render pixel stayed unchanged (1x1 zero when off)
layout(binding = 9) uniform sampler2D confMap;     // flow_confidence: trust in the finest flow, 0..1 (1x1 one when off)
layout(binding = 10) uniform sampler2D accelMap;   // interp_accel: the content's acceleration at cur positions (accel_map.comp; 1x1 zero when off)

#define ENC_RGBA8      0u
#define ENC_BGRA8      1u
#define ENC_A2B10G10R10 2u
#define ENC_A2R10G10B10 3u
#define ENC_RGBA16F    4u
#define ENC_SRGB_FLAG  0x100u


#define DBG_NONE  0
#define DBG_FLOW  1
#define DBG_SPLIT 2
#define DBG_CONF  3   // debug=confidence: red where flow_confidence does not trust the flow

layout(push_constant) uniform PC {
    ivec2 size;
    float t;
    float flowScale;   // level pixels -> full resolution pixels
    uint encoding;
    int debugMode;
    float cutLow;
    float cutHigh;
    vec2 flowInvSize;  // 1 / (pixels covered by the flow textures)
    int iterations;    // fixed-point iterations of the flow lookup
    float occlusionStrength; // 0 keeps the historical interpolation path
    float staticGuard;       // 0 keeps the historical path; see staticness()
    int splat;               // extrapolation: take the source from the forward-splat map where one landed
    int pixelVectors;        // interpolation: per-pixel choice among the neighbouring blocks' vectors
    int transfer;            // TRANSFER_* of the sampled values (HDR: errors on a perceptual scale)
    int timing;              // > 0: t is cost.t[timing - 1] (content time), pc.t only tells the mode
    int localCut;            // > 0: scene cut from the localCut^2 tile grid instead of the frame mean
    float accel;             // weight of the second-order (acceleration) term (extrapolate_accel, interp_accel), 0 = constant velocity
    int bicubic;             // synth_bicubic: Catmull-Rom sampling along the trajectories (0 = bilinear, historical)
    float staticFrames;      // hud_mask: pixels unchanged for at least this many frames stay as in cur (0 = off)
    int revealFill;          // extrapolation: a revealed pixel takes the slower-moving (background) of the last two sources
    float staticSoft;        // static_soft: strength of hud_mask's "holds still" evidence (0 = off)
} pc;

// flow_confidence's trust at display pixel p (the map covers the flow's area).
float confidenceAt(vec2 p) { return texture(confMap, p * pc.flowInvSize).r; }

// Catmull-Rom sampling in 9 bilinear taps (the separable weights of the
// 4x4 kernel, the middle two taps of each axis merged into one bilinear
// fetch). Bilinear sampling low-passes whenever a trajectory lands between
// pixels, which with sub-pixel vectors is almost everywhere; the cubic
// keeps the detail. Clamped to the 2x2 neighbourhood (no ringing halos).
vec4 sampleCR(sampler2D tex, vec2 uv) {
    vec2 size = vec2(textureSize(tex, 0));
    vec2 sp = uv * size;
    vec2 t1 = floor(sp - 0.5) + 0.5;
    vec2 f = sp - t1;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 t0 = (t1 - 1.0) / size, t3 = (t1 + 2.0) / size, t12 = (t1 + w2 / w12) / size;
    vec4 c = texture(tex, vec2(t0.x, t0.y)) * w0.x * w0.y + texture(tex, vec2(t12.x, t0.y)) * w12.x * w0.y +
             texture(tex, vec2(t3.x, t0.y)) * w3.x * w0.y +
             texture(tex, vec2(t0.x, t12.y)) * w0.x * w12.y + texture(tex, vec2(t12.x, t12.y)) * w12.x * w12.y +
             texture(tex, vec2(t3.x, t12.y)) * w3.x * w12.y +
             texture(tex, vec2(t0.x, t3.y)) * w0.x * w3.y + texture(tex, vec2(t12.x, t3.y)) * w12.x * w3.y +
             texture(tex, vec2(t3.x, t3.y)) * w3.x * w3.y;
    vec2 base = t1 / size, d = 1.0 / size;
    vec4 a = texture(tex, base), b = texture(tex, base + vec2(d.x, 0.0));
    vec4 e = texture(tex, base + vec2(0.0, d.y)), g = texture(tex, base + d);
    return clamp(c, min(min(a, b), min(e, g)), max(max(a, b), max(e, g)));
}
// A colour along a trajectory: bilinear (historical) or Catmull-Rom.
vec4 sampleC(sampler2D tex, vec2 uv) { return kBicubic && pc.bicubic != 0 ? sampleCR(tex, uv) : texture(tex, uv); }

// Photometric error between two samples, on the scale the thresholds below
// are tuned for. SDR keeps the historical expression; HDR values (scRGB
// highlights at 10+, PQ white at 0.58) are brought to that scale first.
float colourError(vec4 a, vec4 b) {
    if (pc.transfer < TRANSFER_SCRGB) return luma(abs(a.rgb - b.rgb));
    return luma(abs(hdrToMatch(a.rgb, pc.transfer) - hdrToMatch(b.rgb, pc.transfer)));
}

// scene_cut_local: the mean matching cost around uv, bilinear between the
// tile centres (no visible tile edges in the fade).
float localCost(vec2 uv) {
    int n = pc.localCut;
    vec2 g = clamp(uv * float(n) - 0.5, vec2(0.0), vec2(float(n - 1)));
    ivec2 i0 = ivec2(floor(g));
    ivec2 i1 = min(i0 + 1, ivec2(n - 1));
    vec2 f = g - vec2(i0);
    float c00 = cost.tileCost[i0.y * n + i0.x], c10 = cost.tileCost[i0.y * n + i1.x];
    float c01 = cost.tileCost[i1.y * n + i0.x], c11 = cost.tileCost[i1.y * n + i1.x];
    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

vec2 fwdAt(vec2 p) { return texture(flowFwd, p * pc.flowInvSize).xy * pc.flowScale; }
vec2 bwdAt(vec2 p) { return texture(flowBwd, p * pc.flowInvSize).xy * pc.flowScale; }

// Extrapolation displacement of the content at p (a position in cur) to
// time 1 + s, B being the backward flow at p. Constant velocity: -s*B. With
// extrapolate_accel, the motion of the same content one pair earlier (the
// previous backward flow, looked up where the content was in prev) gives an
// acceleration a = v - v0, and a quadratic trajectory adds a*s(s+1)/2 —
// exact for a constant acceleration sampled at the two pair midpoints. The
// block flow is quantised to whole flow pixels (flowScale display pixels),
// so a velocity change below one to two of those steps is noise, not
// acceleration: it fades in over that range (without the dead zone, constant
// motion lost 0.1-0.9 dB). The change is also limited to half the current
// speed (+1 px): flow noise must not fling pixels around.
vec2 prevBwdAt(vec2 p) { return texture(prevBwdTex, p * pc.flowInvSize).xy * pc.flowScale; }
// Acceleration of the content at p (weight in .z): only where its whole
// trajectory over the two pairs stays in the picture (content entering at a
// border has no valid motion there; sampling clamps to the edge) and the
// current motion is trustworthy (its forward flow brings the content back).
vec3 accelAt(vec2 p) {
    vec2 size = vec2(pc.size);
    vec2 B = bwdAt(p);
    vec2 q0 = p + B;
    vec2 m = vec2(4.0 * pc.flowScale);
    if (any(lessThan(p, m)) || any(greaterThan(p, size - m)) || any(lessThan(q0, m)) || any(greaterThan(q0, size - m)))
        return vec3(0.0);
    vec2 B0 = prevBwdAt(q0);
    // Where it was one more frame earlier, per the previous flow and per the
    // current velocity: content that entered the picture since has no real
    // previous motion, and its flow is garbage that need not point outside.
    vec2 q1 = q0 + B0, q2 = q0 + B;
    if (any(lessThan(min(q1, q2), m)) || any(greaterThan(max(q1, q2), size - m))) return vec3(0.0);
    vec2 a = -B + B0;
    float inc = length(B + fwdAt(q0));
    return vec3(a, 1.0) * (1.0 - smoothstep(0.5 * pc.flowScale, 1.5 * pc.flowScale, inc));
}
vec2 extrapDisp(vec2 p, float s, vec2 B) {
    vec2 v = -B;
    // Averaged over a neighbourhood of blocks: acceleration is a smooth,
    // mostly camera-wide quantity, while single-block flow errors are not
    // (a 3x3 footprint of 16 display pixels: noise losses on constant
    // motion went from -0.4 to under -0.1 dB).
    // Only neighbours moving like p count (bilateral): an accelerating
    // object must not lend its acceleration to the background next to it.
    vec2 step = vec2(16.0 * pc.flowScale);
    vec3 acc = vec3(0.0);
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x) {
            vec2 n = p + vec2(x, y) * step;
            float same = 1.0 - smoothstep(pc.flowScale, 3.0 * pc.flowScale, length(bwdAt(n) - B));
            acc += accelAt(n) * same;
        }
    vec2 a = acc.z > 0.5 ? acc.xy / acc.z : vec2(0.0);
    float lim = 0.5 * length(v) + 1.0, la = length(a);
    if (la > lim) a *= lim / la;
    a *= smoothstep(pc.flowScale, 2.0 * pc.flowScale, la);
    return s * v + pc.accel * 0.5 * s * (s + 1.0) * a;
}

void store(ivec2 p, vec4 c) {
#ifdef SHARP
    // Keep linear colour; the CAS pass sharpens it and does the encoding.
    imageStore(outImg, p, clamp(c, 0.0, 65504.0));
}
#else
    uint enc = pc.encoding & 0xffu;
    if ((pc.encoding & ENC_SRGB_FLAG) != 0u) c.rgb = linearToSrgb(c.rgb);
    c = clamp(c, 0.0, enc == ENC_RGBA16F ? 65504.0 : 1.0);
#ifdef OUT_64
    imageStore(outImg, p, uvec4(packHalf2x16(c.rg), packHalf2x16(c.ba), 0u, 0u));
#else
    uint packed;
    if (enc == ENC_BGRA8) {
        packed = packUnorm4x8(c.bgra);
    } else if (enc == ENC_A2B10G10R10) {
        uvec4 q = uvec4(round(c * vec4(1023.0, 1023.0, 1023.0, 3.0)));
        packed = q.r | (q.g << 10) | (q.b << 20) | (q.a << 30);
    } else if (enc == ENC_A2R10G10B10) {
        uvec4 q = uvec4(round(c * vec4(1023.0, 1023.0, 1023.0, 3.0)));
        packed = q.b | (q.g << 10) | (q.r << 20) | (q.a << 30);
    } else {
        packed = packUnorm4x8(c);
    }
    imageStore(outImg, p, uvec4(packed, 0u, 0u, 0u));
#endif
}
#endif

// 1 where the pixel is identical in both frames. The flow is per block, so a
// static pixel (a HUD glyph, a minimap outline) inside a block that moves is
// otherwise warped along with it and smears. The test is per pixel on
// purpose: HUDs are see-through, so a glyph's neighbours usually move (a 3x3
// test never fires on them). Known cost: a small object crossing a pixel
// between the two frames leaves it unchanged in both and is dropped there at
// intermediate t; the caller tells the two apart with the flow at the pixel.
float staticness(vec2 uv) {
    ivec2 srcSize = textureSize(curTex, 0);  // render size (differs when upscaling)
    ivec2 sp = min(ivec2(uv * vec2(srcSize)), srcSize - 1);
    float d = colourError(texelFetch(prevTex, sp, 0), texelFetch(curTex, sp, 0));
    return 1.0 - smoothstep(0.0005, 0.003, d);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;
    vec2 fsize = vec2(pc.size);
    vec2 q = vec2(p) + 0.5;
    vec2 uv = q / fsize;
    float t = kTiming && pc.timing > 0 ? cost.t[pc.timing - 1] : pc.t;
    vec4 cur = texture(curTex, uv);
    float cut = smoothstep(pc.cutLow, pc.cutHigh, kLocalCut && pc.localCut > 0 ? localCost(uv) : cost.meanCost);
    vec4 c;
    vec2 F;

    if (kTiming && pc.timing > 0 && cost.dup != 0u && pc.t <= 1.0) {
        // dedup, interpolation: the game repeated its frame. The two images
        // are identical and the flow is the previous pair's (kept for
        // extrapolation), so warping would move the picture: show it as is.
        c = cur;
        F = vec2(0.0);
    } else if (pc.t > 1.0) {
        // Extrapolation: the frame after `cur`, assuming the motion measured
        // between prev and cur continues. The pixel that lands on q moved
        // from p = q + s*B(p) (B is the cur->prev flow, i.e. minus the
        // motion). Historically, where forward/backward consistency at p said
        // the motion was untrustworthy the pixel was kept in place — which
        // shows a moving object at its old position next to its warped copy
        // (a double image). Following the warp everywhere instead (it
        // stretches disoccluded areas rather than ghosting them) measured
        // +2.0 dB on the demo, +1.1 dB fast, +0.5 dB on a HUD scene (the
        // old behaviour, extrapolate_hold, was removed on 2026-10-04).
        float s = t - 1.0;
        vec2 B = bwdAt(q);
        vec2 pb;
        if (kAccel && pc.accel > 0.0) {  // uniform branch; the constant-velocity path below is the historical one
            pb = q - extrapDisp(q, s, B);
            for (int i = 0; i < pc.iterations; ++i) { B = bwdAt(pb); pb = q - extrapDisp(pb, s, B); }
        } else {
            pb = q + s * B;
            vec2 pbPrev = q, Bprev = B;
            for (int i = 0; i < pc.iterations; ++i) { pbPrev = pb; Bprev = B; B = bwdAt(pb); pb = q + s * B; }
            // reveal_fill: area the moving object uncovers after cur. The
            // fixed point does not exist there (the source alternates between
            // the object and the background it leaves); of the last two
            // sources take the one whose content moves less — the background
            // (the splat's model: the faster pixel is in front) — instead of
            // whichever the iteration count lands on.
            // Only there: a rotation also keeps the iteration from settling,
            // but its trajectory stays consistent (the forward flow at the
            // source leads back) — the demo's spinning square lost 0.4 dB
            // without this test.
            if (kReveal && pc.revealFill != 0 && pc.iterations > 0 && distance(pb, pbPrev) > 1.0 &&
                length(B + fwdAt(pb + B)) > 2.0) {
                vec2 Bpb = bwdAt(pb), BpbPrev = bwdAt(pbPrev);
                if (length(BpbPrev) < length(Bpb)) { pb = pbPrev; B = Bprev; }
            }
        }
        if (kSplat && pc.splat != 0) {
            uint key = splatMap.key[p.y * pc.size.x + p.x];
            if (key != 0xFFFFFFFFu) {
                // A pixel of cur landed here: sample it, shifted by the
                // sub-pixel offset between where it lands and q.
                uint index = key & 0x7FFFFFu;
                vec2 src = vec2(float(index % uint(pc.size.x)), float(index / uint(pc.size.x))) + 0.5;
                B = bwdAt(src);
                if (kAccel && pc.accel > 0.0) pb = src + (q - (src + extrapDisp(src, s, B)));
                else pb = src + (q - (src - s * B));
            }
        }
        c = sampleC(curTex, pb / fsize);
        F = -B;
    } else {
    // interp_accel: where the motion changed since the previous pair (a
    // mouse turn speeding up or slowing down), the content moves along a
    // curve between prev and cur, not a straight line: with a constant
    // acceleration a (accel_map.comp, once per frame), at time t it is
    // a*t*(1-t)/2 behind the straight line — a/8 at t = 0.5. Both lookups
    // of every trajectory move by it (qa); 0 keeps the straight line.
    vec2 qa = q;
    if (kAccel && pc.accel > 0.0) {
        vec2 pc0 = q - (1.0 - t) * bwdAt(q);  // about where q's content is in cur
        qa = q + pc.accel * 0.5 * t * (1.0 - t) * texture(accelMap, pc0 * pc.flowInvSize).xy;
    }
    // The flow fields are indexed by source-frame position, but we need the
    // motion of whatever lands on q at time t: a few fixed-point iterations
    // of p = q - t*F(p) find that source position.
    F = fwdAt(qa);
    vec2 pf = qa - t * F;
    for (int i = 0; i < pc.iterations; ++i) { F = fwdAt(pf); pf = qa - t * F; }
    vec4 cf = texture(prevTex, pf / fsize);
    vec4 cf2 = texture(curTex, (pf + F) / fsize);
    float ef = colourError(cf, cf2);

    vec2 B = bwdAt(qa);
    vec2 pb = qa - (1.0 - t) * B;
    for (int i = 0; i < pc.iterations; ++i) { B = bwdAt(pb); pb = qa - (1.0 - t) * B; }
    vec4 cb = texture(curTex, pb / fsize);
    vec4 cb2 = texture(prevTex, (pb + B) / fsize);
    float eb = colourError(cb, cb2);

    if (kSplat && pc.splat != 0) {
        // interp_splat: the pixels of prev and of cur the motion carries onto
        // q at time t (splat.comp: the left and right halves of the map) —
        // the layer in front at an object's edge, which the lookup at q often
        // misses — tried as trajectories (through q: q - t*F of the pixel's
        // own vector), kept where their two endpoints agree clearly better
        // and only where the trajectory found is imperfect (error > 0.02: a
        // still HUD pixel the moving background lands on keeps its own
        // trajectory — without it HUD -0.12 dB on top of pixel_vectors).
        // (The error test first: the candidates, 4 samples, are only
        // evaluated where they can be kept — same output, a third less work.)
        // (A half-resolution map, see splat.comp.)
        const int hw = (pc.size.x + 1) / 2;
        const ivec2 hp = p / 2;
        uint kp = ef > 0.02 ? splatMap.key[hp.y * 2 * hw + hp.x] : 0xFFFFFFFFu;
        if (kp != 0xFFFFFFFFu) {
            uint index = kp & 0x7FFFFFu;
            vec2 src = vec2(float(index % uint(pc.size.x)), float(index / uint(pc.size.x))) + 0.5;
            vec2 Fs = fwdAt(src);
            vec2 ps = qa - t * Fs;
            vec4 a = texture(prevTex, ps / fsize), b = texture(curTex, (ps + Fs) / fsize);
            float e = colourError(a, b);
            if (e < 0.9 * ef) { ef = e; F = Fs; pf = ps; cf = a; cf2 = b; }
        }
        uint kc = eb > 0.02 ? splatMap.key[hp.y * 2 * hw + hp.x + hw] : 0xFFFFFFFFu;
        if (kc != 0xFFFFFFFFu) {
            uint index = kc & 0x7FFFFFu;
            vec2 src = vec2(float(index % uint(pc.size.x)), float(index / uint(pc.size.x))) + 0.5;
            vec2 Bs = bwdAt(src);
            vec2 ps = qa - (1.0 - t) * Bs;
            vec4 a = texture(curTex, ps / fsize), b = texture(prevTex, (ps + Bs) / fsize);
            float e = colourError(a, b);
            if (e < 0.9 * eb) { eb = e; B = Bs; pb = ps; cb = a; cb2 = b; }
        }
    }

    if (kPixelVectors && pc.pixelVectors != 0) {
        // At an object boundary the bilinear flow lookup blends two motions
        // into a vector that is wrong for both. Try the unblended vectors of
        // the four flow texels around the source position and keep, per
        // pixel, the trajectory whose two endpoints agree best.
        // With Catmull-Rom sampling (13 fetches a sample), a candidate equal
        // to the current vector or to one already tried — same error, which
        // the strict "<" rejects — is skipped: away from motion boundaries
        // the four are equal, one evaluation instead of four, same output
        // (6.1 -> 2.1 ms on a 1.7 Mpx frame). With bilinear samples the test
        // costs more than it saves.
        // Only where it can matter: where the four vectors agree with each
        // other and with the one the lookup settled on (within half a display
        // pixel), trying them gives the same trajectory back, for 16 fetches
        // a pixel — most of a frame. (F must be in the test: the fixed-point
        // lookup reads the flow at its previous estimate, so four equal
        // vectors around pf can still disagree with F where it has not
        // converged — leaving F out lost 1.4 dB on the occlusion scene.)
        ivec2 fts = textureSize(flowFwd, 0);
        ivec2 f0 = ivec2(floor(pf * pc.flowInvSize * vec2(fts) - 0.5));
        vec2 triedF[4];
        vec2 lo = F, hi = F;
        for (int k = 0; k < 4; ++k) {
            triedF[k] = texelFetch(flowFwd, clamp(f0 + ivec2(k & 1, k >> 1), ivec2(0), fts - 1), 0).xy * pc.flowScale;
            lo = min(lo, triedF[k]);
            hi = max(hi, triedF[k]);
        }
        bool boundaryF = any(greaterThan(hi - lo, vec2(0.5)));
        for (int k = 0; k < 4 && boundaryF; ++k) {
            vec2 Fk = triedF[k];
            if (pc.bicubic != 0) {
                bool seen = all(equal(Fk, F));
                for (int j = 0; j < k; ++j) seen = seen || all(equal(Fk, triedF[j]));
                if (seen) continue;
            }
            vec2 pk = qa - t * Fk;
            vec4 a = texture(prevTex, pk / fsize), b = texture(curTex, (pk + Fk) / fsize);
            float e = colourError(a, b);
            if (e < ef) { ef = e; F = Fk; pf = pk; cf = a; cf2 = b; }
        }
        ivec2 bts = textureSize(flowBwd, 0);
        ivec2 b0 = ivec2(floor(pb * pc.flowInvSize * vec2(bts) - 0.5));
        vec2 triedB[4];
        lo = B;
        hi = B;
        for (int k = 0; k < 4; ++k) {
            triedB[k] = texelFetch(flowBwd, clamp(b0 + ivec2(k & 1, k >> 1), ivec2(0), bts - 1), 0).xy * pc.flowScale;
            lo = min(lo, triedB[k]);
            hi = max(hi, triedB[k]);
        }
        bool boundaryB = any(greaterThan(hi - lo, vec2(0.5)));
        for (int k = 0; k < 4 && boundaryB; ++k) {
            vec2 Bk = triedB[k];
            if (pc.bicubic != 0) {
                bool seen = all(equal(Bk, B));
                for (int j = 0; j < k; ++j) seen = seen || all(equal(Bk, triedB[j]));
                if (seen) continue;
            }
            vec2 pk = qa - (1.0 - t) * Bk;
            vec4 a = texture(curTex, pk / fsize), b = texture(prevTex, (pk + Bk) / fsize);
            float e = colourError(a, b);
            if (e < eb) { eb = e; B = Bk; pb = pk; cb = a; cb2 = b; }
        }
    }

    // Each trajectory carries a sample from both frames: the forward one from
    // prev at pf and from cur at pf+F, the backward one from cur at pb and from
    // prev at pb+B. Where the trajectory is photometrically consistent the two
    // samples agree and blending them (weighted by temporal position) is a
    // sharper, less noisy estimate than a single frame; where it is not, the
    // per-candidate weight below discards that trajectory anyway. The blend
    // amount is gated by the trajectory's own consistency so an occluded sample
    // never contaminates the candidate it belongs to.
    if (kBicubic && pc.bicubic != 0) {
        // synth_bicubic: the trajectories are chosen on bilinear samples
        // (the errors that pick them barely change), and only the four
        // colours blended below are read with Catmull-Rom (13 fetches each):
        // the sub-pixel detail where it shows, at a third of the cost of
        // cubic samples for every candidate tried.
        cf = sampleCR(prevTex, pf / fsize);
        cf2 = sampleCR(curTex, (pf + F) / fsize);
        cb = sampleCR(curTex, pb / fsize);
        cb2 = sampleCR(prevTex, (pb + B) / fsize);
    }
    float mf = (1.0 - smoothstep(0.04, 0.12, ef));
    float mb = (1.0 - smoothstep(0.04, 0.12, eb));
    vec4 cfc = mix(cf, cf2, t * mf);
    vec4 cbc = mix(cb, cb2, (1.0 - t) * mb);

    // Blend the two candidates, favouring the one whose motion is
    // photometrically consistent (and the temporally closer frame).
    const float eps = 0.01;
    float wf = (1.0 - t) / ((ef + eps) * (ef + eps));
    float wb = t / ((eb + eps) * (eb + eps));
    if (kOcclusion && pc.occlusionStrength > 0.0) {
        // A trajectory crossing an occlusion often matches a similar colour
        // on the wrong object. Reject it when the reverse flow does not bring
        // its endpoint back to its source, even if the colour error is low.
        vec2 ff = fwdAt(pf);
        vec2 bb = bwdAt(pb);
        float cfwd = 1.0 - smoothstep(1.0, 4.0, length(ff + bwdAt(pf + ff)));
        float cbwd = 1.0 - smoothstep(1.0, 4.0, length(bb + fwdAt(pb + bb)));
        // Block flow is approximate even on correct trajectories, so a low
        // colour error remains decisive. Consistency only resolves candidates
        // whose photometric evidence is already weak.
        float uncertainF = smoothstep(0.04, 0.12, ef);
        float uncertainB = smoothstep(0.04, 0.12, eb);
        wf *= 1.0 - 0.5 * pc.occlusionStrength * uncertainF * (1.0 - cfwd);
        wb *= 1.0 - 0.5 * pc.occlusionStrength * uncertainB * (1.0 - cbwd);

    }
    c = (wf * cfc + wb * cbc) / (wf + wb);

    // Historical fallback for regions neither trajectory explains. The
    // opt-in occlusion control retains the warp estimate more strongly; on
    // newly revealed pixels it avoids blending in the hidden endpoint.
    float bad = smoothstep(0.12, 0.25, min(ef, eb)) * (1.0 - pc.occlusionStrength);
    c = mix(c, mix(texture(prevTex, uv), cur, t), bad);
    }

    // Interpolation only: an unchanged pixel says nothing about the frame
    // after cur, where the flow may bring an object in (measured: the guard
    // costs 0.5-0.8 dB on the demo in extrapolation).
    if (kStaticGuard && pc.staticGuard > 0.0 && pc.t <= 1.0) {
        // Only where the flow *at q itself* says the content there moves: a
        // static pixel inside moving content is an overlay (HUD glyph). A
        // static background pixel that a small object crosses between the
        // frames has zero flow at q — the object arrives along its trajectory
        // from elsewhere — and keeps the warp.
        float moving = smoothstep(0.5, 2.0, min(length(fwdAt(q)), length(bwdAt(q))));
        c = mix(c, cur, pc.staticGuard * staticness(uv) * moving);
    }
    // hud_mask: a learned static overlay pixel is not moved with the flow.
    if (kStaticMask && pc.staticFrames > 0.0) {
        ivec2 ms = textureSize(staticMask, 0);
        ivec2 mp = min(ivec2(uv * vec2(ms)), ms - 1);
        const vec2 sm = texelFetch(staticMask, mp, 0).rg;
        if (sm.r >= pc.staticFrames) c = cur;
        else if (pc.staticSoft > 0.0 && sm.g > 0.3) {
            // static_soft: hud_mask's evidence that the pixel holds still
            // while the scene moves (anti-aliased HUD text) — leans in place.
            // (predicted frames, since 15/10: toward the current frame — a
            // cross-fade past it would extrapolate the brightness; game-like
            // HUD scenes +0.05 to +0.42 dB, edges +0.6 to +6, nothing lower)
            c = mix(c, pc.t <= 1.0 ? mix(texture(prevTex, uv), cur, t) : cur, smoothstep(0.3, 0.7, sm.g) * pc.staticSoft);
        }
    }
    c = mix(c, cur, cut);

    if (pc.debugMode == DBG_FLOW) {
        float mag = length(F);
        float hue = atan(F.y, F.x) / 6.2831853 + 0.5;
        vec3 col = hsv2rgb(vec3(hue, clamp(mag / 24.0, 0.0, 1.0), 1.0));
        c = vec4(mix(c.rgb, col, 0.75), 1.0);
    } else if (pc.debugMode == DBG_SPLIT) {
        if (p.x > pc.size.x / 2) c = cur;
        if (abs(p.x - pc.size.x / 2) < 2) c = vec4(1.0, 0.0, 1.0, 1.0);
    } else if (kDebugConf && pc.debugMode == DBG_CONF) {
        c.rgb = mix(c.rgb, vec3(1.0, 0.12, 0.08), 0.75 * (1.0 - confidenceAt(vec2(p) + 0.5)));
    }
    // (The fps HUD is drawn over the finished output by passes/fps_hud.cpp.)
    store(p, c);
}
