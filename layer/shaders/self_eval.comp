#version 450
// Online self-evaluation (online_tune): how well the previous pair's motion
// predicts the frame that just arrived. The content at q in the new frame
// was, at constant velocity, where the backward flow of the previous frame
// points: prediction = prev(q + B(q)). Its error is summed next to the error
// of predicting no motion (prev(q)); the ratio of the two rates the motion
// field without any reference but the game's own next frame. Pixels are
// sampled on a grid (every other one, sparser on large lumas); a workgroup reduces in shared memory
// and adds fixed-point sums (1/4096 luma units) to the slot's counters.
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D lumaPrev;  // frame n (finest luma)
layout(binding = 1) uniform sampler2D lumaCur;   // frame n+1
layout(binding = 2) uniform sampler2D flowBwd;   // pair (n-1, n): backward flow at positions of n
layout(binding = 3, std430) buffer Eval { uint v[]; } ev;

layout(push_constant) uniform PC {
    ivec2 size;         // finest luma resolution
    vec2 flowExtent;    // luma pixels covered by the flow grid
    int slot;           // counters at v[slot * 4 ..]: mc, zero, samples
    int step;           // sampling stride (at most 2^18 samples: the sums fit 32 bits)
} pc;

shared uint sMc[256], sZero[256], sN[256];

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy) * pc.step;
    uint mc = 0u, zr = 0u, n = 0u;
    if (all(lessThan(q, pc.size))) {
        vec2 c = vec2(q) + 0.5;
        vec2 src = c + texture(flowBwd, c / pc.flowExtent).xy;
        // Content that came from outside the picture has no prediction.
        if (all(greaterThanEqual(src, vec2(0.5))) && all(lessThan(src, vec2(pc.size) - 0.5))) {
            float cur = texelFetch(lumaCur, q, 0).r;
            float pred = texture(lumaPrev, src / vec2(pc.size)).r;
            float prv = texelFetch(lumaPrev, q, 0).r;
            mc = uint(min(abs(cur - pred), 1.0) * 4096.0 + 0.5);
            zr = uint(min(abs(cur - prv), 1.0) * 4096.0 + 0.5);
            n = 1u;
        }
    }
    uint i = gl_LocalInvocationIndex;
    sMc[i] = mc; sZero[i] = zr; sN[i] = n;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1) {
        if (i < s) { sMc[i] += sMc[i + s]; sZero[i] += sZero[i + s]; sN[i] += sN[i + s]; }
        barrier();
    }
    if (i == 0u && sN[0] > 0u) {
        atomicAdd(ev.v[pc.slot * 4 + 0], sMc[0]);
        atomicAdd(ev.v[pc.slot * 4 + 1], sZero[0]);
        atomicAdd(ev.v[pc.slot * 4 + 2], sN[0]);
    }
}
