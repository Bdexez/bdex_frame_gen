#version 450
#ifndef LUMA_FMT
#define LUMA_FMT r32f
#endif
// Hierarchical block matching: one workgroup per 8x8 block of the reference
// image, searching the target image in a (2R+1)^2 window centred on the
// displacement predicted by the coarser pyramid level. The block and the
// search region are staged in shared memory (with a 1-pixel border so that
// central-difference gradients are available). The 64 threads are split into
// four groups of 16, one per 4x4 quadrant of the block: each group evaluates
// every candidate on its quadrant, the partial costs are summed, and a tree
// reduction picks the best candidate.
//
// The matching cost is luma constancy (SAD on luma) plus, when gradWeight > 0,
// gradient constancy (SAD on the spatial gradient). Raw luma alone is ambiguous
// in textured or fast-moving regions, where several candidates score a similar
// SAD and a wrong one wins, tearing the warp; the gradient term matches on
// structure (edges) and disambiguates those cases. gradWeight = 0 is the plain
// luma-SAD behaviour, bit-for-bit.
//
// Ambiguity re-ranking (when censusWeight > 0): if the runner-up candidate
// scores within censusMargin of the winner, luma SAD alone cannot be trusted.
// The near-winners are then re-ranked on census Hamming distance — an 8-bit
// rank transform (bit k = neighbour k >= centre) computed from the staged
// tiles, which compares local structure instead of brightness. When
// censusWeight = 0 the winner is picked by the original per-thread minimum +
// tree reduction, so the default path is bit-for-bit identical to the plain
// luma-SAD pass (same costs, same comparisons, same tie-breaking); only the
// opt-in path uses the sequential winner/runner-up scan.
//
// Rotation/scale re-ranking (when rotWeight > 0): plain translation SAD
// cannot tell apart the near-winners of an ambiguous match on rotating or
// scaling content — every candidate is evaluated as a pure shift. When the
// winner is ambiguous (runner-up within ~4% of the winner), the top-2
// displacements are re-evaluated under a small set of local transforms
// (rotations x scales about the block centre, sampled bilinearly from the
// staged tile) and the winner is switched only if a transformed candidate
// beats it by a clear margin (2%). The flow output stays a translation — the
// transform only re-ranks candidates. Blocks whose winner already explains
// the content (low SAD, i.e. static / small motion) skip the re-ranking, and
// with rotWeight = 0 the pass is bit-for-bit identical to plain matching.
//
// Temporal prediction (when temporal != 0): the coarsest level has no coarser
// prediction and searches +-R around zero, which caps the motion the pyramid
// can follow. With temporal on, it searches around a constant-velocity
// prediction from the previous frame pair (Z, A) instead (the explicit
// zero-motion candidate is still evaluated), so a sustained fast pan is
// followed after a frame or two even beyond that range. The source is the
// previous *backward* flow A->Z, indexed by positions in A — the current
// reference frame — so no motion compensation is needed: forward A->B is
// predicted as -bwd(p) (temporal = 1); backward B->A at a position q of B
// follows the object back into A first: bwd(q + bwd(q)) (temporal = 2).
// Measured variants that lost: last frame's vector at the same block (the
// object has moved: -0.4 dB fast); an extra candidate at every level (more
// ambiguity: -0.1..-0.5 dB fast). A strong zero_bias defeats it, since the
// first steps away from zero are what it builds on. temporal = 0 leaves the
// pass bit-for-bit unchanged.
//
// Contrast-relative zero bias (when zeroBiasContrast > 0): the zero bias is an
// absolute cost per pixel of displacement, while the SAD gap between the true
// motion and "no motion" shrinks with the block's contrast. On smooth or
// low-contrast content the free zero-motion candidate then wins and the frame
// cross-fades (a 32 px/pair pan of a smooth texture: 28.5 dB, 46.2 dB without
// the bias). The bias is scaled by min(1, E / zeroBiasContrast), E being the
// block's mean luma gradient: textured static content (HUDs) keeps the full
// protection, smooth content loses it.
//
// Chroma re-ranking (when chromaWeight > 0): luma alone cannot see an edge
// between two colours of the same brightness (red on green, a coloured
// light on a grey wall): every candidate scores the same luma SAD there and
// the zero-motion candidate wins, so the content cross-fades instead of
// moving. The candidates whose luma SAD is within an absolute gate of the
// best one are re-ranked on cost + chromaWeight x chroma SAD (Cb/Cr pyramid,
// downsample_chroma.comp); a block whose luma discriminates keeps its luma
// choice unless chroma separates near-equals. Applied after the census
// re-ranking. chromaWeight = 0 leaves the pass bit-for-bit unchanged.
//
// Output flow is the displacement (in pixels of this level) that maps a
// position in the reference image to the matching position in the target.
#include "common.glsl"

#define BS   8
#define MAXR 4
#define ROTANC 3                       // staged-tile border (pixels) when rotation re-ranking is on
#define REG  (BS + 2 * MAXR + 2 * ROTANC)  // staged target region, incl. border
#define ROT_S 3                        // scales: 0.92, 1.0, 1.08
#define ROT_A 5                        // angles: -30, -10, 0, 10, 30 degrees
#define NROT (ROT_S * ROT_A)
#define ROT_ID (1 * ROT_A + 2)         // index of the identity transform (scale 1, angle 0)

const float kRotScale[ROT_S] = float[ROT_S](0.92, 1.0, 1.08);
const float kRotAngle[ROT_A] = float[ROT_A](-30.0, -10.0, 0.0, 10.0, 30.0);
#define RB   (BS + 2)              // staged reference block, +2 for the gradient border
#define NT   (BS * BS)
#define MAXCAND ((2 * MAXR + 1) * (2 * MAXR + 1) + 1)  // + the zero-motion candidate

layout(local_size_x = BS, local_size_y = BS) in;

layout(binding = 0, LUMA_FMT) uniform readonly image2D refImg;
layout(binding = 1, LUMA_FMT) uniform readonly image2D tgtImg;
layout(binding = 2) uniform sampler2D coarseFlow;
layout(binding = 3, rg32f) uniform writeonly image2D flowOut;
layout(binding = 4, r32f) uniform writeonly image2D costOut;
layout(binding = 5) uniform sampler2D prevFlow;   // previous pair's final backward flow at this level (temporal prediction)
layout(binding = 6) uniform sampler2D refChroma;  // Cb/Cr of the reference and target frames at this level (chroma re-ranking)
layout(binding = 7) uniform sampler2D tgtChroma;

layout(push_constant) uniform PC {
    ivec2 size;        // level resolution
    ivec2 blocks;      // flow resolution (blocks)
    int radius;        // search radius, <= MAXR
    int hasCoarse;     // 1: use coarseFlow as the search centre
    float smoothness;  // penalty per pixel of deviation from the prediction
    float zeroBias;    // penalty per pixel of absolute displacement
    float gradWeight;  // weight of the gradient-constancy term (0 = plain luma SAD)
    float censusWeight;// weight of the census re-ranking term (0 = off)
    float censusMargin;// relative cost margin that makes a match ambiguous
    float rotWeight;   // rotation/scale re-ranking of ambiguous winners (0 = off)
    int temporal;      // temporal prediction at the coarsest level: 0 off, 1 forward pass, 2 backward pass
    float zeroBiasContrast; // gradient energy at which the zero bias is fully applied (0 = absolute bias)
    float chromaWeight;     // weight of the chroma SAD in the chroma re-ranking (0 = off)
} pc;

#define CHROMA_GATE 0.01   // luma SAD (mean per pixel) within which candidates are re-ranked on chroma

shared float refBlk[RB * RB];
shared float tgt[REG * REG];
shared float qsad[4][MAXCAND];
shared float sCost[NT];                // per-thread minima for the tree reduction
shared int   sIdx[NT];
shared uint  refCen[NT];               // census of the 8x8 block interior
shared uint  tgtCen[(REG - 2) * (REG - 2)];  // census of the staged target interior
shared float sCost2[MAXCAND + 1];      // full per-candidate cost
shared float rpix[2][NROT][NT];        // per-pixel costs of the rotated re-evaluation
shared float rsum[2][NROT];            // block sums of rpix
shared ivec2 sBase;
shared int   sStatic;                  // static-block early-out (see main)
shared float sGrad[NT];                // per-pixel gradient magnitude (contrast-relative zero bias)
shared vec2  refC[RB * RB];            // chroma of the reference block (chroma re-ranking)
shared vec2  tgtC[REG * REG];          // chroma of the staged target region
shared float qcsad[4][MAXCAND];        // per-quadrant chroma SADs
shared float sSad[MAXCAND + 1];        // luma SAD per candidate (no penalties)
shared float sCsad[MAXCAND + 1];       // chroma SAD per candidate

// Neighbour order for the 8-bit census (3x3 minus the centre).
const ivec2 kCenOff[8] = ivec2[8](ivec2(-1, -1), ivec2(0, -1), ivec2(1, -1), ivec2(-1, 0),
                                  ivec2(1, 0), ivec2(-1, 1), ivec2(0, 1), ivec2(1, 1));

float loadRef(ivec2 p) { return imageLoad(refImg, clamp(p, ivec2(0), pc.size - 1)).r; }
float loadTgt(ivec2 p) { return imageLoad(tgtImg, clamp(p, ivec2(0), pc.size - 1)).r; }

// Mean census Hamming distance (0..1) between the reference block and the
// target region at candidate offset d (in staged-region pixels). `border` is
// the staged tile's border (1, or ROTANC when rotation re-ranking is on).
float censusHamming(ivec2 d, int regG, int border) {
    int tc = regG - 2 * border;
    uint acc = 0u;
    for (int y = 0; y < BS; ++y)
        for (int x = 0; x < BS; ++x)
            acc += uint(bitCount(refCen[y * BS + x] ^ tgtCen[(y + d.y) * tc + (x + d.x)]));
    return float(acc) * (1.0 / float(NT * 8));
}

void main() {
    ivec2 blk = ivec2(gl_WorkGroupID.xy);
    ivec2 lp = ivec2(gl_LocalInvocationID.xy);
    int tid = lp.y * BS + lp.x;
    ivec2 origin = blk * BS;
    int R = clamp(pc.radius, 1, MAXR);
    int W = 2 * R + 1;
    bool rotOn = pc.rotWeight > 0.0;
    int anc = rotOn ? ROTANC : 1;   // staged-tile border: wider when the rotation re-ranking samples beyond the block
    int regG = BS + 2 * R + 2 * anc;      // dynamic staged region side (incl. borders)
    int ncand = W * W;
    float gw = pc.gradWeight;

    if (tid == 0) {
        vec2 pred = vec2(0.0);
        if (pc.hasCoarse != 0) {
            vec2 uv = (vec2(blk) + 0.5) / vec2(pc.blocks);
            pred = texture(coarseFlow, uv).xy * 2.0;
        }
        if (pc.temporal != 0 && pc.hasCoarse == 0) {
            vec2 p = (vec2(blk) + 0.5) * float(BS);  // block centre, level pixels
            vec2 b = texture(prevFlow, p / vec2(pc.size)).xy;
            pred = pc.temporal == 1 ? -b : texture(prevFlow, (p + b) / vec2(pc.size)).xy;
        }
        sBase = ivec2(round(pred));
    }
    // Reference block with a 1-pixel border, top-left at origin - 1.
    for (int i = tid; i < RB * RB; i += NT) {
        ivec2 o = ivec2(i % RB, i / RB);
        refBlk[i] = loadRef(origin - 1 + o);
    }
    barrier();

    // Static block: predicted at zero and identical in both frames, 1-pixel
    // border included (which covers the gradient and census terms). The
    // zero-motion candidate then costs exactly 0 and, with a positive
    // smoothness penalty, every other candidate costs more: it is the unique
    // winner of every selection path (tree, census, and the rotation
    // re-ranking needs a cost above 0.02), so the search can be skipped with
    // a bit-identical result. Much of a game frame is static (HUD, menus,
    // scenery), and this is most of the matcher's time there. Not with the
    // chroma re-ranking, which may move a block whose luma is unchanged.
    if (sBase == ivec2(0) && pc.smoothness > 0.0 && pc.chromaWeight == 0.0) {  // uniform
        if (tid == 0) sStatic = 1;
        barrier();
        for (int i = tid; i < RB * RB; i += NT)
            if (refBlk[i] != loadTgt(origin - 1 + ivec2(i % RB, i / RB))) sStatic = 0;
        barrier();
        if (sStatic != 0) {
            if (tid == 0) {
                imageStore(flowOut, blk, vec4(0.0));
                imageStore(costOut, blk, vec4(0.0));
            }
            return;
        }
    }

    ivec2 base = sBase;
    float zb = pc.zeroBias;
    // Chroma re-ranking only where luma carries little structure: on
    // textured luma (a periodic pattern above all) chroma ties just as badly
    // and its noise then outweighs the smoothness penalty that picks the
    // right alias (measured: -2.3 dB on the demo's striped box without this).
    float chromaW = 0.0;
    if (pc.chromaWeight > 0.0) {  // uniform branch (push constant)
        int px = tid & (BS - 1), py = tid / BS;
        int ri = (py + 1) * RB + (px + 1);
        sGrad[tid] = 0.5 * (abs(refBlk[ri + 1] - refBlk[ri - 1]) + abs(refBlk[ri + RB] - refBlk[ri - RB]));
        barrier();
        float e = 0.0;
        for (int i = 0; i < NT; ++i) e += sGrad[i];
        chromaW = pc.chromaWeight * (1.0 - smoothstep(0.01, 0.03, e * (1.0 / float(NT))));
        barrier();
    }
    if (pc.zeroBiasContrast > 0.0) {  // uniform branch (push constant)
        int px = tid & (BS - 1), py = tid / BS;
        int ri = (py + 1) * RB + (px + 1);
        sGrad[tid] = 0.5 * (abs(refBlk[ri + 1] - refBlk[ri - 1]) + abs(refBlk[ri + RB] - refBlk[ri - RB]));
        barrier();
        float e = 0.0;
        for (int i = 0; i < NT; ++i) e += sGrad[i];
        zb *= min(1.0, e * (1.0 / float(NT)) / pc.zeroBiasContrast);
    }
    // Target region staged with a border (1 px normally, ROTANC when the
    // rotation re-ranking samples rotated positions), top-left at
    // origin+base-R-anc.
    ivec2 regOrigin = origin + base - R - anc;
    for (int i = tid; i < regG * regG; i += NT) {
        ivec2 o = ivec2(i % regG, i / regG);
        tgt[i] = loadTgt(regOrigin + o);
    }
    bool chromaOn = pc.chromaWeight > 0.0;
    if (chromaOn) {  // uniform branch (push constant)
        for (int i = tid; i < RB * RB; i += NT)
            refC[i] = texelFetch(refChroma, clamp(origin - 1 + ivec2(i % RB, i / RB), ivec2(0), pc.size - 1), 0).rg;
        for (int i = tid; i < regG * regG; i += NT)
            tgtC[i] = texelFetch(tgtChroma, clamp(regOrigin + ivec2(i % regG, i / regG), ivec2(0), pc.size - 1), 0).rg;
    }
    barrier();

    // Census (rank transform) of the staged tiles; the 1-pixel gradient border
    // doubles as the census border. Uniform branch: censusWeight is a push
    // constant. The barrier after the quadrant costs below also publishes this.
    if (pc.censusWeight > 0.0) {
        {
            int px = tid & (BS - 1), py = tid / BS;
            float c = refBlk[(py + 1) * RB + (px + 1)];
            uint bits = 0u;
            for (int k = 0; k < 8; ++k) {
                float n = refBlk[(py + 1 + kCenOff[k].y) * RB + (px + 1 + kCenOff[k].x)];
                bits |= (n >= c ? 1u : 0u) << k;
            }
            refCen[tid] = bits;
        }
        for (int i = tid; i < (regG - 2 * anc) * (regG - 2 * anc); i += NT) {
            int px = i % (regG - 2 * anc), py = i / (regG - 2 * anc);
            float c = tgt[(py + anc) * regG + (px + anc)];
            uint bits = 0u;
            for (int k = 0; k < 8; ++k) {
                float n = tgt[(py + anc + kCenOff[k].y) * regG + (px + anc + kCenOff[k].x)];
                bits |= (n >= c ? 1u : 0u) << k;
            }
            tgtCen[i] = bits;
        }
    }

    // Partial costs: quadrant q = tid / 16, candidates c = tid % 16 + 16k.
    // Candidate `ncand` is "no motion" (always considered so that static HUD
    // elements stay perfectly stable); it may fall outside the staged region
    // and is read from the image directly.
    int quad = tid >> 4;
    int qtid = tid & 15;
    ivec2 qo = ivec2((quad & 1) * 4, (quad >> 1) * 4);
    bool zeroInWindow = all(equal(base, ivec2(0)));
    int total = zeroInWindow ? ncand : ncand + 1;
    for (int c = qtid; c < total; c += 16) {
        float sad = 0.0;
        if (c < ncand) {
            ivec2 d = ivec2(c % W, c / W);
            for (int y = 0; y < 4; ++y) {
                int by = qo.y + y;
                for (int x = 0; x < 4; ++x) {
                    int bx = qo.x + x;
                    int ri = (by + 1) * RB + (bx + 1);
                    int ti = (d.y + by + anc) * regG + (d.x + bx + anc);
                    sad += abs(refBlk[ri] - tgt[ti]);
                    if (gw > 0.0) {
                        vec2 rg = vec2(refBlk[ri + 1] - refBlk[ri - 1], refBlk[ri + RB] - refBlk[ri - RB]);
                        vec2 tg = vec2(tgt[ti + 1] - tgt[ti - 1], tgt[ti + regG] - tgt[ti - regG]);
                        sad += gw * (abs(rg.x - tg.x) + abs(rg.y - tg.y));
                    }
                }
            }
        } else {
            for (int y = 0; y < 4; ++y)
                for (int x = 0; x < 4; ++x) {
                    ivec2 o = qo + ivec2(x, y);
                    int ri = (o.y + 1) * RB + (o.x + 1);
                    ivec2 ip = origin + o;
                    sad += abs(refBlk[ri] - loadTgt(ip));
                    if (gw > 0.0) {
                        vec2 rg = vec2(refBlk[ri + 1] - refBlk[ri - 1], refBlk[ri + RB] - refBlk[ri - RB]);
                        vec2 tg = vec2(loadTgt(ip + ivec2(1, 0)) - loadTgt(ip - ivec2(1, 0)),
                                       loadTgt(ip + ivec2(0, 1)) - loadTgt(ip - ivec2(0, 1)));
                        sad += gw * (abs(rg.x - tg.x) + abs(rg.y - tg.y));
                    }
                }
        }
        qsad[quad][c] = sad;
    }
    if (chromaOn) {
        for (int c = qtid; c < total; c += 16) {
            float cs = 0.0;
            for (int y = 0; y < 4; ++y)
                for (int x = 0; x < 4; ++x) {
                    ivec2 o = qo + ivec2(x, y);
                    vec2 rc = refC[(o.y + 1) * RB + (o.x + 1)];
                    vec2 tc;
                    if (c < ncand) tc = tgtC[(c / W + o.y + anc) * regG + (c % W + o.x + anc)];
                    else tc = texelFetch(tgtChroma, clamp(origin + o, ivec2(0), pc.size - 1), 0).rg;
                    cs += abs(rc.x - tc.x) + abs(rc.y - tc.y);
                }
            qcsad[quad][c] = cs;
        }
    }
    barrier();

    // Full per-candidate costs (luma SAD + penalties). Slot ncand holds the
    // zero-motion candidate when it falls outside the window.
    for (int c = tid; c < total; c += NT) {
        float sad = (qsad[0][c] + qsad[1][c] + qsad[2][c] + qsad[3][c]) * (1.0 / float(NT));
        if (c < ncand) {
            ivec2 d = ivec2(c % W, c / W);
            vec2 disp = vec2(base + d - R);
            sCost2[c] = sad + pc.smoothness * length(vec2(d - R)) + zb * length(disp);
        } else {
            sCost2[c] = sad;
        }
        if (chromaOn) {
            sSad[c] = sad;
            sCsad[c] = (qcsad[0][c] + qcsad[1][c] + qcsad[2][c] + qcsad[3][c]) * (1.0 / float(NT));
        }
    }
    barrier();

    // Winner and runner-up: lowest cost, first index on a tie (deterministic;
    // the zero-motion candidate sits last so it wins ties least). Computed
    // redundantly by every thread, so no extra broadcast is needed. This scan
    // supplies the runner-up (secondIdx/second) that the rotation re-ranking
    // needs; the winner it finds does NOT decide the output on its own — at
    // censusWeight = 0 the bit-for-bit tree reduction below overrides bestIdx
    // (AGENTS.md §6), and at censusWeight > 0 the census rerank does.
    float best = 1e30, second = 1e30;
    int bestIdx = 0, secondIdx = -1;
    for (int c = 0; c < total; ++c) {
        float v = sCost2[c];
        if (v < best) { second = best; secondIdx = bestIdx; best = v; bestIdx = c; }
        else if (v < second) { second = v; secondIdx = c; }
    }

    // Displacement of a candidate slot in this level's pixels (the zero-motion
    // slot `ncand` means "no motion").
#define DISPOF(c) ((c) >= ncand ? ivec2(0) : base + ivec2((c) % W, (c) / W) - R)

    // Winner selection proper. censusWeight = 0: the original per-thread minimum
    // over strided candidates plus the tree reduction — bit-for-bit identical to
    // the plain luma-SAD pass from before the census term existed (the scan
    // above only supplies the runner-up, never the output). censusWeight > 0:
    // re-rank the ambiguous near-winners on census structure.
    if (pc.censusWeight > 0.0) {
        // Ambiguity re-ranking: a runner-up within the margin means luma SAD
        // does not discriminate; let the census (structure, not brightness)
        // decide among the near-winners. The extra zero-motion candidate is
        // not re-ranked: the zero bias already protects static content, and
        // static blocks are confident winners anyway.
        float margin = pc.censusMargin * max(best, 0.02);
        if (second < best + margin) {
            int bi = bestIdx;
            float bc = 1e30;
            for (int c = 0; c < ncand; ++c) {
                if (sCost2[c] >= best + margin) continue;
                float cc = sCost2[c] + pc.censusWeight * censusHamming(ivec2(c % W, c / W), regG, anc);
                if (cc < bc) { bc = cc; bi = c; }
            }
            bestIdx = bi;
        }
    } else {
        float best = 1e30;
        bestIdx = 0;
        for (int c = tid; c < total; c += NT) {
            float v = sCost2[c];
            if (v < best) { best = v; bestIdx = c; }
        }
        sCost[tid] = best;
        sIdx[tid] = bestIdx;
        barrier();
        for (int s = NT / 2; s > 0; s >>= 1) {
            if (tid < s && sCost[tid + s] < sCost[tid]) {
                sCost[tid] = sCost[tid + s];
                sIdx[tid] = sIdx[tid + s];
            }
            barrier();
        }
        bestIdx = sIdx[0];
    }
    if (chromaOn && chromaW > 0.0) {
        // Chroma re-ranking among the candidates luma cannot tell apart. The
        // winner selected above stays the incumbent and only a strictly
        // better combined cost replaces it: flat areas are full of exact
        // ties, and a scan's "first index wins" there is the tie-breaking
        // that broke 0549e44 (AGENTS.md §6) — measured -1.7 dB on the demo.
        float minSad = 1e30;
        for (int c = 0; c < total; ++c) minSad = min(minSad, sSad[c]);
        // A challenger must beat the incumbent clearly: halve its chroma
        // mismatch (an isoluminant edge seen as "no motion" leaves a large
        // one that the true displacement removes), not just shave noise.
        int bi = bestIdx;
        float bc = sCost2[bi] + chromaW * (0.5 * sCsad[bi] - 0.002);
        for (int c = 0; c < total; ++c) {
            if (sSad[c] > minSad + CHROMA_GATE) continue;
            float cc = sCost2[c] + chromaW * sCsad[c];
            if (cc < bc) { bc = cc; bi = c; }
        }
        bestIdx = bi;
    }
    // Final output displacement of the winner (the census=0 tree reduction or
    // the census>0 rerank set bestIdx above); the rotation re-ranking may
    // override it below. Set here, after selection, so the bit-for-bit census=0
    // path uses the tree-reduction winner and nothing else.
    ivec2 outDisp = DISPOF(bestIdx);
    // Rotation/scale re-ranking: when the winner is ambiguous (runner-up
    // close behind) and does not already explain the block well, the top-2
    // displacements are re-evaluated under local rotations and scales about
    // the block centre — a rotating object scores a much better SAD under its
    // true transform than any pure shift. The flow output stays a translation;
    // the transform only decides which translation wins. Uniform branch.
    if (rotOn && bestIdx < ncand && secondIdx >= 0 && second < best * 1.50 && best > 0.02) {
        ivec2 dd[2];
        dd[0] = outDisp;
        dd[1] = secondIdx >= 0 ? DISPOF(secondIdx) : ivec2(0);
        // The zero-motion slot (ncand) lies outside the staged tile when the
        // window does not contain zero: it cannot be re-evaluated from the
        // tile (reading it there went out of bounds: undefined results).
        int nj = (secondIdx >= 0 && secondIdx < ncand && dd[1] != dd[0]) ? 2 : 1;
        int px = tid & (BS - 1), py = tid >> 3;
        float rv = refBlk[(py + 1) * RB + (px + 1)];
        vec2 q = vec2(px, py) - 3.5;
        for (int j = 0; j < nj; ++j)
            for (int k = 0; k < NROT; ++k) {
                float sc = kRotScale[k / ROT_A];
                float th = radians(kRotAngle[k % ROT_A]);
                vec2 p = (sc == 1.0 && th == 0.0) ? q
                        : sc * vec2(cos(th) * q.x - sin(th) * q.y, sin(th) * q.x + cos(th) * q.y);
                // Sample position in staged-tile pixels: anchor at origin+base-R-anc,
                // so the displacement is taken relative to base (dd is absolute;
                // using it as is read outside the tile whenever base != 0).
                vec2 pos = vec2(R + anc) + vec2(dd[j] - base) + 3.5 + p;
                float tv;
                if (sc == 1.0 && th == 0.0) {
                    // Identity transform: integer sampling, exactly the first
                    // pass's evaluation of the same displacement.
                    ivec2 ip = ivec2(round(pos));
                    tv = tgt[ip.y * regG + ip.x];
                } else {
                    vec2 fl = floor(pos), f = pos - fl;
                    ivec2 i0 = ivec2(fl);
                    i0 = clamp(i0, ivec2(0), ivec2(regG - 2));
                    float t00 = tgt[i0.y * regG + i0.x];
                    float t10 = tgt[i0.y * regG + i0.x + 1];
                    float t01 = tgt[(i0.y + 1) * regG + i0.x];
                    float t11 = tgt[(i0.y + 1) * regG + i0.x + 1];
                    tv = mix(mix(t00, t10, f.x), mix(t01, t11, f.x), f.y);
                }
                rpix[j][k][tid] = abs(rv - tv);
            }
        barrier();
        if (tid < 2 * NROT) {
            int j = tid / NROT, k = tid % NROT;
            if (j < nj) {
                float s = 0.0;
                for (int i = 0; i < NT; ++i) s += rpix[j][k][i];
                rsum[j][k] = s;
            }
        }
        barrier();
        // The identity evaluation of the winner is the control; a transformed
        // candidate must beat the running best by 2% to switch, and the
        // winner's displacement is preferred on ties (it is scanned first).
        int bj = 0, bk = ROT_ID;
        float bv = rsum[0][ROT_ID];
        for (int j = 0; j < nj; ++j)
            for (int k = 0; k < NROT; ++k) {
                if (j == 0 && k == ROT_ID) continue;
                float v = rsum[j][k] * (1.0 + 0.03 * float(j));
                if (v < bv * 0.995) { bv = v; bj = j; bk = k; }
            }
        outDisp = dd[bj];
    }
#undef DISPOF

    if (tid == 0) {
        // The cost output feeds scene-cut detection, whose thresholds are tuned
        // against plain luma SAD; recompute the winner's luma-only SAD rather
        // than exporting the (gradient-inflated) combined cost.
        float lumaSad = 0.0;
        for (int y = 0; y < BS; ++y)
            for (int x = 0; x < BS; ++x)
                lumaSad += abs(refBlk[(y + 1) * RB + (x + 1)] - loadTgt(origin + ivec2(x, y) + outDisp));
        imageStore(flowOut, blk, vec4(vec2(outDisp), 0.0, 0.0));
        imageStore(costOut, blk, vec4(lumaSad * (1.0 / float(NT)), 0.0, 0.0, 0.0));
    }
}
