#version 450
// parallax_search: thin near structures in a sideways move — a railing's
// posts, poles, a fence — move faster than the scenery behind them, in the
// same direction (parallax), and the hierarchical search never sees them:
// at the coarse levels a post a few pixels wide is averaged away, the finer
// levels search a few pixels around the coarse level's motion (the
// background's), and the post takes the background's vector — it breaks up
// in the generated frames. Where the finest flow explains its 8x8 window
// poorly, multiples of its own vector (x0.5 for far, x1.5-x3 for near
// content moving alike) are tried, each with a pixel either side along the
// motion, and the
// best is kept where it explains the window clearly better — and where the
// other direction agrees (the backward search where the content lands finds
// the opposite vector): on motion-blurred or low-contrast content a multiple
// of the vector sometimes matches by chance in one direction only.
//   mode 0: the candidates of both directions into candFwd / candBwd
//   mode 1: each kept where the other direction's candidate agrees
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rg32f) uniform image2D flowFwd;   // finest level, in place
layout(binding = 1, rg32f) uniform image2D flowBwd;
layout(binding = 2) uniform sampler2D lumaPrev;       // finest luma of the pair
layout(binding = 3) uniform sampler2D lumaCur;
layout(binding = 4, rg32f) uniform image2D candFwd;   // mode 0 -> 1 (NaN: no candidate)
layout(binding = 5, rg32f) uniform image2D candBwd;

layout(push_constant) uniform PC {
    ivec2 size;       // flow grid (texels)
    ivec2 luma;       // finest luma resolution
    int block;        // level pixels per flow texel
    float minSad;     // mean |difference| above which a window counts as poorly explained
    float gain;       // a candidate must bring the window's SAD below gain x the current one
    int mode;
    float agree;      // mode 1: the two directions' candidates within this (level pixels)
} pc;

// The 8x8 window centred on the texel (4x4 texels) or the texel itself
// (8x8), every other pixel (a checkerboard: half the fetches, the same
// window): its reference values read once for all the candidates.
const int kWin = 32;
void loadRef(sampler2D refTex, ivec2 origin, out float ref[kWin]) {
    int m = (8 - pc.block) / 2, n = 0;
    for (int y = -m; y < pc.block + m; ++y)
        for (int x = -m + ((y + m) & 1); x < pc.block + m; x += 2)
            ref[n++] = texelFetch(refTex, clamp(origin + ivec2(x, y), ivec2(0), pc.luma - 1), 0).r;
}
float sadAt(float ref[kWin], sampler2D tgtTex, ivec2 origin, ivec2 d) {
    int m = (8 - pc.block) / 2, n = 0;
    float s = 0.0;
    for (int y = -m; y < pc.block + m; ++y)
        for (int x = -m + ((y + m) & 1); x < pc.block + m; x += 2)
            s += abs(ref[n++] - texelFetch(tgtTex, clamp(origin + ivec2(x, y) + d, ivec2(0), pc.luma - 1), 0).r);
    return s;
}

vec2 search(vec2 v, sampler2D refTex, sampler2D tgtTex, ivec2 origin) {
    // Fractional vectors (subpixel) and small motions are left alone.
    if (any(notEqual(v, round(v))) || dot(v, v) < 4.0) return v;
    const float n = 32.0;
    float ref[kWin];
    loadRef(refTex, origin, ref);
    float sc = sadAt(ref, tgtTex, origin, ivec2(v));
    if (sc < pc.minSad * n) return v;
    // The exact multiples first, then a pixel either side of the best along
    // the motion (its rounding): 7 windows instead of 15.
    const float ks[5] = float[5](0.5, 1.5, 2.0, 2.5, 3.0);
    const ivec2 axis = abs(v.x) >= abs(v.y) ? ivec2(1, 0) : ivec2(0, 1);
    float best = sc * pc.gain, bestK = 1e9;
    vec2 bv = v;
    ivec2 bc = ivec2(0);
    for (int k = 0; k < 5; ++k) {
        ivec2 d = ivec2(round(v * ks[k]));
        ivec2 e = origin + d;  // (the window's match must be on-screen)
        if (any(lessThan(e, ivec2(0))) || any(greaterThan(e + pc.block, pc.luma))) continue;
        float s = sadAt(ref, tgtTex, origin, d);
        if (s < bestK) { bestK = s; bc = d; }
    }
    if (bestK < 1e9) {
        for (int i = -1; i <= 1; ++i) {
            ivec2 d = bc + i * axis;
            ivec2 e = origin + d;
            if (any(lessThan(e, ivec2(0))) || any(greaterThan(e + pc.block, pc.luma))) continue;
            float s = i == 0 ? bestK : sadAt(ref, tgtTex, origin, d);
            if (s < best) { best = s; bv = vec2(d); }
        }
    }
    return bv;
}

// Whether the other direction has a candidate opposite to d around q (the
// texel holding q and its neighbours: posts are as thin as a texel, and
// where the content lands falls on either side of one).
bool agrees(bool fwd, vec2 q, vec2 d) {
    ivec2 t0 = ivec2(floor(q / float(pc.block)));
    for (int i = 0; i < 9; ++i) {
        ivec2 t = clamp(t0 + ivec2(i % 3 - 1, i / 3 - 1), ivec2(0), pc.size - 1);
        vec2 c = (fwd ? imageLoad(candFwd, t) : imageLoad(candBwd, t)).xy;
        if (c == c && distance(c, -d) <= pc.agree) return true;  // (NaN: none)
    }
    return false;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;
    ivec2 origin = p * pc.block;
    vec2 F = imageLoad(flowFwd, p).xy;
    vec2 B = imageLoad(flowBwd, p).xy;
    if (pc.mode == 0) {
        vec2 cF = search(F, lumaPrev, lumaCur, origin), cB = search(B, lumaCur, lumaPrev, origin);
        const float none = uintBitsToFloat(0x7fc00000u);
        imageStore(candFwd, p, vec4(cF == F ? vec2(none) : cF, 0.0, 0.0));
        imageStore(candBwd, p, vec4(cB == B ? vec2(none) : cB, 0.0, 0.0));
        return;
    }
    vec2 centre = vec2(origin) + 0.5 * float(pc.block);
    vec2 cF = imageLoad(candFwd, p).xy, cB = imageLoad(candBwd, p).xy;
    // (NaN compares false: no candidate there)
    if (cF == cF && agrees(false, centre + cF, cF)) imageStore(flowFwd, p, vec4(cF, 0.0, 0.0));
    if (cB == cB && agrees(true, centre + cB, cB)) imageStore(flowBwd, p, vec4(cB, 0.0, 0.0));
}
