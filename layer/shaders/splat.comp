#version 450
// Forward splatting for extrapolation (extrapolate_splat): every pixel of the
// current frame is pushed to where the measured motion carries it at time
// 1 + s, and its index is written there with atomicMin on a priority key, so
// when several pixels land on the same spot the most trustworthy one wins.
// The extrapolation pass then reads each output pixel's source from this map;
// where no pixel landed (an area the motion uncovers) it falls back to the
// backward warp. Backward warping alone looks the motion up at the
// destination, which at an object's edge often picks the wrong layer and
// smears the object into the background it is leaving.
//
// Everything is in display pixels, like the interpolation pass.
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D flowFwd;  // prev -> cur
layout(binding = 1) uniform sampler2D flowBwd;  // cur -> prev
// The map: 2W x H keys, row by row (a buffer: cleared by vkCmdFillBuffer,
// and buffer atomics — 0.35 ms less than an r32ui image at 1440p, NVIDIA).
layout(std430, binding = 2) buffer SplatMap { uint key[]; } splatMap;
layout(std430, binding = 3) readonly buffer State {
    float meanCost; uint dup; uint diffCount; float ageLast; float agePrev; float interval; uint repeats; float histDiff;
    float t[8];
} st;
layout(binding = 4) uniform sampler2D prevBwd;  // previous pair's backward flow (extrapolate_accel)

layout(push_constant) uniform PC {
    ivec2 size;        // display resolution
    float s;           // extrapolation distance past cur (t - 1)
    float flowScale;   // level pixels -> display pixels
    vec2 flowInvSize;  // 1 / (display pixels covered by the flow textures)
    int timing;        // > 0: s = st.t[timing - 1] - 1 (content time, see frame_state.comp)
    float accel;       // second-order term weight (see extrapDisp in interpolate.comp), 0 = off
    int mode;          // 0 extrapolation (cur past t = 1); interp_splat: 1 prev to t, 2 cur to t
    float t;           // interp_splat: the output's time between prev and cur
} pc;

vec2 fwdAt(vec2 p) { return texture(flowFwd, p * pc.flowInvSize).xy * pc.flowScale; }
vec2 bwdAt(vec2 p) { return texture(flowBwd, p * pc.flowInvSize).xy * pc.flowScale; }

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;
    vec2 src = vec2(p) + 0.5;
    if (pc.mode != 0) {
        // interp_splat: every pixel of prev (mode 1, along the forward flow)
        // or of cur (mode 2, back along the backward flow) pushed to where it
        // is at time t — the left half of the map for prev, the right half
        // for cur. Same priority as below: consistent beats inconsistent,
        // then the faster pixel (the likelier foreground) wins.
        float t = pc.timing > 0 ? st.t[pc.timing - 1] : pc.t;
        vec2 v = pc.mode == 1 ? fwdAt(src) : bwdAt(src);
        vec2 back = pc.mode == 1 ? bwdAt(src + v) : fwdAt(src + v);
        vec2 dstf = src + (pc.mode == 1 ? t : 1.0 - t) * v;
        ivec2 dst = ivec2(floor(dstf));
        if (any(lessThan(dst, ivec2(0))) || any(greaterThanEqual(dst, pc.size))) return;
        uint prio = length(v + back) > 2.0 ? 511u : 510u - uint(clamp(length(v), 0.0, 510.0));
        uint index = uint(p.y * pc.size.x + p.x);
        atomicMin(splatMap.key[dst.y * 2 * pc.size.x + dst.x + (pc.mode == 2 ? pc.size.x : 0)], (prio << 23) | index);
        return;
    }
    vec2 B = bwdAt(src);                    // minus the motion of this pixel
    float s = pc.timing > 0 ? st.t[pc.timing - 1] - 1.0 : pc.s;
    vec2 d = -s * B;
    if (pc.accel > 0.0) {  // same trajectory as extrapDisp in interpolate.comp
        vec2 v = -B;
        vec2 a = v - pc.flowScale * -texture(prevBwd, (src + B) * pc.flowInvSize).xy;
        float lim = 0.5 * length(v) + 1.0, la = length(a);
        if (la > lim) a *= lim / la;
        a *= smoothstep(pc.flowScale, 2.0 * pc.flowScale, la);
        d = s * v + pc.accel * 0.5 * s * (s + 1.0) * a;
    }
    ivec2 dst = ivec2(floor(src + d));
    if (any(lessThan(dst, ivec2(0))) || any(greaterThanEqual(dst, pc.size))) return;
    // Priority (lower wins): pixels whose forward/backward flow agree beat
    // inconsistent ones; among those, the faster-moving pixel wins — without
    // depth, the object moving over a slower background is the better guess
    // for what ends up in front.
    float inconsistency = length(B + fwdAt(src + B));
    uint prio = inconsistency > 2.0 ? 511u : 510u - uint(clamp(length(B), 0.0, 510.0));
    uint index = uint(p.y * pc.size.x + p.x);   // < 2^23 (checked on the host)
    atomicMin(splatMap.key[dst.y * 2 * pc.size.x + dst.x], (prio << 23) | index);
}
