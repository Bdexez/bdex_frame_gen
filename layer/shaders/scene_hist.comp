#version 450
// Scene-cut evidence independent of the motion (scene_cut_hist): how far the
// brightness distribution moved between the previous and the current frame.
// One workgroup builds a 64-bin luma histogram of each frame (a coarse
// pyramid level: a few ten thousand pixels) and writes the distance between
// them — the 1-D earth mover's distance, the L1 difference of the cumulative
// histograms, in luma units (0 = same distribution, 1 = black to white).
// Noise, film grain, foliage and fast motion leave it near 0 (the same
// content, elsewhere); a cut to another scene moves it far. The flow cost
// alone cannot tell them apart: all of them raise it.
// With scene_cut_local, workgroups 1..tiles^2 do the same on one tile each
// of the grid reduce_cost.comp averages the cost on (a menu opening over a
// quarter of the screen moves its tiles' distributions, fast motion inside
// a tile mostly does not).
layout(local_size_x = 256) in;

layout(binding = 0) uniform sampler2D lumaA;  // pyramid slot 0 at the level used
layout(binding = 1) uniform sampler2D lumaB;  // pyramid slot 1
// The head of the frame state (frame_state.comp): histDiff is its 8th word.
layout(std430, binding = 2) buffer State {
    float meanCost;
    uint dup;
    uint diffCount;
    float ageLast;
    float agePrev;
    float interval;
    uint repeats;
    float histDiff;
    uint skip[312];      // t[8] .. the repeat grid, up to kStateTileHist (1280 bytes)
    float tileHist[64];  // per tile of the scene_cut_local grid
} st;

layout(push_constant) uniform PC { ivec2 size; int tiles; } pc;

#define BINS 64
shared uint hA[BINS];
shared uint hB[BINS];

void main() {
    uint tid = gl_LocalInvocationID.x;
    // Workgroup 0: the whole frame; k + 1: tile k (uniform per workgroup).
    int k = int(gl_WorkGroupID.x) - 1;
    ivec2 lo = ivec2(0), ext = pc.size;
    if (k >= 0) {
        ivec2 tile = ivec2(k % pc.tiles, k / pc.tiles);
        lo = tile * pc.size / pc.tiles;
        ext = min(max((tile + 1) * pc.size / pc.tiles, lo + 1), pc.size) - lo;
    }
    if (tid < BINS) { hA[tid] = 0u; hB[tid] = 0u; }
    barrier();
    int n = ext.x * ext.y;
    for (int i = int(tid); i < n; i += 256) {
        ivec2 p = lo + ivec2(i % ext.x, i / ext.x);
        int a = clamp(int(texelFetch(lumaA, p, 0).r * float(BINS)), 0, BINS - 1);
        int b = clamp(int(texelFetch(lumaB, p, 0).r * float(BINS)), 0, BINS - 1);
        atomicAdd(hA[a], 1u);
        atomicAdd(hB[b], 1u);
    }
    barrier();
    if (tid == 0u) {
        float ca = 0.0, cb = 0.0, d = 0.0;
        float inv = 1.0 / float(max(n, 1));
        for (int k = 0; k < BINS; ++k) {
            ca += float(hA[k]) * inv;
            cb += float(hB[k]) * inv;
            d += abs(ca - cb);
        }
        if (k < 0) st.histDiff = d / float(BINS);
        else st.tileHist[k] = d / float(BINS);
    }
}
