#version 450
// Contrast-Adaptive Sharpening (AMD FidelityFX CAS, non-scaling variant),
// applied after upscaling. Reads the display-resolution linear image the
// upscale / interpolation passes produced, sharpens each pixel by an amount
// that adapts to local contrast (so flat and already-sharp regions are left
// alone, avoiding overshoot), then encodes and packs into the swapchain format.
#include "common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D srcTex;  // rgba16f, linear, display resolution
#ifdef OUT_64
layout(binding = 1, rg32ui) uniform writeonly uimage2D outImg;
#else
layout(binding = 1, r32ui) uniform writeonly uimage2D outImg;
#endif

#define ENC_RGBA8       0u
#define ENC_BGRA8       1u
#define ENC_A2B10G10R10 2u
#define ENC_A2R10G10B10 3u
#define ENC_RGBA16F     4u
#define ENC_SRGB_FLAG   0x100u

layout(push_constant) uniform PC {
    ivec2 size;
    uint encoding;
    float sharpness;  // 0 (mild) .. 1 (strong)
} pc;

void store(ivec2 p, vec4 c) {
    uint enc = pc.encoding & 0xffu;
    if ((pc.encoding & ENC_SRGB_FLAG) != 0u) c.rgb = linearToSrgb(c.rgb);
    c = clamp(c, 0.0, enc == ENC_RGBA16F ? 65504.0 : 1.0);
#ifdef OUT_64
    imageStore(outImg, p, uvec4(packHalf2x16(c.rg), packHalf2x16(c.ba), 0u, 0u));
#else
    uint packed;
    if (enc == ENC_BGRA8) {
        packed = packUnorm4x8(c.bgra);
    } else if (enc == ENC_A2B10G10R10) {
        uvec4 q = uvec4(round(c * vec4(1023.0, 1023.0, 1023.0, 3.0)));
        packed = q.r | (q.g << 10) | (q.b << 20) | (q.a << 30);
    } else if (enc == ENC_A2R10G10B10) {
        uvec4 q = uvec4(round(c * vec4(1023.0, 1023.0, 1023.0, 3.0)));
        packed = q.b | (q.g << 10) | (q.r << 20) | (q.a << 30);
    } else {
        packed = packUnorm4x8(c);
    }
    imageStore(outImg, p, uvec4(packed, 0u, 0u, 0u));
#endif
}

vec3 tap(ivec2 p) { return texture(srcTex, (vec2(clamp(p, ivec2(0), pc.size - 1)) + 0.5) / vec2(pc.size)).rgb; }

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;

    //  a b c
    //  d e f
    //  g h i
    vec3 a = tap(p + ivec2(-1, -1)), b = tap(p + ivec2(0, -1)), c = tap(p + ivec2(1, -1));
    vec3 d = tap(p + ivec2(-1,  0)), f = tap(p + ivec2(1,  0));
    vec3 g = tap(p + ivec2(-1,  1)), h = tap(p + ivec2(0,  1)), i = tap(p + ivec2(1,  1));
    vec4 ec = texture(srcTex, (vec2(p) + 0.5) / vec2(pc.size));
    vec3 e = ec.rgb;

    // Soft min/max over the cross, reinforced by the diagonals.
    vec3 mn = min(min(min(d, e), min(f, b)), h);
    mn += min(mn, min(min(a, c), min(g, i)));
    vec3 mx = max(max(max(d, e), max(f, b)), h);
    mx += max(mx, max(max(a, c), max(g, i)));

    // Adaptive amount: strong where there is head/foot room, zero at extremes.
    vec3 amp = sqrt(clamp(min(mn, 2.0 - mx) / max(mx, vec3(1e-5)), 0.0, 1.0));
    float peak = -1.0 / mix(8.0, 5.0, clamp(pc.sharpness, 0.0, 1.0));
    vec3 w = amp * peak;
    vec3 outc = ((b + d + f + h) * w + e) / (1.0 + 4.0 * w);

    store(p, vec4(outc, ec.a));
}
