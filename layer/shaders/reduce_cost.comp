#version 450
// Averages the per-block matching cost of the finest level into a single
// value used by the interpolation pass to detect scene cuts. With
// scene_cut_local, workgroups 1..tiles^2 also average one tile each of a
// tiles x tiles grid, so a cut confined to part of the screen (a menu
// opening, a picture-in-picture switching) is detected where it happens and
// a large moving object does not push the whole frame into the fallback.
layout(local_size_x = 256) in;

layout(binding = 0, r32f) uniform readonly image2D costImg;
// The head of the frame state (frame_state.comp): meanCost, histDiff (from
// scene_hist.comp) and tileCost.
layout(std430, binding = 1) buffer Out {
    float meanCost;
    uint head1[6];
    float histDiff;
    uint head2[8];   // t[8]
    float tileCost[64];
} outBuf;

layout(push_constant) uniform PC {
    ivec2 size;
    int tiles;       // 0: global mean only; else the side of the tile grid (<= 8)
    float cutHist;   // scene_cut_hist: histogram distance at which a cut fully counts (0 = off)
    float cutLow;    // scene_cut_low: where the fallback starts
} pc;

shared float sSum[256];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint wg = gl_WorkGroupID.x;
    if (wg == 0u) {
        int n = pc.size.x * pc.size.y;
        float sum = 0.0;
        for (int i = int(tid); i < n; i += 256) sum += imageLoad(costImg, ivec2(i % pc.size.x, i / pc.size.x)).r;
        sSum[tid] = sum;
        barrier();
        for (uint s = 128u; s > 0u; s >>= 1u) {
            if (tid < s) sSum[tid] += sSum[tid + s];
            barrier();
        }
        if (tid == 0u) {
            float mean = sSum[0] / float(max(n, 1));
            // scene_cut_hist: a high flow cost alone is not a cut — noise,
            // film grain and fast complex motion raise it too, and the
            // fallback to the real frame then fades the whole picture (a
            // ghost) or repeats it. A cut to another scene also moves the
            // brightness distribution (measured: cuts 0.18+, grain and fast
            // motion under 0.02): above scene_cut_low, the cost counts only
            // as far as the histogram moved. (Here rather than in the
            // synthesis, whose lean variant stays untouched.)
            if (pc.cutHist > 0.0 && mean > pc.cutLow)
                mean = pc.cutLow + (mean - pc.cutLow) * smoothstep(0.5 * pc.cutHist, pc.cutHist, outBuf.histDiff);
            outBuf.meanCost = mean;
        }
        return;
    }
    int k = int(wg) - 1;
    if (pc.tiles <= 0 || k >= pc.tiles * pc.tiles) return;  // uniform per workgroup
    ivec2 tile = ivec2(k % pc.tiles, k / pc.tiles);
    ivec2 lo = tile * pc.size / pc.tiles;
    ivec2 hi = min(max((tile + 1) * pc.size / pc.tiles, lo + 1), pc.size);
    ivec2 ext = hi - lo;
    int n = ext.x * ext.y;
    float sum = 0.0;
    for (int i = int(tid); i < n; i += 256) sum += imageLoad(costImg, lo + ivec2(i % ext.x, i / ext.x)).r;
    sSum[tid] = sum;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (tid < s) sSum[tid] += sSum[tid + s];
        barrier();
    }
    if (tid == 0u) outBuf.tileCost[k] = sSum[0] / float(max(n, 1));
}
