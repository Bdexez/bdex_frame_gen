#version 450
// flow_upsample: the finest flow (one vector per block) brought to the luma
// resolution, edge-aware — a joint bilateral upsampling. Each luma pixel
// takes the vectors of the 3x3 blocks around it, weighted by distance and
// by how close the pixel's brightness is to each block's mean (from a
// coarser pyramid level): at an object's edge a pixel keeps its own side's
// motion instead of the bilinear blend of both, which smears the edge and
// tears the warp. The synthesis samples it in place of the block flow (same
// coverage, finer texels).
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D flowIn;     // finest flow (luma pixels per texel: `block`)
layout(binding = 1) uniform sampler2D lumaFine;   // the frame the flow is attached to, level 0
layout(binding = 2) uniform sampler2D lumaBlock;  // the same frame a few levels down: block means
layout(binding = 3, rg32f) uniform writeonly image2D flowOut;

layout(push_constant) uniform PC {
    ivec2 outSize;   // flow texels x block: the area the flow covers, in luma pixels
    ivec2 fine;      // flow texels
    ivec2 luma;      // level-0 luma size
    int block;       // luma pixels per flow texel
    float sigmaR;    // brightness similarity scale (luma units)
} pc;

void main() {
    ivec2 x = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(x, pc.outSize))) return;
    vec2 lx = vec2(x) + 0.5;
    float L = texture(lumaFine, lx / vec2(pc.luma)).r;
    vec2 u = lx / float(pc.block) - 0.5;  // flow texel coordinates (centres at integers)
    ivec2 c = ivec2(floor(u + 0.5));
    vec2 bilinear = texture(flowIn, (u + 0.5) / vec2(pc.fine)).xy;
    vec2 sum = vec2(0.0), lo = vec2(1e9), hi = vec2(-1e9);
    float wsum = 0.0;
    for (int dy = -1; dy <= 1; ++dy)
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 n = clamp(c + ivec2(dx, dy), ivec2(0), pc.fine - 1);
            vec2 d = u - vec2(n);
            vec2 f = texelFetch(flowIn, n, 0).xy;
            lo = min(lo, f);
            hi = max(hi, f);
            float ws = exp(-dot(d, d) / (2.0 * 0.6 * 0.6));
            float Ln = texture(lumaBlock, (vec2(n) + 0.5) * float(pc.block) / vec2(pc.luma)).r;
            float dr = (L - Ln) / pc.sigmaR;
            float w = ws * exp(-0.5 * dr * dr);
            sum += w * f;
            wsum += w;
        }
    // Only at motion boundaries (the neighbours disagree by half a pixel or
    // more): elsewhere every vector is alike and the bilinear value is kept,
    // bit for bit. No neighbour alike in brightness: bilinear too.
    bool boundary = any(greaterThan(hi - lo, vec2(0.5)));
    vec2 v = boundary && wsum > 1e-3 ? sum / wsum : bilinear;
    imageStore(flowOut, x, vec4(v, 0.0, 0.0));
}
