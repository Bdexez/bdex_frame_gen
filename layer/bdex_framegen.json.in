{
  "file_format_version": "1.2.0",
  "layer": {
    "name": "@BDEX_LAYER_NAME@",
    "type": "GLOBAL",
    "library_path": "@BDEX_LAYER_LIBRARY_PATH@",
    "api_version": "1.4.0",
    "implementation_version": "1",
    "description": "BDEX frame generation: interpolates extra frames between the game's frames",
    "functions": {
      "vkGetInstanceProcAddr": "vkGetInstanceProcAddr",
      "vkGetDeviceProcAddr": "vkGetDeviceProcAddr",
      "vkNegotiateLoaderLayerInterfaceVersion": "vkNegotiateLoaderLayerInterfaceVersion"
    },
    "enable_environment": { "BDEX_FG": "1" },
    "disable_environment": { "BDEX_FG_DISABLE": "1" }
  }
}
