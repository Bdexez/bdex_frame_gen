#!/usr/bin/env bash
# Launcher: runs a program with the BDEX frame generation layer enabled.
#
#   bdex-framegen [options] -- <command> [args...]
#
# Options map to BDEX_FG_* environment variables (see README.md):
#   -m, --multiplier N     frames per real frame: 2 (default), 3 or 4
#   -x, --extrapolate      predict frames instead of interpolating: no added latency
#   -P, --preset NAME      quality | balanced (default) | performance | latency (min input lag)
#   -f, --fullres          compute the flow at full resolution (= --preset quality's flow)
#   -u, --upscale RATIO    render below display size and upscale (e.g. 1.5); X11/Xwayland only
#       --upscale-filter F bilinear | bicubic | lanczos (default)
#   -s, --sharpness N      contrast-adaptive sharpening after upscaling, 0..1 (0 = off)
#   -p, --present-mode M   auto (default: fifo -> mailbox) | app | fifo | mailbox | immediate | relaxed
#   -o, --hud LEVEL        on-screen fps counter: off | fps | framegen | low | full (0..4)
#   -d, --debug M          none | flow | split | passthrough
#   -l, --log N            log level 0..3
#       --profile          print GPU timings with the statistics
#       --no-stats         do not print frame rate statistics
#       --gl               OpenGL game: run it on Vulkan through Mesa's Zink driver
#       --mangohud         MangoHud under the layer: it counts and draws on every
#                          frame shown (generated ones included); on its own it
#                          usually loads above and sees the game's frames only
#       --gpu WHICH        run the game on one GPU of a hybrid laptop: screen (the
#                          one the screens are plugged into: no PRIME copy of every
#                          frame, generated ones included), discrete, integrated,
#                          or a vendor (nvidia | amd | intel); --gpu list shows them
#       --off              run the program with the layer disabled
#       --gui              open the graphical launcher instead
#       --check            report whether the layer is found by the Vulkan loader
#       --toggle           pause / resume frame generation in running games (live,
#                          through the config file; bind it to a desktop shortcut)
#       --always-on [GAME] generate without the control panel, from the game's
#                          start: in GAME (its executable name), or in every game
#                          — for Steam's Game Mode (Steam Deck), where the panel
#                          cannot stay open beside a game
#       --always-off [GAME] undo it (the panel's « Démarrer » decides again)
#       --sandboxes [--remove]
#                          copy the layer into the Flatpak / Snap game launchers
#                          (Steam, Heroic, Lutris, Bottles): their sandbox does
#                          not see the system's layers — run it once after
#                          installing a distribution package
#       --report [FILE]    write a diagnostic report for bug reports (default:
#                          ./bdex-framegen-report.txt)
#       --record DIR [N]   record the game's real frames into DIR (N, default
#                          240; generation off) for the evaluation corpus:
#                          tools/corpus_pack.py, then eval_sequence.py
#       --tuned-profile [GAME] [--mode M] [--apply]
#                          the options online_tune kept for GAME as a [GAME]
#                          config section (no GAME: list the tuned games);
#                          --apply writes it into the config file, ready to
#                          share or to add to layer/profiles.conf
#   -h, --help
set -euo pipefail

usage() { sed -n '2,/^#   -h, --help/p' "$0" | sed 's/^# \{0,1\}//'; }

# The screens as the desktop sees them: "<output> <current mode>" per enabled
# output (KDE's kscreen-doctor, else xrandr), for the report and the quick read.
# kscreen-doctor only answers in a Plasma session: elsewhere it waits for the
# KScreen backend forever (seen under Hyprland). Run it there, under a timeout.
in_kde() { case "${XDG_CURRENT_DESKTOP:-}:${KDE_FULL_SESSION:-}" in *KDE*|*:true) return 0 ;; esac; return 1; }
kscreen() { in_kde && command -v kscreen-doctor >/dev/null && timeout 5 kscreen-doctor "$@"; }
screens() {
  if in_kde && command -v kscreen-doctor >/dev/null; then
    kscreen -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk '
      /^Output:/ { name = $3; on = 0 }
      /^[ \t]*enabled/ { on = 1 }
      /^[ \t]*Vrr:/ { vrr[name] = $2 }
      /Modes:/ && on { if (match($0, /[0-9]+x[0-9]+@[0-9.]+\*/)) cur[name] = substr($0, RSTART, RLENGTH - 1) }
      END { for (n in cur) printf "%s %s vrr=%s (kscreen)\n", n, cur[n], vrr[n] }' || true
  fi
  # wlroots compositors (sway, river, labwc...) and Hyprland: their own view
  # (under Wayland, xrandr only sees Xwayland's outputs).
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null; then
    hyprctl monitors 2>/dev/null | awk '
      /^Monitor / { name = $2 }
      /^[ \t]+[0-9]+x[0-9]+@[0-9.]+ at / && name { printf "%s %s (hyprctl)\n", name, $1; name = "" }' || true
  elif [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wlr-randr >/dev/null; then
    wlr-randr 2>/dev/null | awk '
      /^[^ ]/ { name = $1 }
      /current\)/ && name { sub(/ px,/, "", $1); printf "%s %s@%s (wlr-randr)\n", name, $1, $2; name = "" }' || true
  fi
  if command -v xrandr >/dev/null && [ -n "${DISPLAY:-}" ]; then
    xrandr --query 2>/dev/null | awk '
      / connected/ { name = $1 }
      /\*/ && name { for (i = 2; i <= NF; i++) if ($i ~ /\*/) { hz = $i; gsub(/[*+]/, "", hz); printf "%s %s@%s (xrandr)\n", name, $1, hz }; name = "" }' || true
  fi
}

# GPU vendor from a Vulkan device name or a kernel driver: nvidia | amd | intel.
gpu_vendor() {
  case "$1" in
    *NVIDIA*|*GeForce*|*Quadro*|nvidia*) echo nvidia ;;
    *AMD*|*Radeon*|*RADV*|amdgpu|radeon) echo amd ;;
    *Intel*|i915|xe) echo intel ;;
    *) echo "?" ;;
  esac
}

# The GPUs the screens are plugged into (kernel driver of each connected output).
connected_outputs() {
  for c in /sys/class/drm/card*-*; do
    [ "$(cat "$c/status" 2>/dev/null)" = connected ] || continue
    conn="${c##*/}"; card="${conn%%-*}"
    drv="$(basename "$(readlink -f "/sys/class/drm/$card/device/driver" 2>/dev/null)" 2>/dev/null || true)"
    echo "${conn#*-} $card ${drv:-?}"
  done
}

# « Lecture rapide »: what the report says about the usual causes of « no
# generated frames » — Auto on a misdetected screen (x1), panel closed or
# targeting another process, the game on another GPU than the screen.
# The directories of the Flatpak (and Snap) game launchers the layer is
# installed in (packaging/linux/flatpak.sh): `flatpak_dirs run` their status
# directories, `flatpak_dirs config` their settings files, `flatpak_dirs` the
# Flatpak app dirs.
flatpak_dirs() {
  local app d
  for app in com.valvesoftware.Steam com.heroicgameslauncher.hgl net.lutris.Lutris com.usebottles.bottles; do
    d="$HOME/.var/app/$app"
    # (a copy of the layer, or flatpak.sh's mark: the Flatpak extension loads it)
    [ -f "$d/data/vulkan/implicit_layer.d/VK_LAYER_BDEX_framegen.json" ] ||
      [ -f "$d/data/bdex-framegen/extension" ] || continue
    case "${1:-}" in
      run) echo "$d/.cache/bdex-framegen/run" ;;
      config) echo "$d/config/bdex-framegen.conf" ;;
      *) echo "$d" ;;
    esac
  done
  # Snaps (Steam's): HOME is ~/snap/<name>/current.
  d="$HOME/snap/steam/current"
  if [ -f "$d/.local/share/vulkan/implicit_layer.d/VK_LAYER_BDEX_framegen.json" ]; then
    case "${1:-}" in
      run) echo "$d/.cache/bdex-framegen/run" ;;
      config) echo "$d/.config/bdex-framegen.conf" ;;
    esac
  fi
}

quick_read() {
  local sdir="$1" sess="$1/app.session" panel_hz="" panel_target="" hz_desktop
  hz_desktop="$(screens | sed -n 's/.*@\([0-9.]*\).*/\1/p' | sort -g | tail -1)"
  local outputs; outputs="$(connected_outputs)"
  echo "écrans (bureau) : $(screens | tr '\n' ';' | sed 's/;$//;s/;/ ; /g')"
  echo "sorties branchées sur : $(echo "$outputs" | awk 'NF { printf "%s%s → %s (%s)", s, $1, $2, $3; s = " ; " }')"
  if [ -f "$sess" ]; then
    local age=$(( $(date +%s) - $(stat -c %Y "$sess" 2>/dev/null || echo 0) ))
    read -r _ panel_target panel_hz < "$sess" || true
    if [ "$age" -gt 5 ]; then
      echo "panneau : FERMÉ (session vieille de ${age} s) → avec require_app, aucun jeu ne génère d'images"
    else
      echo "panneau : ouvert, cible pid ${panel_target:-0}, fréquence lue ${panel_hz:-0} Hz"
      [ "${panel_target:-0}" = 0 ] && echo "  → aucun jeu démarré : cliquer « Démarrer » sur le jeu"
      case "${panel_hz:-0}" in 0|0.000) echo "  → le panneau n'a pas pu lire la fréquence de l'écran" ;; esac
    fi
  else
    echo "panneau : pas de session (panneau jamais ouvert, ou fermé proprement)"
  fi
  local found=0 f host_target="${panel_target:-0}"
  # (Games in a Flatpak launcher write theirs in its sandbox, their pid being
  # the one of its own namespace: compared with the session there.)
  for f in "$sdir"/*.status $(flatpak_dirs run)/*.status; do
    [ -f "$f" ] || continue
    found=1
    local pid; pid="$(sed -n 's/^pid=//p' "$f" | head -1)"
    local fdir; fdir="$(dirname "$f")"
    panel_target="$host_target"
    if [ "$fdir" != "$sdir" ]; then
      panel_target=0
      [ -f "$fdir/app.session" ] && { read -r _ panel_target _ < "$fdir/app.session" || true; }
      echo "(jeu dans un Flatpak : $fdir)"
    fi
    # One line per swapchain: state device multiplier game_fps output_fps refresh_hz limit_hz
    awk -F= '
      /^\[/ { if (sc) print st "\t" dv "\t" m "\t" g "\t" o "\t" r "\t" l; sc = ($0 ~ /^\[swapchain/); st = dv = m = g = o = r = l = "" }
      $1 == "state" { st = $2 } $1 == "device" { dv = $2 } $1 == "multiplier" { m = $2 }
      $1 == "game_fps" { g = $2 } $1 == "output_fps" { o = $2 } $1 == "refresh_hz" { r = $2 } $1 == "limit_hz" { l = $2 }
      END { if (sc) print st "\t" dv "\t" m "\t" g "\t" o "\t" r "\t" l }' "$f" |
    while IFS=$'\t' read -r state dev mult gfps ofps rhz lhz; do
      echo "jeu $(sed -n 's/^process=//p' "$f" | head -1) (pid $pid) : $state, ×$mult, $gfps → $ofps fps, écran selon la couche ${rhz} Hz, GPU $dev"
      if [ -n "$lhz" ]; then
        echo "  → limite d'images/s de Steam (menu rapide, mode Jeu) : ${lhz} i/s. gamescope n'affiche rien au-delà :"
        echo "    la génération ne fait que compléter jusqu'à ${lhz}. Pour générer au-delà : limite « Désactivée »"
        echo "    (ou la fréquence de l'écran), et plafonner le jeu lui-même avec fps_limit (ex. 30 pour 60 à ×2)"
      fi
      case "$state" in
        ready)  if [ "${panel_target:-0}" != "$pid" ]; then echo "  → armé mais pas ciblé : le panneau vise le pid ${panel_target:-0}, pas $pid"
                else echo "  → armé, en attente de « Démarrer »"; fi ;;
        paused) echo "  → génération en pause (raccourci --toggle ou paused=1)" ;;
        pass-through) echo "  → pas de génération sur cette swapchain (raison dans le statut détaillé plus bas)" ;;
      esac
      if [ "$state" = generating ] && awk -v o="${ofps:-0}" -v r="${rhz:-0}" 'BEGIN { exit !(r > 0 && o > r * 1.1) }'; then
        echo "  → ${ofps} images/s envoyées pour un écran à ${rhz} Hz : le compositeur en jette l'excédent ; le jeu tourne déjà"
        echo "    près de la fréquence de l'écran, ×$mult n'apporte presque rien (plafonner le jeu : fps_limit, ou multiplicateur Auto)"
      fi
      if [ "$state" = generating ] && [ "$mult" = 1 ]; then
        echo "  → ×1 : le jeu ($gfps fps) atteint déjà la fréquence que la couche croit être celle de l'écran (${rhz} Hz) ;"
        echo "    en « Auto », rien n'est généré. Si l'écran est plus rapide, la détection est fausse : tester ×2 fixe dans le panneau"
      fi
      if awk -v r="${rhz:-0}" 'BEGIN { exit !(r + 0 == 0) }'; then
        echo "  → fréquence de l'écran inconnue (ni mesurée ni transmise par le panneau) : « Auto » se limite à ×2"
      elif [ -n "$hz_desktop" ] && awk -v r="$rhz" -v d="$hz_desktop" 'BEGIN { exit !(r < d * 0.95 || r > d * 1.05) }'; then
        echo "  → la couche compte sur ${rhz} Hz mais le bureau annonce ${hz_desktop} Hz : écran mal détecté"
      fi
      local gv; gv="$(gpu_vendor "$dev")"
      if [ -n "$outputs" ] && [ "$gv" != "?" ] &&
         ! echo "$outputs" | while read -r _ _ drv; do [ "$(gpu_vendor "$drv")" = "$gv" ] && echo y; done | grep -q y; then
        echo "  → le jeu tourne sur $dev mais aucun écran n'est branché sur ce GPU : les images passent par l'autre GPU"
        echo "    (copie PRIME ; brancher l'écran sur la carte graphique du jeu, ou lancer le jeu sur le GPU de l'écran : bdex-framegen --gpu screen -- jeu)"
      fi
    done
  done
  [ "$found" = 1 ] || echo "aucun jeu ne publie d'état : jeu non lancé, ou couche non chargée dans le jeu (bdex-framegen --check)"
  # The scene-cut fallback: generated frames replaced by the real one are
  # displayed but show nothing new (x2 then looks exactly like x1).
  local log="$2" cut
  if [ -n "$log" ] && [ -f "$log" ]; then
    cut="$(grep -o 'scene cut: [0-9]*% duplicated, [0-9]*% faded (cost [0-9.,]*' "$log" | tail -1)"
    if [ -n "$cut" ]; then
      echo "dernière mesure : $cut)"
      local dup fade
      dup="$(echo "$cut" | sed -E 's/scene cut: ([0-9]+)%.*/\1/')"
      fade="$(echo "$cut" | sed -E 's/.*, ([0-9]+)% faded.*/\1/')"
      if [ $(( dup + fade )) -ge 30 ]; then
        echo "  → ${dup} % des images générées sont une simple copie de l'image réelle (repli « changement de scène »), ${fade} % à moitié :"
        echo "    le mouvement est jugé trop incertain, la génération ne montre rien de nouveau. Tester dans [jeu] :"
        echo "    scene_cut_low = 0.3 et scene_cut_high = 0.6 (relu à chaud)"
      fi
    fi
    # Frames sent against frames really displayed (present feedback): a
    # generated frame replaced before display is lost, whatever the counters
    # say (a GPU too busy to keep up, a compositor dropping frames).
    local stat out shown
    stat="$(grep -oE 'output [0-9.,]+ fps \(x[0-9.,]+\).*displayed [0-9.,]+ fps' "$log" | tail -1)"
    if [ -n "$stat" ]; then
      out="$(echo "$stat" | sed -E 's/^output ([0-9.,]+) fps.*/\1/' | tr , .)"
      shown="$(echo "$stat" | sed -E 's/.*displayed ([0-9.,]+) fps$/\1/' | tr , .)"
      echo "dernière mesure : ${out} images/s envoyées, ${shown} réellement affichées"
      if awk -v o="$out" -v d="$shown" 'BEGIN { exit !(o > 0 && d < o * 0.85) }'; then
        echo "  → une partie des images n'atteint pas l'écran : GPU saturé (baisser render_scale ou le préréglage,"
        echo "    plafonner le jeu avec fps_limit), ou compositeur qui en jette (plein écran, VRR)"
      fi
    fi
  fi
}

# Everything a bug report needs, in one file to attach to an issue.
report() {
  out="${1:-bdex-framegen-report.txt}"
  cfg="${BDEX_FG_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/bdex-framegen.conf}"
  sdir="${BDEX_FG_STATUS_DIR:-${HOME:+$HOME/.cache/bdex-framegen/run}}"
  sdir="${sdir:-/tmp/bdex-framegen-$(id -u)}"
  {
    echo "== bdex-framegen diagnostic report, $(date -u '+%Y-%m-%d %H:%M UTC')"
    echo; echo "== lecture rapide (à faire pendant que le jeu tourne, après « Démarrer »)"
    log="$(grep -hE '^\s*log_file\s*=' "$cfg" 2>/dev/null | tail -1 | cut -d= -f2- | xargs || true)"
    log="${BDEX_FG_LOG_FILE:-$log}"
    log="${log/#\~/$HOME}"
    quick_read "$sdir" "$log"
    echo; echo "== system"
    uname -srm
    grep -h '^PRETTY_NAME' /etc/os-release 2>/dev/null || true
    echo "session: ${XDG_SESSION_TYPE:-?}  desktop: ${XDG_CURRENT_DESKTOP:-?}  WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}  DISPLAY=${DISPLAY:-}"
    echo; echo "== layer"
    if command -v vulkaninfo >/dev/null; then
      BDEX_FG=1 BDEX_FG_LOG=2 BDEX_FG_STATS=0 vulkaninfo --summary 2>&1 |
        grep -E "bdex-fg|VK_LAYER_BDEX|deviceName|driverName|driverInfo|apiVersion|deviceType" | head -40
    else
      echo "vulkaninfo not found (install vulkan-tools)"
    fi
    echo; echo "== Vulkan layer order (application at the top, driver at the bottom)"
    if command -v vulkaninfo >/dev/null; then
      ENABLE_VK_LAYER_VALVE_steam_overlay_1=1 BDEX_FG_STATS=0 VK_LOADER_DEBUG=layer vulkaninfo --summary 2>&1 |
        sed -n '/vkCreateDevice layer callstack/,/<Device>/p' | grep -E '^\[Vulkan Loader\] [A-Z]+: +(VK_LAYER|<)' |
        sed -E 's/^\[Vulkan Loader\] [A-Z]+: +/  /' | awk '!seen[$0]++' | head -20
    fi
    echo; echo "== installed manifests"
    for d in /usr/share/vulkan/implicit_layer.d /etc/vulkan/implicit_layer.d \
             "${XDG_DATA_HOME:-$HOME/.local/share}/vulkan/implicit_layer.d"; do
      ls -l "$d"/*BDEX* 2>/dev/null || true
    done
    for d in $(flatpak_dirs); do
      echo "Flatpak $(basename "$d"):"; ls -l "$d"/data/vulkan/implicit_layer.d/*BDEX* 2>/dev/null || true
    done
    for app in com.valvesoftware.Steam com.heroicgameslauncher.hgl net.lutris.Lutris com.usebottles.bottles; do
      if [ -f "$HOME/.var/app/$app/data/bdex-framegen/extension" ]; then
        echo "Flatpak $app: layer from the Flatpak extension (runtime $(cat "$HOME/.var/app/$app/data/bdex-framegen/extension"))"
      elif [ -d "$HOME/.var/app/$app" ] && [ ! -f "$HOME/.var/app/$app/data/vulkan/implicit_layer.d/VK_LAYER_BDEX_framegen.json" ]; then
        echo "Flatpak $app: layer NOT installed there (bdex-framegen --sandboxes)"
      fi
    done
    if [ -d "$HOME/snap/steam" ]; then
      echo "Snap steam:"; ls -l "$HOME"/snap/steam/current/.local/share/vulkan/implicit_layer.d/*BDEX* 2>/dev/null ||
        echo "  layer NOT installed there (bdex-framegen --sandboxes)"
    fi
    stale="$(stale_sandboxes)"
    [ -z "$stale" ] || echo "$stale" | sed 's/^/OUTDATED copy (layer updated since; bdex-framegen --sandboxes): /'
    if command -v flatpak >/dev/null; then
      echo "Flatpak extension: $(flatpak list --runtime --columns=application,branch 2>/dev/null |
        awk '$1 == "org.freedesktop.Platform.VulkanLayer.BdexFramegen" { printf "%s ", $2 }')"
    fi
    echo; echo "== crash journals (crash_log: crashes inside the layer)"
    local cj found_cj=0
    for cj in $(ls -t "${XDG_CACHE_HOME:-$HOME/.cache}"/bdex-framegen/crash-*.txt $(flatpak_dirs run | sed 's#/run$##' | sed 's#$#/crash-*.txt#') 2>/dev/null | head -3); do
      [ -f "$cj" ] || continue
      found_cj=1
      echo "-- $cj ($(date -r "$cj" '+%F %T' 2>/dev/null))"; cat "$cj"
    done
    [ "$found_cj" = 1 ] || echo "none"
    echo; echo "== security modules"
    if command -v getenforce >/dev/null; then echo "SELinux: $(getenforce 2>/dev/null)"; fi
    if [ -r /sys/module/apparmor/parameters/enabled ]; then
      echo "AppArmor: $(cat /sys/module/apparmor/parameters/enabled)"
    fi
    echo; echo "== environment"
    env | grep -E '^(BDEX_FG|VK_|PROTON_|DXVK_|VKD3D_|MESA_|RADV_|__GL)' | sort || true
    echo; echo "== screens"
    if in_kde && command -v kscreen-doctor >/dev/null; then
      kscreen -o 2>&1 | sed 's/\x1b\[[0-9;]*m//g' | grep -E '^Output:|^\s*(enabled|disabled|connected|Vrr:|Geometry:)|Modes:' |
        sed -E 's/Modes:.*[ ]([0-9]+:[0-9]+x[0-9]+@[0-9.]+!?\*).*/Modes: \1 (current)/' || true
    fi
    if command -v xrandr >/dev/null && [ -n "${DISPLAY:-}" ]; then
      xrandr --query 2>&1 | grep -E ' connected|\*' || true
    fi
    echo "connected outputs (connector card driver):"
    connected_outputs | sed 's/^/  /'
    echo; echo "== GPUs"
    if command -v lspci >/dev/null; then lspci -nn 2>/dev/null | grep -Ei 'vga|3d|display' || true; fi
    echo; echo "== control panel session ($sdir/app.session: panel pid, target pid, refresh Hz)"
    if [ -f "$sdir/app.session" ]; then
      cat "$sdir/app.session"
      echo "written $(( $(date +%s) - $(stat -c %Y "$sdir/app.session") )) s ago (older than 5 s = panel closed)"
    else
      echo "(none)"
    fi
    for d in $(flatpak_dirs run); do
      echo "-- Flatpak: $d/app.session"
      if [ -f "$d/app.session" ]; then cat "$d/app.session"; else echo "(none)"; fi
    done
    echo; echo "== running games (live status)"
    found=0
    for f in "$sdir"/*.status $(flatpak_dirs run)/*.status; do
      [ -f "$f" ] || continue
      found=1; echo "-- $f"; cat "$f"
    done
    [ "$found" = 1 ] || echo "(none: start the game, then run --report while it runs)"
    echo; echo "== online_tune decisions (per game and mode)"
    cdir="${BDEX_FG_CACHE_DIR-${XDG_CACHE_HOME:-$HOME/.cache}/bdex-framegen}"
    found=0
    for f in "$cdir"/online-tune-*.txt; do
      [ -f "$f" ] || continue
      found=1; echo "-- $(basename "$f")"; cat "$f"
    done
    [ "$found" = 1 ] || echo "(none)"
    echo; echo "== config file ($cfg)"
    if [ -f "$cfg" ]; then cat "$cfg"; else echo "(none)"; fi
    for f in $(flatpak_dirs config); do
      if cmp -s "$cfg" "$f"; then echo "(same copy in $f)"; else echo "-- DIFFERENT copy in $f:"; cat "$f" 2>/dev/null; fi
    done
    if [ -n "$log" ]; then
      echo; echo "== last 200 lines of $log"
      tail -n 200 "$log" 2>/dev/null || echo "(unreadable)"
    fi
  } > "$out"
  echo "report written to $out — attach it to the issue (check it for anything private first)"
}

# online_tune's cached decisions for a game as a [game] config section.
tuned_profile() {
  BDEX_TP_CACHE="${BDEX_FG_CACHE_DIR-${XDG_CACHE_HOME:-$HOME/.cache}/bdex-framegen}" \
  BDEX_TP_CONFIG="${BDEX_FG_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/bdex-framegen.conf}" \
  python3 - "$@" <<'PY'
import os, re, sys, time
cache, config = os.environ["BDEX_TP_CACHE"], os.environ["BDEX_TP_CONFIG"]
args = sys.argv[1:]
apply = "--apply" in args
mode = args[args.index("--mode") + 1] if "--mode" in args else None
names = [a for i, a in enumerate(args) if not a.startswith("--") and (i == 0 or args[i - 1] != "--mode")]
pat = re.compile(r"online-tune-(.+)-(interpolate|extrapolate)\.txt$")
files = {}
for f in sorted(os.listdir(cache)) if os.path.isdir(cache) else []:
    m = pat.match(f)
    if m:
        files.setdefault(m.group(1), {})[m.group(2)] = os.path.join(cache, f)
if not names:
    if not files:
        print(f"no online_tune decisions in {cache} (run a game with online_tune=1 first)")
    for game, modes in sorted(files.items()):
        print(f"{game}: {', '.join(sorted(modes))}")
    sys.exit(0)
game = names[0].lower().removesuffix(".exe")
if game not in files:
    sys.exit(f"no online_tune decisions for '{game}' in {cache}")
modes = files[game]
if mode is None:  # the most recently tuned mode
    mode = max(modes, key=lambda m: os.path.getmtime(modes[m]))
if mode not in modes:
    sys.exit(f"'{game}' was not tuned in {mode} mode (only {', '.join(modes)})")
kept, total, decisions = [], 0, 0
for line in open(modes[mode]):
    parts = line.split()
    if len(parts) < 4:
        continue
    total += 1
    if parts[2] == "kept":  # pairs ("a+b" = "x+y") are several settings
        decisions += 1
        kept += list(zip(parts[0].split("+"), parts[1].split("+")))
stamp = time.strftime("%Y-%m-%d", time.localtime(os.path.getmtime(modes[mode])))
header = f"# online_tune ({mode}, {stamp}): {decisions} kept of {total} tried"
section = [f"[{game}]", header] + [f"{k} = {v}" for k, v in kept]
if not apply:
    print("\n".join(section))
    if not kept:
        print("# (none kept: the defaults suit this game)")
    sys.exit(0)
# Merge into the config file: the [game] section's keys set, other lines kept.
lines = open(config).read().splitlines() if os.path.exists(config) else []
start = next((i for i, l in enumerate(lines) if l.strip().lower() == f"[{game}]"), None)
if start is None:
    lines += [""] + section
else:
    end = next((i for i in range(start + 1, len(lines)) if lines[i].strip().startswith("[")), len(lines))
    body = [l for l in lines[start + 1:end]
            if not l.strip().startswith("# online_tune")
            and l.split("=")[0].strip().lower() not in {k for k, _ in kept}]
    lines[start:end] = [lines[start], header] + [f"{k} = {v}" for k, v in kept] + body
os.makedirs(os.path.dirname(config) or ".", exist_ok=True)
with open(config, "w") as f:
    f.write("\n".join(lines) + "\n")
print(f"[{game}] written to {config}: {', '.join(f'{k}={v}' for k, v in kept) or 'nothing kept'}")
PY
}

# Flips `paused` in the global [*] section of the config file. Running games
# pick the change up within ~0.5 s (the layer reloads live settings when the
# file changes) and present only their real frames while paused.
toggle() {
  cfg="${BDEX_FG_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/bdex-framegen.conf}"
  python3 - "$cfg" <<'PY'
import re, sys
from pathlib import Path
p = Path(sys.argv[1])
lines = p.read_text().splitlines() if p.exists() else []
section, start, end, found, paused = None, None, len(lines), None, False
for i, line in enumerate(lines):
    m = re.match(r"\s*\[(.*)\]\s*$", line)
    if m:
        if section == "*" and end == len(lines): end = i
        section = m.group(1).strip()
        if section == "*": start, end = i, len(lines)
    elif section == "*" and re.match(r"\s*paused?\s*=", line):
        found = i
        paused = line.split("=", 1)[1].strip().lower() in ("1", "true", "yes", "on")
new = f"paused = {0 if paused else 1}"
if found is not None: lines[found] = new
elif start is not None: lines.insert(start + 1, new)
else: lines = ["[*]", new] + ([""] if lines else []) + lines
p.parent.mkdir(parents=True, exist_ok=True)
p.write_text("\n".join(lines) + "\n")
print("frame generation", "resumed" if paused else "paused", f"({p})")
PY
  # Games in a Flatpak launcher read their own copy of the settings.
  local f
  for f in $(flatpak_dirs config); do
    mkdir -p "$(dirname "$f")" && cp "$cfg" "$f"
  done
}

# --sandboxes [--remove]: the layer of this installation copied into the
# sandboxed launchers (flatpak.sh, installed next to the profiles).
flatpak_script() {
  local prefix script
  prefix="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
  for script in "$prefix/share/bdex-framegen/flatpak.sh" "$prefix/packaging/linux/flatpak.sh"; do
    [ -f "$script" ] && { echo "$prefix $script"; return 0; }
  done
  return 1
}
sandboxes() {
  local prefix script
  read -r prefix script <<<"$(flatpak_script)"
  if [ -z "$script" ]; then
    echo "bdex-framegen: flatpak.sh not found next to this installation" >&2
    return 1
  fi
  if [ "${1:-}" = --remove ]; then bash "$script" --remove; else bash "$script" "$prefix"; fi
}
# The sandboxed copies an update of the layer left behind ("<app> <copy>" per
# line; nothing when they are all current, or no flatpak.sh).
stale_sandboxes() {
  local prefix script
  read -r prefix script <<<"$(flatpak_script)"
  [ -n "$script" ] || return 0
  bash "$script" --check "$prefix" || true
}

# --always-on / --always-off [GAME]: require_app = 0 in [GAME], or in [*] for
# every game (the panel's « Mode Jeu — sans le panneau »).
always() {
  local on="$1" game="${2:-}"
  cfg="${BDEX_FG_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/bdex-framegen.conf}"
  python3 - "$cfg" "$on" "$game" <<'PY'
import re, sys
from pathlib import Path
p, on, game = Path(sys.argv[1]), sys.argv[2] == "1", sys.argv[3].strip()
if game.lower().endswith(".exe"):
    game = game[:-4]
lines = p.read_text().splitlines() if p.exists() else []

def section(name):
    """(header index, end index) of [name], or None."""
    start = None
    for i, line in enumerate(lines):
        m = re.match(r"\s*\[(.*)\]\s*$", line)
        if m:
            if start is not None:
                return start, i
            if m.group(1).strip().lower() == name.lower():
                start = i
    return (start, len(lines)) if start is not None else None

def get(name, key):
    sec = section(name)
    for i in range(sec[0] + 1, sec[1]) if sec else ():
        m = re.match(rf"\s*{key}\s*=(.*)$", lines[i])
        if m:
            return m.group(1).strip()
    return None

def put(name, key, value):
    """Sets (value None: removes) key in [name]; [*] goes first: a later [*]
    would override the games' own lines."""
    sec = section(name)
    if sec is None:
        if value is None:
            return
        block = [f"[{name}]", f"{key} = {value}"]
        if name == "*":
            lines[0:0] = block + ([""] if lines else [])
        else:
            lines.extend(([""] if lines else []) + block)
        return
    for i in range(sec[0] + 1, sec[1]):
        if re.match(rf"\s*{key}\s*=", lines[i]):
            if value is None:
                del lines[i]
            else:
                lines[i] = f"{key} = {value}"
            return
    if value is not None:
        lines.insert(sec[0] + 1, f"{key} = {value}")

put("*", "enabled", "1")
if game:
    if get("*", "require_app") is None:
        put("*", "require_app", "1")   # the other games keep needing the panel
    put(game, "require_app", "0" if on else None)
    where = game
else:
    put("*", "require_app", "0" if on else "1")
    where = "every game"
p.parent.mkdir(parents=True, exist_ok=True)
p.write_text("\n".join(lines) + "\n")
if on:
    what = "frame generation from the start, without the control panel"
elif game and get("*", "require_app") == "0":
    what = "no setting of its own: every game generates without the panel (--always-off alone undoes that)"
else:
    what = "frame generation only once the control panel's « Démarrer » targets it"
print(f"{where}: {what} ({p})")
PY
  local f
  for f in $(flatpak_dirs config); do
    mkdir -p "$(dirname "$f")" && cp "$cfg" "$f"
  done
}

check() {
  if ! command -v vulkaninfo >/dev/null; then
    echo "vulkaninfo not found (install vulkan-tools)"; exit 1
  fi
  out="$(BDEX_FG=1 BDEX_FG_LOG=2 BDEX_FG_STATS=0 vulkaninfo --summary 2>&1)"
  if grep -q "VK_LAYER_BDEX_framegen.*loaded" <<<"$out"; then  # no pipe: pipefail + SIGPIPE
    echo "layer loaded: $(echo "$out" | grep -o "VK_LAYER_BDEX_framegen v[0-9.]*" | head -1)"
    echo "$out" | grep -o "device '.*" | head -1
    stale="$(stale_sandboxes)"
    if [ -n "$stale" ]; then
      echo "$stale" | sed 's/^/OUTDATED sandbox copy: /'
      echo "  → bdex-framegen --sandboxes (games in that launcher still run the old layer)"
      exit 2
    fi
    exit 0
  fi
  echo "layer NOT loaded. Manifests known to the loader:"
  echo "$out" | grep -i "bdex" || echo "  (none: run tools/install.sh, or set VK_ADD_IMPLICIT_LAYER_PATH=<build>/layer)"
  exit 1
}

# The Vulkan GPUs: "<vendorID> <deviceID> <type> <name>" per line (vulkaninfo,
# without our layer), the CPU ones left out; BDEX_GPU_LIST stands in for it
# (tests).
gpu_list() {
  if [ -n "${BDEX_GPU_LIST:-}" ]; then printf '%s\n' "$BDEX_GPU_LIST"; return; fi
  command -v vulkaninfo >/dev/null || return 0
  BDEX_FG_DISABLE=1 vulkaninfo --summary 2>/dev/null | awk -F' = ' '
    /^GPU[0-9]+:/ { if (v != "") print v, d, t, n; v = d = t = n = "" }
    /vendorID/ { v = $2 } /deviceID/ { d = $2 }
    /deviceType/ { t = $2; sub(/PHYSICAL_DEVICE_TYPE_/, "", t); sub(/_GPU/, "", t) }
    /deviceName/ { n = $2 }
    END { if (v != "") print v, d, t, n }' | awk '$3 != "CPU"' | awk '!seen[$1 $2]++'
}

# The PCI ids (vendor device, 0x...) of the GPUs driving a connected screen;
# BDEX_DRM_DIR stands in for /sys/class/drm (tests).
screen_gpus() {
  local c card dev
  for c in "${BDEX_DRM_DIR:-/sys/class/drm}"/card*-*; do
    [ "$(cat "$c/status" 2>/dev/null)" = connected ] || continue
    card="${c##*/}"; card="${card%%-*}"
    dev="${BDEX_DRM_DIR:-/sys/class/drm}/$card/device"
    echo "$(cat "$dev/vendor" 2>/dev/null) $(cat "$dev/device" 2>/dev/null)"
  done | awk 'NF == 2' | sort -u
}

# --gpu WHICH: the environment that puts the game on that GPU — Mesa's device
# selection (every Vulkan driver it orders, DRI_PRIME for OpenGL), NVIDIA's
# PRIME render offload, and DXVK / VKD3D-Proton's own filter (Proton games
# pick a GPU themselves).
gpu_env() {
  local which="$1" line pick="" v d t n
  local gpus; gpus="$(gpu_list)"
  if [ -z "$gpus" ]; then echo "bdex-framegen: no GPU listed (vulkaninfo missing?)" >&2; return 1; fi
  if [ "$which" = list ]; then
    local screens; screens="$(screen_gpus)"
    while read -r v d t n; do
      local mark=""; grep -qix "$v $d" <<<"$screens" && mark="  ← screen"
      echo "$v:$d  $(echo "$t" | tr 'A-Z' 'a-z')  $n$mark"
    done <<<"$gpus"
    exit 0
  fi
  while read -r v d t n; do
    case "$which" in
      screen) grep -qix "$v $d" <<<"$(screen_gpus)" && pick="$v $d $t $n" ;;
      discrete|dgpu) [ "$t" = DISCRETE ] && pick="$v $d $t $n" ;;
      integrated|igpu) [ "$t" = INTEGRATED ] && pick="$v $d $t $n" ;;
      nvidia) [ "$v" = 0x10de ] && pick="$v $d $t $n" ;;
      amd) [ "$v" = 0x1002 ] && pick="$v $d $t $n" ;;
      intel) [ "$v" = 0x8086 ] && pick="$v $d $t $n" ;;
      *) echo "bdex-framegen: --gpu screen | discrete | integrated | nvidia | amd | intel | list" >&2; return 2 ;;
    esac
    [ -n "$pick" ] && break
  done <<<"$gpus"
  if [ -z "$pick" ]; then echo "bdex-framegen: no $which GPU (bdex-framegen --gpu list)" >&2; return 1; fi
  read -r v d t n <<<"$pick"
  env_vars+=("MESA_VK_DEVICE_SELECT=${v#0x}:${d#0x}" "MESA_VK_DEVICE_SELECT_FORCE_DEFAULT_DEVICE=1"
             "DXVK_FILTER_DEVICE_NAME=$n" "VKD3D_FILTER_DEVICE_NAME=$n")
  if [ "$v" = 0x10de ]; then
    env_vars+=("__NV_PRIME_RENDER_OFFLOAD=1" "__VK_LAYER_NV_optimus=NVIDIA_only" "__GLX_VENDOR_LIBRARY_NAME=nvidia")
  else
    # (NVIDIA's own layer otherwise lists its GPU first)
    env_vars+=("__VK_LAYER_NV_optimus=non_NVIDIA_only" "DRI_PRIME=${v#0x}:${d#0x}")
  fi
  echo "bdex-framegen: game on $n" >&2
}

# OpenGL through Zink. MESA_LOADER_DRIVER_OVERRIDE alone only reaches Mesa's
# own GL: with a vendor driver installed (NVIDIA's), libglvnd dispatches GLX
# and EGL to it and Zink is never loaded — the game then runs on native GL,
# out of the layer's reach, without any error. Force the Mesa vendor too.
gl_env() {
  env_vars+=("MESA_LOADER_DRIVER_OVERRIDE=zink" "__GLX_VENDOR_LIBRARY_NAME=mesa")
  for d in /usr/share/glvnd/egl_vendor.d /etc/glvnd/egl_vendor.d; do
    for f in "$d"/*mesa*.json; do
      [ -f "$f" ] && { env_vars+=("__EGL_VENDOR_LIBRARY_FILENAMES=$f"); return; }
    done
  done
}

env_vars=(BDEX_FG=1)
while [ $# -gt 0 ]; do
  case "$1" in
    --toggle)          toggle; exit 0 ;;
    --always-on)       always 1 "${2:-}"; exit 0 ;;
    --always-off)      always 0 "${2:-}"; exit 0 ;;
    --sandboxes)       sandboxes "${2:-}"; exit $? ;;
    --report)          report "${2:-}"; exit 0 ;;
    --tuned-profile)   shift; tuned_profile "$@"; exit $? ;;
    --record)          rec="$2"; mkdir -p "$rec"; rec="$(realpath "$rec")"
                       n=240; case "${3:-}" in ''|*[!0-9]*) shift 2 ;; *) n="$3"; shift 3 ;; esac
                       env_vars+=("BDEX_FG_MULTIPLIER=1" "BDEX_FG_DUMP=$rec" "BDEX_FG_DUMP_FRAMES=$n") ;;
    -m|--multiplier)   env_vars+=("BDEX_FG_MULTIPLIER=$2"); shift 2 ;;
    -x|--extrapolate)  env_vars+=("BDEX_FG_MODE=extrapolate"); shift ;;
    -P|--preset)       env_vars+=("BDEX_FG_PRESET=$2"); shift 2 ;;
    -f|--fullres)      env_vars+=("BDEX_FG_FULLRES=1"); shift ;;
    -u|--upscale)      env_vars+=("BDEX_FG_UPSCALE=$2"); shift 2 ;;
    --upscale-filter)  env_vars+=("BDEX_FG_UPSCALE_FILTER=$2"); shift 2 ;;
    -s|--sharpness)    env_vars+=("BDEX_FG_SHARPNESS=$2"); shift 2 ;;
    -p|--present-mode) env_vars+=("BDEX_FG_PRESENT_MODE=$2"); shift 2 ;;
    -o|--hud)          env_vars+=("BDEX_FG_OVERLAY=$2"); shift 2 ;;
    -d|--debug)        env_vars+=("BDEX_FG_DEBUG=$2"); shift 2 ;;
    -l|--log)          env_vars+=("BDEX_FG_LOG=$2"); shift 2 ;;
    --profile)         env_vars+=("BDEX_FG_PROFILE=1"); shift ;;
    --no-stats)        env_vars+=("BDEX_FG_STATS=0"); shift ;;
    --gl)              gl_env; shift ;;
    --mangohud)        # Both implicit layers named in order, app side first:
                       # ours, then MangoHud's (64- and 32-bit names; the loader
                       # skips the one of the other width).
                       env_vars+=("MANGOHUD=1" "VK_INSTANCE_LAYERS=VK_LAYER_BDEX_framegen:VK_LAYER_MANGOHUD_overlay_x86_64:VK_LAYER_MANGOHUD_overlay_x86${VK_INSTANCE_LAYERS:+:$VK_INSTANCE_LAYERS}")
                       shift ;;
    --gpu)             gpu_env "${2:?--gpu needs screen, discrete, integrated, a vendor or list}" || exit $?; shift 2 ;;
    --off)             env_vars+=("BDEX_FG=0"); shift ;;
    --gui)             exec "$(dirname "$0")/bdex-framegen-gui" ;;
    --check)           check ;;
    -h|--help)         usage; exit 0 ;;
    --)                shift; break ;;
    -*)                echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
    *)                 break ;;
  esac
done
if [ $# -eq 0 ]; then
  echo "missing command" >&2
  usage >&2
  exit 2
fi
exec env "${env_vars[@]}" "$@"
