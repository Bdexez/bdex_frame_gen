#!/usr/bin/env bash
# Launcher: runs a program with the BDEX frame generation layer enabled.
#
#   bdex-framegen [options] -- <command> [args...]
#
# Options map to BDEX_FG_* environment variables (see README.md):
#   -m, --multiplier N     frames per real frame: 2 (default), 3 or 4
#   -x, --extrapolate      predict frames instead of interpolating: no added latency
#   -P, --preset NAME      quality | balanced (default) | performance | latency (min input lag)
#   -f, --fullres          compute the flow at full resolution (= --preset quality's flow)
#   -u, --upscale RATIO    render below display size and upscale (e.g. 1.5); X11/Xwayland only
#       --upscale-filter F bilinear | bicubic | lanczos (default)
#   -s, --sharpness N      contrast-adaptive sharpening after upscaling, 0..1 (0 = off)
#   -p, --present-mode M   auto (default: fifo -> mailbox) | app | fifo | mailbox | immediate | relaxed
#   -o, --hud LEVEL        on-screen fps counter: off | fps | framegen | low | full (0..4)
#   -d, --debug M          none | flow | split | passthrough
#   -l, --log N            log level 0..3
#       --profile          print GPU timings with the statistics
#       --no-stats         do not print frame rate statistics
#       --gl               OpenGL game: run it on Vulkan through Mesa's Zink driver
#       --off              run the program with the layer disabled
#       --gui              open the graphical launcher instead
#       --check            report whether the layer is found by the Vulkan loader
#       --toggle           pause / resume frame generation in running games (live,
#                          through the config file; bind it to a desktop shortcut)
#       --report [FILE]    write a diagnostic report for bug reports (default:
#                          ./bdex-framegen-report.txt)
#       --tuned-profile [GAME] [--mode M] [--apply]
#                          the options online_tune kept for GAME as a [GAME]
#                          config section (no GAME: list the tuned games);
#                          --apply writes it into the config file, ready to
#                          share or to add to layer/profiles.conf
#   -h, --help
set -euo pipefail

usage() { sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; }

# Everything a bug report needs, in one file to attach to an issue.
report() {
  out="${1:-bdex-framegen-report.txt}"
  cfg="${BDEX_FG_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/bdex-framegen.conf}"
  {
    echo "== bdex-framegen diagnostic report, $(date -u '+%Y-%m-%d %H:%M UTC')"
    echo; echo "== system"
    uname -srm
    grep -h '^PRETTY_NAME' /etc/os-release 2>/dev/null || true
    echo "session: ${XDG_SESSION_TYPE:-?}  desktop: ${XDG_CURRENT_DESKTOP:-?}  WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}  DISPLAY=${DISPLAY:-}"
    echo; echo "== layer"
    if command -v vulkaninfo >/dev/null; then
      BDEX_FG=1 BDEX_FG_LOG=2 BDEX_FG_STATS=0 vulkaninfo --summary 2>&1 |
        grep -E "bdex-fg|VK_LAYER_BDEX|deviceName|driverName|driverInfo|apiVersion|deviceType" | head -40
    else
      echo "vulkaninfo not found (install vulkan-tools)"
    fi
    echo; echo "== installed manifests"
    for d in /usr/share/vulkan/implicit_layer.d /etc/vulkan/implicit_layer.d \
             "${XDG_DATA_HOME:-$HOME/.local/share}/vulkan/implicit_layer.d"; do
      ls -l "$d"/*BDEX* 2>/dev/null || true
    done
    echo; echo "== environment"
    env | grep -E '^(BDEX_FG|VK_|PROTON_|DXVK_|VKD3D_|MESA_|RADV_|__GL)' | sort || true
    echo; echo "== running games (live status)"
    sdir="${BDEX_FG_STATUS_DIR:-${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/bdex-framegen}}"
    sdir="${sdir:-/tmp/bdex-framegen-$(id -u)}"
    found=0
    for f in "$sdir"/*.status; do
      [ -f "$f" ] || continue
      found=1; echo "-- $f"; cat "$f"
    done
    [ "$found" = 1 ] || echo "(none: start the game, then run --report while it runs)"
    echo; echo "== online_tune decisions (per game and mode)"
    cdir="${BDEX_FG_CACHE_DIR-${XDG_CACHE_HOME:-$HOME/.cache}/bdex-framegen}"
    found=0
    for f in "$cdir"/online-tune-*.txt; do
      [ -f "$f" ] || continue
      found=1; echo "-- $(basename "$f")"; cat "$f"
    done
    [ "$found" = 1 ] || echo "(none)"
    echo; echo "== config file ($cfg)"
    if [ -f "$cfg" ]; then cat "$cfg"; else echo "(none)"; fi
    log="$(grep -hE '^\s*log_file\s*=' "$cfg" 2>/dev/null | tail -1 | cut -d= -f2- | xargs || true)"
    log="${BDEX_FG_LOG_FILE:-$log}"
    if [ -n "$log" ]; then
      log="${log/#\~/$HOME}"
      echo; echo "== last 200 lines of $log"
      tail -n 200 "$log" 2>/dev/null || echo "(unreadable)"
    fi
  } > "$out"
  echo "report written to $out — attach it to the issue (check it for anything private first)"
}

# online_tune's cached decisions for a game as a [game] config section.
tuned_profile() {
  BDEX_TP_CACHE="${BDEX_FG_CACHE_DIR-${XDG_CACHE_HOME:-$HOME/.cache}/bdex-framegen}" \
  BDEX_TP_CONFIG="${BDEX_FG_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/bdex-framegen.conf}" \
  python3 - "$@" <<'PY'
import os, re, sys, time
cache, config = os.environ["BDEX_TP_CACHE"], os.environ["BDEX_TP_CONFIG"]
args = sys.argv[1:]
apply = "--apply" in args
mode = args[args.index("--mode") + 1] if "--mode" in args else None
names = [a for i, a in enumerate(args) if not a.startswith("--") and (i == 0 or args[i - 1] != "--mode")]
pat = re.compile(r"online-tune-(.+)-(interpolate|extrapolate)\.txt$")
files = {}
for f in sorted(os.listdir(cache)) if os.path.isdir(cache) else []:
    m = pat.match(f)
    if m:
        files.setdefault(m.group(1), {})[m.group(2)] = os.path.join(cache, f)
if not names:
    if not files:
        print(f"no online_tune decisions in {cache} (run a game with online_tune=1 first)")
    for game, modes in sorted(files.items()):
        print(f"{game}: {', '.join(sorted(modes))}")
    sys.exit(0)
game = names[0].lower().removesuffix(".exe")
if game not in files:
    sys.exit(f"no online_tune decisions for '{game}' in {cache}")
modes = files[game]
if mode is None:  # the most recently tuned mode
    mode = max(modes, key=lambda m: os.path.getmtime(modes[m]))
if mode not in modes:
    sys.exit(f"'{game}' was not tuned in {mode} mode (only {', '.join(modes)})")
kept, total, decisions = [], 0, 0
for line in open(modes[mode]):
    parts = line.split()
    if len(parts) < 4:
        continue
    total += 1
    if parts[2] == "kept":  # pairs ("a+b" = "x+y") are several settings
        decisions += 1
        kept += list(zip(parts[0].split("+"), parts[1].split("+")))
stamp = time.strftime("%Y-%m-%d", time.localtime(os.path.getmtime(modes[mode])))
header = f"# online_tune ({mode}, {stamp}): {decisions} kept of {total} tried"
section = [f"[{game}]", header] + [f"{k} = {v}" for k, v in kept]
if not apply:
    print("\n".join(section))
    if not kept:
        print("# (none kept: the defaults suit this game)")
    sys.exit(0)
# Merge into the config file: the [game] section's keys set, other lines kept.
lines = open(config).read().splitlines() if os.path.exists(config) else []
start = next((i for i, l in enumerate(lines) if l.strip().lower() == f"[{game}]"), None)
if start is None:
    lines += [""] + section
else:
    end = next((i for i in range(start + 1, len(lines)) if lines[i].strip().startswith("[")), len(lines))
    body = [l for l in lines[start + 1:end]
            if not l.strip().startswith("# online_tune")
            and l.split("=")[0].strip().lower() not in {k for k, _ in kept}]
    lines[start:end] = [lines[start], header] + [f"{k} = {v}" for k, v in kept] + body
os.makedirs(os.path.dirname(config) or ".", exist_ok=True)
with open(config, "w") as f:
    f.write("\n".join(lines) + "\n")
print(f"[{game}] written to {config}: {', '.join(f'{k}={v}' for k, v in kept) or 'nothing kept'}")
PY
}

# Flips `paused` in the global [*] section of the config file. Running games
# pick the change up within ~0.5 s (the layer reloads live settings when the
# file changes) and present only their real frames while paused.
toggle() {
  cfg="${BDEX_FG_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/bdex-framegen.conf}"
  python3 - "$cfg" <<'PY'
import re, sys
from pathlib import Path
p = Path(sys.argv[1])
lines = p.read_text().splitlines() if p.exists() else []
section, start, end, found, paused = None, None, len(lines), None, False
for i, line in enumerate(lines):
    m = re.match(r"\s*\[(.*)\]\s*$", line)
    if m:
        if section == "*" and end == len(lines): end = i
        section = m.group(1).strip()
        if section == "*": start, end = i, len(lines)
    elif section == "*" and re.match(r"\s*paused?\s*=", line):
        found = i
        paused = line.split("=", 1)[1].strip().lower() in ("1", "true", "yes", "on")
new = f"paused = {0 if paused else 1}"
if found is not None: lines[found] = new
elif start is not None: lines.insert(start + 1, new)
else: lines = ["[*]", new] + ([""] if lines else []) + lines
p.parent.mkdir(parents=True, exist_ok=True)
p.write_text("\n".join(lines) + "\n")
print("frame generation", "resumed" if paused else "paused", f"({p})")
PY
}

check() {
  if ! command -v vulkaninfo >/dev/null; then
    echo "vulkaninfo not found (install vulkan-tools)"; exit 1
  fi
  out="$(BDEX_FG=1 BDEX_FG_LOG=2 BDEX_FG_STATS=0 vulkaninfo --summary 2>&1)"
  if grep -q "VK_LAYER_BDEX_framegen.*loaded" <<<"$out"; then  # no pipe: pipefail + SIGPIPE
    echo "layer loaded: $(echo "$out" | grep -o "VK_LAYER_BDEX_framegen v[0-9.]*" | head -1)"
    echo "$out" | grep -o "device '.*" | head -1
    exit 0
  fi
  echo "layer NOT loaded. Manifests known to the loader:"
  echo "$out" | grep -i "bdex" || echo "  (none: run tools/install.sh, or set VK_ADD_IMPLICIT_LAYER_PATH=<build>/layer)"
  exit 1
}

# OpenGL through Zink. MESA_LOADER_DRIVER_OVERRIDE alone only reaches Mesa's
# own GL: with a vendor driver installed (NVIDIA's), libglvnd dispatches GLX
# and EGL to it and Zink is never loaded — the game then runs on native GL,
# out of the layer's reach, without any error. Force the Mesa vendor too.
gl_env() {
  env_vars+=("MESA_LOADER_DRIVER_OVERRIDE=zink" "__GLX_VENDOR_LIBRARY_NAME=mesa")
  for d in /usr/share/glvnd/egl_vendor.d /etc/glvnd/egl_vendor.d; do
    for f in "$d"/*mesa*.json; do
      [ -f "$f" ] && { env_vars+=("__EGL_VENDOR_LIBRARY_FILENAMES=$f"); return; }
    done
  done
}

env_vars=(BDEX_FG=1)
while [ $# -gt 0 ]; do
  case "$1" in
    --toggle)          toggle; exit 0 ;;
    --report)          report "${2:-}"; exit 0 ;;
    --tuned-profile)   shift; tuned_profile "$@"; exit $? ;;
    -m|--multiplier)   env_vars+=("BDEX_FG_MULTIPLIER=$2"); shift 2 ;;
    -x|--extrapolate)  env_vars+=("BDEX_FG_MODE=extrapolate"); shift ;;
    -P|--preset)       env_vars+=("BDEX_FG_PRESET=$2"); shift 2 ;;
    -f|--fullres)      env_vars+=("BDEX_FG_FULLRES=1"); shift ;;
    -u|--upscale)      env_vars+=("BDEX_FG_UPSCALE=$2"); shift 2 ;;
    --upscale-filter)  env_vars+=("BDEX_FG_UPSCALE_FILTER=$2"); shift 2 ;;
    -s|--sharpness)    env_vars+=("BDEX_FG_SHARPNESS=$2"); shift 2 ;;
    -p|--present-mode) env_vars+=("BDEX_FG_PRESENT_MODE=$2"); shift 2 ;;
    -o|--hud)          env_vars+=("BDEX_FG_OVERLAY=$2"); shift 2 ;;
    -d|--debug)        env_vars+=("BDEX_FG_DEBUG=$2"); shift 2 ;;
    -l|--log)          env_vars+=("BDEX_FG_LOG=$2"); shift 2 ;;
    --profile)         env_vars+=("BDEX_FG_PROFILE=1"); shift ;;
    --no-stats)        env_vars+=("BDEX_FG_STATS=0"); shift ;;
    --gl)              gl_env; shift ;;
    --off)             env_vars+=("BDEX_FG=0"); shift ;;
    --gui)             exec "$(dirname "$0")/bdex-framegen-gui" ;;
    --check)           check ;;
    -h|--help)         usage; exit 0 ;;
    --)                shift; break ;;
    -*)                echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
    *)                 break ;;
  esac
done
if [ $# -eq 0 ]; then
  echo "missing command" >&2
  usage >&2
  exit 2
fi
exec env "${env_vars[@]}" "$@"
