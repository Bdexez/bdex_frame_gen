        buttons = Gtk.Box(spacing=6)
        buttons.append(pick)
        if capture_wayland_available():
            way = Gtk.Button(label=tr("Fenêtre Wayland (portail)…"), valign=Gtk.Align.CENTER,
                             tooltip_text=tr("Un jeu en fenêtre Wayland native : le bureau demande laquelle partager"))
            way.connect("clicked", self.on_capture_wayland)
            buttons.append(way)
        buttons.append(refresh)
        self.running_group.set_header_suffix(buttons)
        self.running_rows = []

    def _refresh_running(self):
        for row in self.running_rows:
            self.running_group.remove(row)
        self.running_rows = []
        detected = detect_games()
        read_running(keep={inner_pid(pid) for pid, _ in detected})   # drops what crashed games left
        games, seen = [], set()
        for pid, name in sorted(detected, key=lambda g: g[1]):
            if name not in seen:
                seen.add(name)
                games.append((pid, name, read_status(pid)))
        pids = {g[0] for g in games}
        if self.target and self.target[0] and self.target[0] not in pids:   # the game has exited
            self._set_target(None)   # (a window picked for capture: its own end, see _beat)
        if self.selected and self.selected[0] not in pids:
            self.selected = None
        if not self.selected and len(games) == 1:
            self.selected = games[0][:2]
        self._refresh_session()
        if not games:
            row = Adw.ActionRow(title=tr("Aucun jeu en cours"),
                                subtitle=tr("Lance un jeu Vulkan (natif ou via Proton), puis « Actualiser la liste »"))
            self.running_group.add(row)
            self.running_rows.append(row)
            return
        group = None
        for pid, name, entries in games:
            lines = [d for d in (describe_entry(e) for e in entries) if d]
            armed = any(e.get("kind") == "swapchain" for e in entries)
            how = plan(entries, self.opt, capture_binary() is not None)
            lines.append("→ " + how[1])
            row = Adw.ActionRow(title=name, subtitle="\n".join(lines))
            radio = Gtk.CheckButton(valign=Gtk.Align.CENTER, sensitive=armed or how[0] == "capture")
            if group is None:
                group = radio
            else:
                radio.set_group(group)
            radio.set_active(self.selected is not None and self.selected[0] == pid)
            radio.connect("toggled", self.on_pick, (pid, name))
            row.add_prefix(radio)
            row.set_activatable_widget(radio)
            if armed:
                # A few seconds of this game for the evaluation corpus (the
                # layer writes its real frames; packed when done).
                rec = Gtk.Button(icon_name="media-record-symbolic", valign=Gtk.Align.CENTER,
                                 tooltip_text=tr("Enregistrer quelques secondes de ce jeu (corpus d'évaluation)"))
                rec.add_css_class("flat")
                rec.connect("clicked", self.on_record, (pid, name))
                row.add_suffix(rec)
            self.running_group.add(row)
            self.running_rows.append(row)

    def on_record(self, _btn, game):
        try:
            src = request_recording(game[0], game[1])
        except OSError as e:
            self.toast(tr(f"Enregistrement impossible : {e}"))
            return
        self.toast(tr(f"Enregistrement de {game[1]}… (le jeu peut ralentir quelques secondes)"))
        start = time.monotonic()

        def wait():
            if os.path.isfile(os.path.join(src, "DONE")):
                def pack():
                    out = finish_recording(src)
                    GLib.idle_add(lambda: self.toast(tr(f"Enregistrement prêt : {out}")) and False)
                threading.Thread(target=pack, daemon=True).start()
                return False
            if time.monotonic() - start > 120:
                self.toast(tr("L'enregistrement n'a pas abouti (le jeu est-il armé ?)"))
                return False
            return True
        GLib.timeout_add(1000, wait)

