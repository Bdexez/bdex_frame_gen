class Options:
    def __init__(self):
        self.generate = True
        self.preset = "auto"
        self.multiplier = 2
        self.auto_mult = True        # « Auto »: up to x4, never above the screen's refresh rate (target_fps = -1)
        self.adaptive = False        # « Adaptatif »: the whole refresh rate, fractional ratios included (adaptive = 1)
        self.mode = "interpolate"
        self.present = "auto"
        self.low_latency = False
        self.upscale = False
        self.render_scale = 67       # percent, 50..100
        self.filter = "lanczos"
        self.sharpness = 0           # percent, 0..100
        self.hud = 0                 # on-screen fps counter level, 0..4
        self.paused = False          # live pause (the layer reloads it while games run)
        self.without_panel = False   # every game generates from its start, panel or not (require_app = 0)
        self.gpu = ""                # the GPU that generates ("" = the game's), a part of its name
        self.method = "auto"         # auto (injection where possible, else capture) | layer | capture
        self.values = {o["key"]: o["default"] for o in OPTIONS}   # canonical strings

    def load_from(self, glob):
        g = {k.lower(): v for k, v in glob.items()}

        def flag(key, default=False):
            return g.get(key, "1" if default else "0").lower() in ("1", "true", "on", "yes")

        self.preset = g.get("preset", "auto").lower()
        try:
            self.multiplier = int(float(g.get("multiplier", "2")))
        except ValueError:
            self.multiplier = 2
        self.generate = self.multiplier > 1
        if self.multiplier < 2:
            self.multiplier = 2
        # A file without a multiplier (new user) starts on « Auto ».
        self.adaptive = flag("adaptive")
        self.auto_mult = not self.adaptive and ("multiplier" not in g or g.get("target_fps", "").lower() in ("-1", "auto"))
        m = g.get("mode", "").lower()
        self.mode = "extrapolate" if m.startswith("extrap") else "hybrid" if m == "hybrid" else "interpolate"
        self.present = g.get("present_mode", "auto").lower()
        self.low_latency = flag("low_latency")
        rs = g.get("render_scale")
        self.upscale = rs is not None and rs not in ("1", "1.0")
        try:
            self.render_scale = int(round(float(rs) * 100)) if rs else 67
        except ValueError:
            self.render_scale = 67
        self.filter = g.get("upscale_filter", "lanczos").lower()
        try:
            self.sharpness = int(round(float(g.get("sharpness", "0")) * 100))
        except ValueError:
            self.sharpness = 0
        hud = g.get("hud", g.get("overlay", "0")).lower()
        if hud in HUD_NAMED:
            self.hud = HUD_NAMED[hud]
        else:
            try:
                self.hud = max(0, min(4, int(float(hud))))
            except ValueError:
                self.hud = 0
        self.paused = flag("paused")
        self.without_panel = g.get("require_app", "1") == "0"
        gpu = g.get("gpu", "").strip()
        self.gpu = "" if gpu.lower() in ("", "auto", "game") else gpu
        meth = g.get("method", "auto").strip().lower()
        self.method = {"injection": "layer", "inject": "layer", "1": "layer", "2": "capture"}.get(meth, meth)
        if self.method not in ("auto", "layer", "capture"):
            self.method = "auto"
        for o in OPTIONS:
            self.values[o["key"]] = _parse_option(o, g.get(o["key"]))

    def write_into(self, glob):
        """Update the managed keys in `glob` in place, keeping unknown ones."""
        for k in GLOBAL_KEYS:
            glob.pop(k, None)
        glob["enabled"] = "1"       # every game armed ...
        # ... generating only where this panel's « Démarrer » targets — or,
        # « sans le panneau » (Steam's Game Mode, where the panel cannot stay
        # open beside a game), every game from its start.
        glob["require_app"] = "0" if self.without_panel else "1"
        glob["preset"] = self.preset
        if self.gpu:
            glob["gpu"] = self.gpu
        if self.method != "auto":
            glob["method"] = self.method
        glob["multiplier"] = str((auto_ceiling() if self.auto_mult or self.adaptive else self.multiplier) if self.generate else 1)
        if self.adaptive and self.generate:
            glob["adaptive"] = "1"
        if self.generate:
            glob["mode"] = self.mode
        glob["present_mode"] = self.present
        if self.low_latency:
            glob["low_latency"] = "1"
        if self.upscale and self.render_scale < 100:
            glob["render_scale"] = f"{self.render_scale / 100:.3f}".rstrip("0").rstrip(".")
            glob["upscale_filter"] = self.filter
            if self.sharpness > 0:
                glob["sharpness"] = f"{self.sharpness / 100:.2f}".rstrip("0").rstrip(".")
        if self.hud > 0:
            glob["overlay"] = str(self.hud)
        if self.paused:
            glob["paused"] = "1"
        for o in OPTIONS:
            value = self.values[o["key"]]
            if value != o["default"]:
                glob[o["key"]] = value
        # « Auto » is target_fps = -1 (the refresh rate); a fixed multiplier
        # drops it, whatever the advanced row still shows.
        if (self.auto_mult or self.adaptive) and self.generate:
            glob["target_fps"] = "auto"
        elif glob.get("target_fps", "").lower() in ("-1", "auto"):
            glob.pop("target_fps")

    def steam_string(self):
        """Equivalent per-game Steam launch options (BDEX_FG_* ... %command%)."""
        e = ["BDEX_FG=1"]
        if self.preset != "auto":
            e.append(f"BDEX_FG_PRESET={self.preset}")
        e.append(f"BDEX_FG_MULTIPLIER={(auto_ceiling() if self.auto_mult or self.adaptive else self.multiplier) if self.generate else 1}")
        if (self.auto_mult or self.adaptive) and self.generate:
            e.append("BDEX_FG_TARGET_FPS=auto")
        if self.adaptive and self.generate:
            e.append("BDEX_FG_ADAPTIVE=1")
        if self.generate:
            e.append(f"BDEX_FG_MODE={self.mode}")
        e.append(f"BDEX_FG_PRESENT_MODE={self.present}")
        if self.low_latency:
            e.append("BDEX_FG_LOW_LATENCY=1")
        if self.upscale and self.render_scale < 100:
            e.append("BDEX_FG_RENDER_SCALE=" + f"{self.render_scale / 100:.3f}".rstrip("0").rstrip("."))
            e.append(f"BDEX_FG_UPSCALE_FILTER={self.filter}")
            if self.sharpness > 0:
                e.append("BDEX_FG_SHARPNESS=" + f"{self.sharpness / 100:.2f}".rstrip("0").rstrip("."))
        if self.hud > 0:
            e.append(f"BDEX_FG_OVERLAY={self.hud}")
        for o in OPTIONS:
            value = self.values[o["key"]]
            if value != o["default"]:
                e.append(f"BDEX_FG_{o['key'].upper()}={shlex.quote(value)}")
        return " ".join(e) + " %command%"


def find_layer():
    """(installed, path) — whether the loader can see the layer manifest."""
    dirs = [
        os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")),
                     "vulkan/implicit_layer.d"),
        "/usr/share/vulkan/implicit_layer.d",
        "/usr/local/share/vulkan/implicit_layer.d",
    ]
    for d in dirs:
        try:
            for f in os.listdir(d):
                if "bdex" in f.lower():
                    return True, os.path.join(d, f)
        except OSError:
            pass
    return False, None


def detect_gpus():
    """GPU names the Vulkan loader sees (best effort, via vulkaninfo)."""
    try:
        out = subprocess.run(["vulkaninfo", "--summary"], capture_output=True, text=True, timeout=8).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    names = []
    for line in out.splitlines():
        s = line.strip()
        if s.startswith("deviceName") and "=" in s:
            name = s.split("=", 1)[1].strip()
            if name and name not in names:
                names.append(name)
    return names


def generation_gpus():
    """The GPUs one may choose to generate on (software renderers left out)."""
    return [g for g in detect_gpus() if "llvmpipe" not in g.lower() and "software" not in g.lower()]


def capture_binary():
    """bdex-capture: beside this panel (installed), in the build tree, or on PATH."""
    here = os.path.dirname(os.path.realpath(__file__))
    for p in (os.path.join(here, "bdex-capture"), os.path.join(here, "..", "build", "capture", "linux", "bdex-capture"),
              shutil.which("bdex-capture")):
        if p and os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    return None


def plan(entries, opt, capture_available=True):
    """How to generate for a detected game, from its status entries: ("layer",
    why) — injection, inside the game's presentation: the lowest latency —
    where the layer has the game's swapchain on the GPU chosen; else
    ("capture", why): bdex-capture on the chosen GPU (a game the layer stays
    out of, another GPU than the game's, or capture chosen)."""
    dev = next((e for e in entries if e.get("kind") == "device"), {})
    armed = any(e.get("kind") == "swapchain" and e.get("state") in ("ready", "generating", "paused") for e in entries)
    gpu_name = dev.get("device", "")
    other_gpu = bool(opt.gpu) and bool(gpu_name) and opt.gpu.lower() not in gpu_name.lower()
    if opt.method == "layer" or not capture_available:
        return "layer", tr("injection (couche Vulkan)")
    if opt.method == "capture":
        return "capture", tr("capture (choisie)")
    if other_gpu:
        return "capture", tr(f"capture sur {opt.gpu} (le jeu rend sur {gpu_name})")
    if dev.get("state") == "anti-cheat":
        return "capture", tr("capture (anti-triche : la couche reste hors du jeu)")
    if not armed:
        return "capture", tr("capture (la couche n'a pas la fenêtre du jeu)")
    return "layer", tr("injection (couche Vulkan)")


def game_anticheat(pid, entries):
    """The anti-cheat found with a game ("" none): the layer's report (it
    stayed out, or ignore_anticheat kept it on), else an anti-cheat's files
    beside its executable — Easy Anti-Cheat, BattlEye (a Proton game: the
    Windows .exe on its command line)."""
    dev = next((e for e in entries if e.get("kind") == "device"), {})
    if dev.get("anticheat"):
        return dev["anticheat"]
    if dev.get("state") == "anti-cheat":
        return tr("anti-triche")
    try:
        args = open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0")
    except OSError:
        return ""
    for a in args:
        a = a.decode(errors="replace").replace("\\", "/")
        if not a.lower().endswith(".exe") or "/" not in a:
            continue
        d = os.path.dirname(a)
        if d.startswith("Z:") or d.startswith("z:"):
            d = d[2:]
        for _ in range(4):
            if not d or d == "/":
                break
            for name, ac in (("EasyAntiCheat", "Easy Anti-Cheat"), ("EasyAntiCheat_EOS", "Easy Anti-Cheat"),
                             ("start_protected_game.exe", "Easy Anti-Cheat"), ("BattlEye", "BattlEye")):
                if os.path.exists(os.path.join(d, name)):
                    return ac
            d = os.path.dirname(d)
    return ""


def anticheat_warning(game, anticheat, how):
    """Prevention before generating in a game with an anti-cheat — the start
    goes ahead (the user's choice, 03/10)."""
    if how == "layer":
        return tr(f"⚠ {game} : anti-triche détecté ({anticheat}). La génération est injectée dans le jeu : "
                  "un bannissement est possible, à tes risques. Le lancement continue.")
    return tr(f"⚠ {game} : anti-triche détecté ({anticheat}). Capture de la fenêtre (rien n'est chargé dans le jeu), "
              "mais certains éditeurs interdisent tout logiciel tiers : à tes risques. Le lancement continue.")


RECORD_FRAMES = 150   # 5 s at 30 fps, 2.5 s at 60: past the 121 frames corpus_pack keeps


def recordings_dir():
    cache = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    return os.path.join(cache, "bdex-framegen", "recordings")


def request_recording(pid, name):
    """Asks the layer in game `pid` for its next RECORD_FRAMES real frames
    (<its status dir>/<its pid>.record): the directory they land in, as this
    panel sees it."""
    rel = "rec-" + re.sub(r"[^A-Za-z0-9_-]", "_", name)[:40] + time.strftime("-%Y%m%d-%H%M%S")
    sdir = game_paths(pid)[0]
    os.makedirs(sdir, mode=0o700, exist_ok=True)
    with open(os.path.join(sdir, f"{inner_pid(pid)}.record"), "w") as f:
        f.write(f"{RECORD_FRAMES} {rel}\n")
    return os.path.join(sdir, rel)


def finish_recording(src):
    """A finished recording (DONE in `src`): moved to recordings_dir(), packed
    for the corpus by tools/corpus_pack.py when it and Pillow are there (the
    frames removed then). The path kept (archive or directory)."""
    os.makedirs(recordings_dir(), exist_ok=True)
    dest = os.path.join(recordings_dir(), os.path.basename(src)[4:])
    shutil.move(src, dest)
    here = os.path.dirname(os.path.realpath(__file__))
    packer = next((p for p in (os.path.join(here, "corpus_pack.py"),
                               os.path.join(here, "..", "share", "bdex-framegen", "corpus_pack.py")) if os.path.isfile(p)), None)
    if packer:
        name = re.sub(r"[^A-Za-z0-9_-]", "-", os.path.basename(dest))
        out = dest + ".tar.gz"
        try:
            r = subprocess.run([sys.executable, packer, dest, out, "--name", name], capture_output=True, timeout=600)
            if r.returncode == 0 and os.path.isfile(out):
                shutil.rmtree(dest, ignore_errors=True)
                return out
        except (OSError, subprocess.SubprocessError):
            pass
    return dest


def capture_log_path():
    cache = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    return os.path.join(cache, "bdex-framegen", "capture.log")


def capture_wayland_available():
    """A Wayland session and a bdex-capture built with the screen-cast portal
    (PipeWire): native Wayland windows can be captured too."""
    binary = capture_binary()
    if not binary or not os.environ.get("WAYLAND_DISPLAY"):
        return False
    try:
        out = subprocess.run([binary, "--help"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    return "--wayland" in out


def start_capture(pid, gpu, wayland=False):
    """bdex-capture on a game window (by its pid; pid 0: the next window
    clicked; `wayland`: the window chosen in the desktop's screen-cast
    dialog), on `gpu` ("" = the best): the Popen, its output in capture.log."""
    binary = capture_binary()
    if not binary:
        raise OSError(tr("bdex-capture introuvable"))
    cmd = [binary] + (["--wayland"] if wayland else ["--pid", str(pid)] if pid else []) + (["--gpu", gpu] if gpu else [])
    os.makedirs(os.path.dirname(capture_log_path()), exist_ok=True)
    log = open(capture_log_path(), "w")
    try:
        env = dict(os.environ)
        env.setdefault("BDEX_FG_LOG", "2")   # (its statistics, in capture.log)
        return subprocess.Popen(cmd, stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, env=env)
    finally:
        log.close()


def stop_capture(proc):
    if proc is None or proc.poll() is not None:
        return
    proc.terminate()
    try:
        proc.wait(timeout=3)
    except subprocess.TimeoutExpired:
        proc.kill()


def status_dir():
    """Where the layer publishes one live status file per game (layer/src/status.h)
    and reads this panel's session: in the home, which Steam's container shares
    with Proton games (platformStatusDir)."""
    if "BDEX_FG_STATUS_DIR" in os.environ:
        return os.environ["BDEX_FG_STATUS_DIR"]
    home = os.environ.get("HOME")
    return os.path.join(home, ".cache", "bdex-framegen", "run") if home else f"/tmp/bdex-framegen-{os.getuid()}"


def session_path():
    """The session file the layer reads for require_app (platformAppSession)."""
    return os.path.join(status_dir(), "app.session")


# Game launchers installed as Flatpaks (packaging/linux/flatpak.sh installs the
# layer in their sandbox, which sees neither ~/.config nor ~/.cache).
FLATPAK_APPS = ("com.valvesoftware.Steam", "com.heroicgameslauncher.hgl", "net.lutris.Lutris",
                "com.usebottles.bottles")


# Snaps (Steam's on Ubuntu): their HOME is ~/snap/<name>/current, with the
# layer's manifest in its .local/share.
SNAP_APPS = ("steam",)


FLATPAK_EXTENSION = "org.freedesktop.Platform.VulkanLayer.BdexFramegen"


def flatpak_extension_branch(app, roots=None):
    """The Freedesktop runtime branch of a Flatpak app when the layer's
    extension is installed for it (it then loads the layer without a copy in
    the app's directory; packaging/linux/flatpak.sh), else None."""
    roots = roots or (os.path.expanduser("~/.local/share/flatpak"), "/var/lib/flatpak")
    for root in roots:
        try:
            with open(os.path.join(root, "app", app, "current", "active", "metadata")) as f:
                runtime = next((ln.split("=", 1)[1].strip() for ln in f if ln.startswith("runtime=")), "")
        except OSError:
            continue
        if not runtime.startswith("org.freedesktop.Platform/"):
            return None
        branch = runtime.rsplit("/", 1)[-1]
        arch = os.uname().machine
        if any(os.path.isdir(os.path.join(r, "runtime", FLATPAK_EXTENSION, arch, branch)) for r in roots):
            return branch
        return None
    return None


def sandbox_dirs():
    """(status dir, config file) inside each Flatpak or Snap launcher the layer
    is installed in: the paths a game started there reads."""
    out = []
    for app in FLATPAK_APPS:
        d = os.path.expanduser(f"~/.var/app/{app}")
        if os.path.isfile(os.path.join(d, "data/vulkan/implicit_layer.d/VK_LAYER_BDEX_framegen.json")) or \
                (os.path.isdir(d) and flatpak_extension_branch(app)):
            out.append((os.path.join(d, ".cache", "bdex-framegen", "run"), os.path.join(d, "config", "bdex-framegen.conf")))
    for app in SNAP_APPS:
        d = os.path.expanduser(f"~/snap/{app}/current")
        if os.path.isfile(os.path.join(d, ".local/share/vulkan/implicit_layer.d/VK_LAYER_BDEX_framegen.json")):
            out.append((os.path.join(d, ".cache", "bdex-framegen", "run"), os.path.join(d, ".config", "bdex-framegen.conf")))
    return out


def write_report():
    """bdex-framegen --report into the cache directory: (report path, the
    pre-filled issue form's URL), (None, None) without the CLI."""
    here = os.path.dirname(os.path.realpath(__file__))
    cli = os.path.join(here, "bdex-framegen")
    if not os.path.isfile(cli):
        cli = shutil.which("bdex-framegen")
    if not cli:
        return None, None
    cache = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    path = os.path.join(cache, "bdex-framegen", "bdex-framegen-report.txt")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    try:
        subprocess.run(["bash", cli, "--report", path], capture_output=True, timeout=120)
        url = subprocess.run(["bash", cli, "--issue-url", path], capture_output=True, text=True,
                             timeout=30).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None, None
    return path, url if url.startswith("https://") else None


def refresh_sandboxes():
    """Re-copies the layer into the Flatpak / Snap launchers whose copy an
    update left behind (a distribution package cannot write in the home):
    [names refreshed]. The copy goes through a new file, so running games keep
    the library they mapped."""
    here = os.path.dirname(os.path.realpath(__file__))
    prefix = os.path.normpath(os.path.join(here, ".."))
    for script in (os.path.join(prefix, "share", "bdex-framegen", "flatpak.sh"),
                   os.path.join(prefix, "packaging", "linux", "flatpak.sh")):
        if os.path.isfile(script):
            break
    else:
        return []
    try:
        out = subprocess.run(["bash", script, "--check", prefix], capture_output=True, text=True,
                             timeout=20).stdout
        stale = sorted({line.split(" ", 1)[0] for line in out.splitlines() if line.strip()})
        if stale:
            subprocess.run(["bash", script, prefix], capture_output=True, timeout=60, check=True)
        return stale
    except (OSError, subprocess.SubprocessError):
        return []


def proc_env(pid):
    """A process's environment (as it started)."""
    try:
        with open(f"/proc/{pid}/environ", "rb") as f:
            raw = f.read()
    except OSError:
        return {}
    env = {}
    for kv in raw.split(b"\0"):
        k, sep, v = kv.partition(b"=")
        if sep:
            env[k.decode(errors="replace")] = v.decode(errors="replace")
    return env


def inner_pid(pid):
    """A game's pid in its own pid namespace — a Flatpak app has one: the
    number the layer knows itself by (platformPid) and matches the session's
    target with."""
    try:
        with open(f"/proc/{pid}/status") as f:
            for line in f:
                if line.startswith("NSpid:"):
                    return int(line.split()[-1])
    except (OSError, ValueError, IndexError):
        pass
    return pid


def game_paths(pid):
    """(status dir, config file) of a running game as this panel reaches them:
    the paths of the game's own environment (a Flatpak app has its own HOME,
    XDG_CONFIG_HOME...), through /proc/<pid>/root, its view of the files. The
    same files as status_dir() / CONFIG_PATH for a game outside any sandbox."""
    env = proc_env(pid)
    home = env.get("HOME", "")
    sdir = env.get("BDEX_FG_STATUS_DIR") or (
        os.path.join(home, ".cache", "bdex-framegen", "run") if home else f"/tmp/bdex-framegen-{os.getuid()}")
    cfg = env.get("BDEX_FG_CONFIG") or os.path.join(
        env.get("XDG_CONFIG_HOME") or os.path.join(home, ".config"), "bdex-framegen.conf")
    root = f"/proc/{pid}/root"
    return root + sdir, root + cfg


def same_file(a, b):
    try:
        return os.path.samefile(a, b)
    except OSError:
        return os.path.abspath(a) == os.path.abspath(b)


def display_hz():
    """The highest refresh rate among the monitors (GDK reads it from the
    compositor / X server): the layer's target for « Auto » when it cannot
    measure the display itself (no present feedback, KDE + NVIDIA...)."""
    if HAVE_GTK:
        try:
            monitors = Gdk.Display.get_default().get_monitors()
            rates = [monitors.get_item(i).get_refresh_rate() for i in range(monitors.get_n_items())]
            return max(rates) / 1000.0 if rates else 0.0
        except Exception:  # no display, old GDK
            return 0.0
    # Text mode: the compositor's own tool first — under Wayland xrandr only
    # sees Xwayland's outputs (a made-up mode, or nothing) — then xrandr.
    return max(text_mode_rates(), default=0.0)


def _run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=4).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def rates_hyprctl(out):
    """`hyprctl monitors -j`: the current refresh rate of each monitor."""
    try:
        return [float(m["refreshRate"]) for m in json.loads(out) if not m.get("disabled")]
    except (ValueError, TypeError, KeyError):
        return []


def rates_kscreen(out):
    """`kscreen-doctor -j` (KDE): each enabled output's current mode."""
    try:
        rates = []
        for o in json.loads(out).get("outputs", []):
            if not o.get("enabled", True):
                continue
            for m in o.get("modes", []):
                if str(m.get("id")) == str(o.get("currentModeId")):
                    rates.append(float(m["refreshRate"]))
        return rates
    except (ValueError, TypeError, KeyError, AttributeError):
        return []


def rates_wlr(out):
    """`wlr-randr --json` (sway, river, Wayfire, labwc...): Hz of the current modes."""
    try:
        return [float(m["refresh"]) for o in json.loads(out) if o.get("enabled", True)
                for m in o.get("modes", []) if m.get("current")]
    except (ValueError, TypeError, KeyError, AttributeError):
        return []


def rates_mutter(out):
    """GNOME's DisplayConfig.GetCurrentState (as gdbus prints it): modes are
    ('1920x1080@143.998', 1920, 1080, 143.998..., ...{'is-current': <true>...})."""
    rates = []
    marks = [m for m in re.finditer(r"\('\d+x\d+@[\d.]+', \d+, \d+, ([\d.]+)", out)]
    for i, m in enumerate(marks):
        end = marks[i + 1].start() if i + 1 < len(marks) else len(out)
        if "'is-current': <true>" in out[m.end():end]:
            rates.append(float(m.group(1)))
    return rates


def rates_xrandr(out):
    """`xrandr --current`: the starred (current) mode of each output."""
    rates = []
    for line in out.splitlines():
        for tok in line.split()[1:]:
            if "*" in tok:
                try:
                    rates.append(float(tok.replace("*", "").replace("+", "")))
                except ValueError:
                    pass
    return rates


def text_mode_rates():
    if os.environ.get("WAYLAND_DISPLAY"):
        probes = []
        if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            probes.append((["hyprctl", "monitors", "-j"], rates_hyprctl))
        # (kscreen-doctor only answers in a Plasma session: elsewhere it waits.)
        if "KDE" in os.environ.get("XDG_CURRENT_DESKTOP", "") or os.environ.get("KDE_FULL_SESSION"):
            probes.append((["kscreen-doctor", "-j"], rates_kscreen))
        probes += [
                   (["wlr-randr", "--json"], rates_wlr),
                   (["gdbus", "call", "--session", "--dest", "org.gnome.Mutter.DisplayConfig",
                     "--object-path", "/org/gnome/Mutter/DisplayConfig",
                     "--method", "org.gnome.Mutter.DisplayConfig.GetCurrentState"], rates_mutter)]
        for cmd, parse in probes:
            if shutil.which(cmd[0]):
                rates = parse(_run(cmd))
                if rates:
                    return rates
    return rates_xrandr(_run(["xrandr", "--current"]))


def auto_ceiling():
    """The multiplier ceiling of « Auto » / « Adaptatif »: enough frames to
    fill the screen from ~40 fps (x4 up to 165 Hz, x6 up to 250 Hz, x8
    above), without allocating the output images of x8 for a 60 Hz screen —
    and no more than the GPU's calibration allows (bdex-calibrate)."""
    hz = display_hz()
    base = 4 if hz <= 165 else 6 if hz <= 250 else 8
    cal = read_calibration()
    if cal and abs(cal.get("refresh", 0) - hz) < 2:
        return max(2, min(base, int(cal["recommended"]["multiplier"])))
    return base


def calibrate_binary():
    here = os.path.dirname(os.path.realpath(__file__))
    for p in (os.path.join(here, "bdex-calibrate"), os.path.join(here, "..", "build", "tools", "calibrate", "bdex-calibrate")):
        if os.access(p, os.X_OK):
            return p
    return shutil.which("bdex-calibrate")


def calibration_path():
    cache = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    return os.path.join(cache, "bdex-framegen", "calibration.json")


def read_calibration():
    try:
        with open(calibration_path()) as f:
            d = json.load(f)
        return d if "recommended" in d else None
    except (OSError, ValueError):
        return None


def display_size():
    """The largest monitor's size in pixels (what the calibration measures at)."""
    if HAVE_GTK:
        try:
            monitors = Gdk.Display.get_default().get_monitors()
            best = (0, 0)
            for i in range(monitors.get_n_items()):
                m = monitors.get_item(i)
                g, sc = m.get_geometry(), m.get_scale_factor()
                if g.width * g.height * sc * sc > best[0] * best[1]:
                    best = (g.width * sc, g.height * sc)
            if best[0]:
                return best
        except Exception:
            pass
    try:
        out = subprocess.run(["xrandr", "--query"], capture_output=True, text=True, timeout=5).stdout
        m = re.search(r"(\d+)x(\d+)\s+\d+\.\d+\*", out)
        if m:
            return int(m.group(1)), int(m.group(2))
    except (OSError, subprocess.SubprocessError):
        pass
    return 1920, 1080


def run_calibration():
    """bdex-calibrate at the screen's size and refresh: its result (None
    without the tool or on failure), saved where read_calibration() reads."""
    binary = calibrate_binary()
    if not binary:
        return None
    w, h = display_size()
    hz = display_hz() or 60.0
    os.makedirs(os.path.dirname(calibration_path()), exist_ok=True)
    try:
        subprocess.run([binary, "--size", f"{w}x{h}", "--refresh", f"{hz:.1f}", "--json", calibration_path()],
                       capture_output=True, timeout=300)
    except (OSError, subprocess.SubprocessError):
        return None
    return read_calibration()


def calibration_summary(d):
    r = d["recommended"]
    preset = tr("automatique") if r["preset"] == "auto" else r["preset"]
    return tr(f"{d['gpu']} à {d['size'][0]}×{d['size'][1]}, {d['refresh']:.0f} Hz : profil {preset}, "
              f"jusqu'à ×{r['multiplier']} ({r['cost_ms']:.1f} ms de GPU par image du jeu)")


def session_dirs():
    """Every status directory a game may read the session from: this user's,
    and the one inside each Flatpak or Snap launcher (its sandbox home is its
    app directory), so that a game started there sees the panel open."""
    return [status_dir()] + [run for run, _ in sandbox_dirs()]


def write_session(target=0):
    """"<panel pid> <target pid> <refresh Hz>": the panel is open; `target` (a
    host pid) generates frames. Written into every directory a game reads it
    from, the target's pid as the game knows itself (inner_pid). Rewritten
    every second: the layer takes an older file for a closed panel."""
    hz = display_hz()
    tdir = game_paths(target)[0] if target else None
    dirs = session_dirs()
    if tdir and not any(same_file(tdir, d) for d in dirs if os.path.isdir(d)):
        dirs.append(tdir)
    for i, d in enumerate(dirs):
        try:
            os.makedirs(d, mode=0o700, exist_ok=True)
            mine = target and tdir and same_file(tdir, d)
            path = os.path.join(d, "app.session")
            with open(path + ".tmp", "w") as f:
                f.write(f"{os.getpid()} {inner_pid(target) if mine else 0} {hz:.3f}\n")
            os.replace(path + ".tmp", path)
        except OSError:
            if i == 0:
                raise  # this user's own directory must work


def remove_session():
    dirs = session_dirs()
    for d in dirs:
        path = os.path.join(d, "app.session")
        try:
            with open(path) as f:
                if int(f.read().split()[0]) != os.getpid():
                    continue  # another panel owns it
            os.remove(path)
        except (OSError, ValueError, IndexError):
            pass


def read_running(keep=()):
    """Live status of the running games: [(pid, process, [entry dict, ...])]; stale files skipped
    (and removed — unless their pid is in `keep`: a game in a pid namespace of
    its own, whose number means another process here)."""
    out = []
    try:
        names = sorted(os.listdir(status_dir()))
    except OSError:
        return out
    for name in names:
        if not name.endswith(".status"):
            continue
        path = os.path.join(status_dir(), name)
        try:
            text = open(path, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        head, entries, cur = {}, [], None
        for line in text.splitlines():
            line = line.strip()
            if line.startswith("[") and line.endswith("]"):
                cur = {"kind": line[1:-1].split()[0]}
                entries.append(cur)
            elif "=" in line:
                k, _, v = line.partition("=")
                (cur if cur is not None else head)[k] = v
        try:
            pid = int(head.get("pid", "0"))
            if pid not in keep:
                os.kill(pid, 0)  # still running?
        except (ValueError, ProcessLookupError, PermissionError):
            try:
                os.unlink(path)  # left behind by a crashed game
            except OSError:
                pass
            continue
        out.append((pid, head.get("process", "?"), entries))
    return out


def read_status(pid):
    """The live status entries of a detected game, from the directory and
    under the pid it knows (a Flatpak game: its own)."""
    path = os.path.join(game_paths(pid)[0], f"{inner_pid(pid)}.status")
    try:
        text = open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return []
    entries, cur = [], None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("[") and line.endswith("]"):
            cur = {"kind": line[1:-1].split()[0]}
            entries.append(cur)
        elif "=" in line and cur is not None:
            k, _, v = line.partition("=")
            cur[k] = v
    return entries


def mirror_config():
    """Copies the settings file where sandboxed games read theirs: each
    Flatpak or Snap launcher's config directory, and any running game whose config
    path is another file (its own XDG_CONFIG_HOME, BDEX_FG_CONFIG)."""
    try:
        with open(CONFIG_PATH, "rb") as f:
            data = f.read()
    except OSError:
        return
    targets = [cfg for _, cfg in sandbox_dirs()]
    for pid, _name in detect_games():
        cfg = game_paths(pid)[1]
        if not same_file(cfg, CONFIG_PATH):
            targets.append(cfg)
    for path in targets:
        if os.path.exists(path) and same_file(path, CONFIG_PATH):
            continue
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path + ".tmp", "wb") as f:
                f.write(data)
            os.replace(path + ".tmp", path)
        except OSError:
            pass


# Vulkan programs that are not games: the layer loads into them too (keep in
# sync with platformIsNonGame in layer/src/platform.cpp).
NOT_GAMES = {"steam", "steamwebhelper", "gamescope", "gamescopereaper", "gamescope-wl", "mangoapp",
             "steam-runtime-check-requirements", "chrome", "chromium",
             "firefox", "librewolf", "brave", "zen", "electron", "discord", "vesktop", "code",
             "obs", "vulkaninfo", "vkcube", "bdex-framegen-gui", "bdex-capture"}


def layer_name(arg):
    """A process's name as the layer matches [sections] (normalizeName in platform.cpp)."""
    base = arg.replace("\\", "/").rsplit("/", 1)[-1].strip().lower()
    return base.split(".", 1)[0]


def detect_games():
    """Running programs the layer is loaded into — every Vulkan program, native or
    through Proton (DXVK / VKD3D) — minus known non-games and GTK 4 applications
    (drawn with Vulkan; platformIsDesktopApp): [(pid, name)]."""
    out, me = [], os.getpid()
    for p in os.listdir("/proc"):
        if not p.isdigit() or int(p) == me:
            continue
        try:
            with open(f"/proc/{p}/maps", "rb") as f:
                maps = f.read()
            if b"libVkLayer_bdex_framegen" not in maps or b"libgtk-4.so" in maps:
                continue
            with open(f"/proc/{p}/cmdline", "rb") as f:
                args = [a.decode(errors="replace") for a in f.read().split(b"\0") if a.strip()]
        except OSError:
            continue
        if not args:
            continue
        exe = [a for a in args if a.lower().endswith(".exe")]  # Proton: the game's .exe
        first = args[0]
        if " " in first and not os.path.exists(first):
            first = first.split(" ", 1)[0]   # Electron & co. rewrite argv as one string
        name = layer_name(exe[0] if exe else first)
        try:
            args.append(os.readlink(f"/proc/{p}/exe"))   # the binary, for NOT_GAMES
        except OSError:
            pass
        if name and not NOT_GAMES & ({layer_name(a) for a in args[:2] + args[-1:]} | {name}):
            out.append((int(p), name))
    return out


def describe_entry(e):
    """One line of French for a status entry."""
    if e.get("kind") == "device":
        if e.get("state") == "active":
            return None
        return tr(f"Couche inactive : {e.get('reason', e.get('state', ''))}")
    state = e.get("state", "")
    if state == "ready":
        return tr("Prêt — sélectionne-le puis « Démarrer »")
    if state == "pass-through":
        return tr(f"Transparente — {e.get('reason', tr('raison inconnue'))}")
    parts = []
    try:
        game, outp = float(e.get("game_fps", 0)), float(e.get("output_fps", 0))
        parts.append(tr(f"{game:.0f} → {outp:.0f} i/s (×{e.get('multiplier', '?')}, "
                     f"{ {'extrapolate': 'extrapolation', 'hybrid': tr('hybride')}.get(e.get('mode'), 'interpolation')})"))
        hz, limit = float(e.get("refresh_hz", 0)), float(e.get("limit_hz", 0))
        if limit > 0:   # Steam's framerate limit (gamescope): nothing past it is shown
            parts.append(tr(f"limite Steam {limit:.0f} i/s (rien au-delà ne s'affiche)"))
        elif hz > 0:
            parts.append(tr(f"écran {hz:.0f} Hz"))
        lat = float(e.get("latency_ms", -1))
        if lat >= 0:
            parts.append(tr(f"latence {lat:.0f} ms"))
        lvl = int(e.get("gpu_budget_level", 0))
        if lvl > 0:
            parts.append(tr(f"budget GPU : niveau {lvl}"))
        unc = float(e.get("flow_uncertain_pct", -1))
        if unc >= 0:   # flow_confidence
            parts.append(tr(f"flux incertain sur {unc:.0f} % de l'image"))
        if e.get("reason") == "fast":   # skip_fast
            parts.append(tr("génération inutile : le jeu tient déjà la fréquence de l'écran"))
    except ValueError:
        pass
    prefix = tr("En pause — ") if state == "paused" else ""
    lines = [prefix + " · ".join(parts)]
    if e.get("passes"):
        lines.append(tr("Passes : ") + e["passes"].replace(",", ", "))
    if e.get("online_tune"):
        tune = e["online_tune"]   # (the layer writes it in English)
        if not FRENCH:
            pass
        elif tune.startswith("trying "):
            tune = "essai de " + tune[len("trying "):].replace(" decided)", " décidées)").replace(" of ", " sur ")
        else:
            tune = tune.replace(" kept", " gardée").replace(" dropped", " écartée").replace("flow change", "variation du flux")
        lines.append(tr("Réglage auto : ") + tune)
    return "\n".join(lines)


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="bdex-framegen")
        self.set_default_size(600, 860)
        self.cfg = ConfigFile.load()
        self.opt = Options()
        self.opt.load_from(self.cfg.glob)
        self._loading = True   # suppress auto-save while building/populating

        self.toasts = Adw.ToastOverlay()
        self.set_content(self.toasts)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.toasts.set_child(box)

        header = Adw.HeaderBar()
        title = Adw.WindowTitle(title="bdex-framegen", subtitle=tr("Génération d'images"))
        header.set_title_widget(title)
        menu = Gtk.Button(icon_name="edit-copy-symbolic",
                          tooltip_text=tr("Copier les options de lancement Steam équivalentes (par jeu)"))
        menu.connect("clicked", self.on_copy)
        header.pack_end(menu)
        if HAVE_ADW:
            box.append(header)
        else:
            self.set_titlebar(header)

        # No horizontal scrolling: long texts wrap to the window's width.
        scroller = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        box.append(scroller)
        page = Adw.PreferencesPage()
        scroller.set_child(page)

        self._build_session(page)
        self._build_without_panel(page)
        self._build_status(page)
        self._build_running(page)
        self._build_framegen(page)
        self._build_hud(page)
        self._build_upscale(page)
        self._build_present(page)
        self._build_advanced(page)

        self._loading = False
        self.refresh_sensitivity()
        # Every game armed, the session decides (require_app): written once.
        if self.cfg.glob.get("require_app") != "1" or self.cfg.glob.get("enabled") != "1":
            self.save()
        self.target = None     # (pid, name) where « Démarrer » started the generation
        self.target_how = None  # ("layer" | "capture", why) for the target
        self.capture_proc = None  # bdex-capture, when the target is captured
        self.selected = None   # (pid, name) chosen in « Jeux détectés »
        try:
            write_session(0)   # open: upscaling applies to games started from now
        except OSError as e:
            self.toast(tr(f"Session impossible : {e}"))
        self._refresh_running()
        GLib.timeout_add_seconds(1, self._beat)
        GLib.idle_add(self._refresh_sandboxes)
        self.connect("close-request", self._on_close)

    def _refresh_sandboxes(self):
        apps = refresh_sandboxes()
        if apps:
            self.toast(tr("Couche mise à jour dans : ") + ", ".join(a.replace("snap:", "Snap ") for a in apps))
        return False

    def _beat(self):
        if self.capture_proc is not None and self.capture_proc.poll() is not None:
            # the capture ended: the game closed, or it failed (capture.log)
            self.capture_proc = None
            self.target, self.target_how = None, None
            self.toast(tr("Capture terminée (journal : ~/.cache/bdex-framegen/capture.log)"))
            self._refresh_session()
        try:
            layer = self.target and self.target_how and self.target_how[0] == "layer"
            write_session(self.target[0] if layer else 0)
        except OSError:
            pass
        return True

    def _on_close(self, *_):
        stop_capture(self.capture_proc)
        remove_session()       # the targeted game stops generating
        return False

    # -- sections ----------------------------------------------------------

    def _build_session(self, page):
        g = Adw.PreferencesGroup()
        page.add(g)
        self.session_row = Adw.ActionRow()
        self.session_icon = Gtk.Image(valign=Gtk.Align.CENTER)
        self.session_row.add_prefix(self.session_icon)
        self.session_btn = Gtk.Button(valign=Gtk.Align.CENTER)
        self.session_btn.connect("clicked", self.on_session)
        self.session_row.add_suffix(self.session_btn)
        g.add(self.session_row)

    def _build_without_panel(self, page):
        """Steam's Game Mode (Steam Deck, SteamOS) runs one application at a time:
        the panel cannot stay open beside the game there. These games generate
        from their start, with the settings below, the panel closed."""
        g = Adw.PreferencesGroup(
            title=tr("Mode Jeu — sans le panneau"),
            description=tr("Dans le mode Jeu de SteamOS (Steam Deck), ce panneau ne peut pas rester ouvert "
                        "à côté du jeu : ces jeux génèrent dès leur lancement, avec les réglages ci-dessous. "
                        "Steam, gamescope et les applications de bureau restent exclus. Autre voie, par jeu : "
                        "les options de lancement Steam (bouton copier en haut)."))
        page.add(g)
        self.always_all_row = Adw.SwitchRow(title=tr("Tous les jeux"), active=self.opt.without_panel,
                                            subtitle=tr("Chaque jeu Vulkan génère dès son lancement, panneau fermé"))
        self.always_all_row.connect("notify::active", self.on_change)
        g.add(self.always_all_row)
        self.always_row = Adw.SwitchRow(title=tr("Le jeu sélectionné"))
        self.always_row.connect("notify::active", self.on_always)
        g.add(self.always_row)
        self.always_group = g
        self.always_rows = []

    def _refresh_always(self):
        """The per-game rows: the selected game's switch, then the other games
        already set to generate without the panel (each with « Retirer »)."""
        always = self.cfg.always_games()
        name = self.selected[1] if self.selected else None
        self._always_loading = True
        self.always_row.set_title(tr(f"Ce jeu : {name}") if name else tr("Le jeu sélectionné"))
        self.always_row.set_subtitle(tr("Génère dès son lancement, panneau fermé") if name else
                                     tr("Sélectionne un jeu dans « Jeux détectés » (lancé une fois ici)"))
        self.always_row.set_active(name is not None and name.lower() in (a.lower() for a in always))
        self.always_row.set_sensitive(name is not None and not self.opt.without_panel)
        self._always_loading = False
        for row in self.always_rows:
            self.always_group.remove(row)
        self.always_rows = []
        for game in always:
            if name is not None and game.lower() == name.lower():
                continue
            row = Adw.ActionRow(title=game, subtitle=tr("Génère sans le panneau"))
            btn = Gtk.Button(label=tr("Retirer"), valign=Gtk.Align.CENTER)
            btn.connect("clicked", lambda _b, gname=game: self._set_always(gname, False))
            row.add_suffix(btn)
            self.always_group.add(row)
            self.always_rows.append(row)

    def on_always(self, row, _param):
        if getattr(self, "_always_loading", False) or not self.selected:
            return
        self._set_always(self.selected[1], row.get_active())

    def _set_always(self, name, on):
        self.save()                    # (re-reads the file: hand edits survive)
        self.cfg.set_always(name, on)
        try:
            self.cfg.write()
        except OSError as e:
            self.toast(tr(f"Échec de l'enregistrement : {e}"))
            return
        mirror_config()
        self.toast(tr(f"{name} : génère sans le panneau.") if on else tr(f"{name} : seulement avec « Démarrer »."))
        self._refresh_always()

    def _refresh_session(self):
        on = self.target is not None
        if self.opt.without_panel:
            self.session_row.set_title(tr("Actif dans tous les jeux, sans le panneau"))
            self.session_row.set_subtitle(tr("Chaque jeu génère dès son lancement ; les réglages s'appliquent en "
                                          "direct, « En pause » suspend la génération."))
            self.session_icon.set_from_icon_name("media-playback-start-symbolic")
            self.session_btn.set_visible(False)
            if hasattr(self, "always_row"):
                self._refresh_always()
            return
        self.session_btn.set_visible(True)
        if hasattr(self, "always_row"):
            self._refresh_always()
        if on:
            self.session_row.set_title(tr(f"Génération en cours : {self.target[1]}") +
                                       (f" — {self.target_how[1]}" if self.target_how else ""))
            self.session_row.set_subtitle(tr("Les réglages s'appliquent en direct. « Arrêter » ou fermer "
                                          "cette fenêtre coupe la génération."))
        else:
            self.session_row.set_title(tr("Framegen arrêté"))
            self.session_row.set_subtitle(
                tr(f"Jeu sélectionné : {self.selected[1]} — clique « Démarrer ».") if self.selected else
                tr("Lance ton jeu, sélectionne-le dans « Jeux détectés », puis « Démarrer »."))
        self.session_icon.set_from_icon_name("media-playback-start-symbolic" if on
                                             else "media-playback-stop-symbolic")
        self.session_btn.set_label(tr("Arrêter") if on else tr("Démarrer"))
        self.session_btn.set_sensitive(on or self.selected is not None)
        for c in ("suggested-action", "destructive-action"):
            self.session_btn.remove_css_class(c)
        self.session_btn.add_css_class("destructive-action" if on else "suggested-action")

    def _set_target(self, target, pick=False, wayland=False):
        """Generation for `target` (pid, name), or none: injection through the
        layer's session where plan() says so, else bdex-capture on the game's
        window (`pick`: on the next window clicked, any program)."""
        stop_capture(self.capture_proc)
        self.capture_proc = None
        how = None
        if target:
            how = ("capture", tr("capture (fenêtre choisie)")) if pick else \
                plan(read_status(target[0]), self.opt, capture_binary() is not None)
        if target and not pick:
            ac = game_anticheat(target[0], read_status(target[0]))
            if ac:
                self.warn(anticheat_warning(target[1], ac, how[0]))
        try:
            if target:
                self.save()   # the game reads the options shown here
            write_session(target[0] if target and how[0] == "layer" else 0)
            if how and how[0] == "capture":
                self.capture_proc = start_capture(0 if pick else inner_pid(target[0]), self.opt.gpu, wayland)
        except OSError as e:
            self.toast(tr(f"Échec : {e}"))
            target, how = None, None
        self.target = target
        self.target_how = how
        self._refresh_session()

    def on_session(self, _btn):
        self._set_target(None if self.target else self.selected)
        GLib.timeout_add(1500, self._refresh_after_switch)

    def _refresh_after_switch(self):
        self._refresh_running()   # the game's status follows within ~0.5 s
        return False

    def _build_status(self, page):
        g = Adw.PreferencesGroup(title=tr("État"))
        page.add(g)
        installed, path = find_layer()
        self.installed = installed
