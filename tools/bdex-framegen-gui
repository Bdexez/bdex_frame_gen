# Every other layer option, in collapsed sections under "Réglages avancés".
# Each option maps a config key to a control:
#   spin   — a number (lower, upper, step, digits; digits 0 = integer)
#   switch — on/off, written as 1/0
#   choice — one of fixed values
#   text   — free text (paths)
# A value equal to its default is not written to the file (nor to the Steam
# string), so leaving these alone keeps the config minimal and the layer on
# its own defaults (config.h holds the same defaults).


def spin(key, title, sub, lower, upper, step, digits, default):
    return dict(kind="spin", key=key, title=title, sub=sub, lower=lower, upper=upper,
                step=step, digits=digits, default=_fmt_num(default, digits))


def switch(key, title, sub, default=False):
    return dict(kind="switch", key=key, title=title, sub=sub, default="1" if default else "0")


def choice(key, title, sub, choices, default):
    return dict(kind="choice", key=key, title=title, sub=sub, choices=choices, default=default)


def text(key, title, sub):
    return dict(kind="text", key=key, title=title, sub=sub, default="")


def _fmt_num(value, digits):
    if digits == 0:
        return str(int(round(value)))
    s = f"{value:.{digits}f}".rstrip("0").rstrip(".")
    return s or "0"


