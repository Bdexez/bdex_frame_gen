# Every other layer option, in collapsed sections under "Réglages avancés".
# Each option maps a config key to a control:
#   spin   — a number (lower, upper, step, digits; digits 0 = integer)
#   switch — on/off, written as 1/0
#   choice — one of fixed values
#   text   — free text (paths)
# A value equal to its default is not written to the file (nor to the Steam
# string), so leaving these alone keeps the config minimal and the layer on
# its own defaults (config.h holds the same defaults).


def spin(key, title, sub, lower, upper, step, digits, default):
    return dict(kind="spin", key=key, title=title, sub=sub, lower=lower, upper=upper,
                step=step, digits=digits, default=_fmt_num(default, digits))


def switch(key, title, sub, default=False):
    return dict(kind="switch", key=key, title=title, sub=sub, default="1" if default else "0")


def choice(key, title, sub, choices, default):
    return dict(kind="choice", key=key, title=title, sub=sub, choices=choices, default=default)


def text(key, title, sub):
    return dict(kind="text", key=key, title=title, sub=sub, default="")


def _fmt_num(value, digits):
    if digits == 0:
        return str(int(round(value)))
    s = f"{value:.{digits}f}".rstrip("0").rstrip(".")
    return s or "0"


# The option sections are described once, in layer/options_ui.conf (labels,
# help, UI ranges), completed from the engine's option registry (kinds,
# defaults) by bdex_options at build time into options_ui.json — installed
# next to this panel, or found in the build tree when run from the sources.
def _m(text):
    """Plain text for an Adwaita row (its title and subtitle are Pango markup:
    "< 1" in a help text made the whole text vanish)."""
    return GLib.markup_escape_text(text)


def options_ui_path():
    here = os.path.dirname(os.path.realpath(__file__))
    for p in (os.environ.get("BDEX_FG_OPTIONS_UI"),
              os.path.join(here, "..", "share", "bdex-framegen", "options_ui.json"),
              os.path.join(here, "..", "build", "options_ui.json")):
        if p and os.path.isfile(p):
            return p
    return None


def load_sections():
    """[(id, title, subtitle, expanded, [option dict, ...])] for the panel."""
    path = options_ui_path()
    if not path:
        sys.stderr.write("bdex-framegen-gui: options_ui.json not found (build the project, or set "
                         "BDEX_FG_OPTIONS_UI); the advanced options are not shown\n")
        return []
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
    sections = []
    for sec in data:
        if not sec["gui"]:
            continue
        opts = []
        for o in sec["options"]:
            if not o["gui"]:
                continue
            k, key, label, sub = o["kind"], o["key"], o["label"], o["help"]
            if k == "switch":
                opts.append(switch(key, label, sub, o["default"] == "1"))
            elif k == "spin":
                opts.append(spin(key, label, sub, o["lo"], o["hi"], o["step"], o["digits"],
                                 float(o["default"] or 0)))
            elif k == "choice":
                opts.append(choice(key, label, sub, [(lab, val) for val, lab in o["choices"]], o["default"]))
            elif k == "text":
                opts.append(text(key, label, sub))
        sections.append((sec["id"], sec["title"], sec["subtitle"], sec["expanded"], opts))
    return sections


SECTIONS = load_sections()
OPTIONS = [o for _, _, _, _, opts in SECTIONS for o in opts]


def _parse_option(o, raw):
    """Canonical string of an option's value read from the file (default if absent/invalid)."""
    if raw is None:
        return o["default"]
    raw = raw.strip()
    if o["kind"] == "spin":
        if raw.lower() == "auto" and o["lower"] < 0:
            return _fmt_num(-1, o["digits"])  # "auto", shown as -1
        try:
            v = min(o["upper"], max(o["lower"], float(raw)))
        except ValueError:
            return o["default"]
        return _fmt_num(v, o["digits"])
    if o["kind"] == "switch":
        return "1" if raw.lower() in ("1", "true", "on", "yes") else "0"
    if o["kind"] == "choice":
        values = [v for _, v in o["choices"]]
        return raw.lower() if raw.lower() in values else o["default"]
    return raw


def _combo_index(table, value, default=0):
    for i, (_, v) in enumerate(table):
        if v == value:
            return i
    return default


# ---------------------------------------------------------------------------
# Config file: a tiny INI reader/writer that preserves keys the UI does not
# manage, so hand-written tuning in the file survives a save.
# ---------------------------------------------------------------------------

# Keys the UI owns in the global section; anything else found there is kept.
GLOBAL_KEYS = ("enabled", "require_app", "preset", "multiplier", "adaptive", "mode", "present_mode",
               "low_latency", "render_scale", "upscale_filter", "sharpness",
               "overlay", "hud", "paused") + tuple(o["key"] for o in OPTIONS)


class ConfigFile:
    def __init__(self):
        self.glob = {}                 # global ([*] / pre-section) key -> value
        self.games = []                # list of [name, dict(key->value)]

    @staticmethod
    def load(path=CONFIG_PATH):
        c = ConfigFile()
        try:
            with open(path) as f:
                lines = f.readlines()
        except OSError:
            return c
        section = None  # None = global preamble
        for raw in lines:
            t = raw.strip()
            if not t or t[0] in "#;":
                continue
            if t[0] == "[" and t[-1] == "]":
                name = t[1:-1].strip()
                section = None if name == "*" else name
                if section is not None and not c._game(section):
                    c.games.append([section, {}])
                continue
            if "=" not in t:
                continue
            k, v = t.split("=", 1)
            k, v = k.strip().lower(), v.strip()
            if section is None:
                c.glob[k] = v
            else:
                c._game(section)[1][k] = v
        return c

    def _game(self, name):
        for g in self.games:
            if g[0].lower() == name.lower():
                return g
        return None

    def game_dict(self, name):
        g = self._game(name)
        return g[1] if g else None

    def enabled_games(self):
        return [g[0] for g in self.games if g[1].get("enabled", "0") in ("1", "true", "on", "yes")]

    def set_game(self, name, on):
        g = self._game(name)
        if g is None:
            g = [name, {}]
            self.games.append(g)
        g[1]["enabled"] = "1" if on else "0"

    def always_games(self):
        """Games that generate without the panel: require_app = 0 in their section."""
        return [g[0] for g in self.games if g[1].get("require_app") == "0"]

    def set_always(self, name, on):
        g = self._game(name)
        if on:
            if g is None:
                g = [name, {}]
                self.games.append(g)
            g[1]["require_app"] = "0"
        elif g is not None:
            g[1].pop("require_app", None)
            if not g[1]:
                self.remove_game(name)

    def remove_game(self, name):
        self.games = [g for g in self.games if g[0].lower() != name.lower()]

    def write(self, path=CONFIG_PATH):
        out = ["# bdex-framegen — written by the control panel (bdex-framegen-gui).\n",
               "# [*] applies to every game; a [name] section applies to that game only.\n",
               "\n[*]\n"]
        for k, v in self.glob.items():
            out.append(f"{k} = {v}\n")
        for name, d in self.games:
            out.append(f"\n[{name}]\n")
            for k, v in d.items():
                out.append(f"{k} = {v}\n")
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            f.write("".join(out))
        os.replace(tmp, path)


# ---------------------------------------------------------------------------
# UI state for the shared (global) options, mapped to config keys.
# ---------------------------------------------------------------------------

class Options:
    def __init__(self):
        self.generate = True
        self.preset = "auto"
        self.multiplier = 2
        self.auto_mult = True        # « Auto »: up to x4, never above the screen's refresh rate (target_fps = -1)
        self.adaptive = False        # « Adaptatif »: the whole refresh rate, fractional ratios included (adaptive = 1)
        self.mode = "interpolate"
        self.present = "auto"
        self.low_latency = False
        self.upscale = False
        self.render_scale = 67       # percent, 50..100
        self.filter = "lanczos"
        self.sharpness = 0           # percent, 0..100
        self.hud = 0                 # on-screen fps counter level, 0..4
        self.paused = False          # live pause (the layer reloads it while games run)
        self.without_panel = False   # every game generates from its start, panel or not (require_app = 0)
        self.values = {o["key"]: o["default"] for o in OPTIONS}   # canonical strings

    def load_from(self, glob):
        g = {k.lower(): v for k, v in glob.items()}

        def flag(key, default=False):
            return g.get(key, "1" if default else "0").lower() in ("1", "true", "on", "yes")

        self.preset = g.get("preset", "auto").lower()
        try:
            self.multiplier = int(float(g.get("multiplier", "2")))
        except ValueError:
            self.multiplier = 2
        self.generate = self.multiplier > 1
        if self.multiplier < 2:
            self.multiplier = 2
        # A file without a multiplier (new user) starts on « Auto ».
        self.adaptive = flag("adaptive")
        self.auto_mult = not self.adaptive and ("multiplier" not in g or g.get("target_fps", "").lower() in ("-1", "auto"))
        m = g.get("mode", "").lower()
        self.mode = "extrapolate" if m.startswith("extrap") else "hybrid" if m == "hybrid" else "interpolate"
        self.present = g.get("present_mode", "auto").lower()
        self.low_latency = flag("low_latency")
        rs = g.get("render_scale")
        self.upscale = rs is not None and rs not in ("1", "1.0")
        try:
            self.render_scale = int(round(float(rs) * 100)) if rs else 67
        except ValueError:
            self.render_scale = 67
        self.filter = g.get("upscale_filter", "lanczos").lower()
        try:
            self.sharpness = int(round(float(g.get("sharpness", "0")) * 100))
        except ValueError:
            self.sharpness = 0
        hud = g.get("hud", g.get("overlay", "0")).lower()
        if hud in HUD_NAMED:
            self.hud = HUD_NAMED[hud]
        else:
            try:
                self.hud = max(0, min(4, int(float(hud))))
            except ValueError:
                self.hud = 0
        self.paused = flag("paused")
        self.without_panel = g.get("require_app", "1") == "0"
        for o in OPTIONS:
            self.values[o["key"]] = _parse_option(o, g.get(o["key"]))

    def write_into(self, glob):
        """Update the managed keys in `glob` in place, keeping unknown ones."""
        for k in GLOBAL_KEYS:
            glob.pop(k, None)
        glob["enabled"] = "1"       # every game armed ...
        # ... generating only where this panel's « Démarrer » targets — or,
        # « sans le panneau » (Steam's Game Mode, where the panel cannot stay
        # open beside a game), every game from its start.
        glob["require_app"] = "0" if self.without_panel else "1"
        glob["preset"] = self.preset
        glob["multiplier"] = str((auto_ceiling() if self.auto_mult or self.adaptive else self.multiplier) if self.generate else 1)
        if self.adaptive and self.generate:
            glob["adaptive"] = "1"
        if self.generate:
            glob["mode"] = self.mode
        glob["present_mode"] = self.present
        if self.low_latency:
            glob["low_latency"] = "1"
        if self.upscale and self.render_scale < 100:
            glob["render_scale"] = f"{self.render_scale / 100:.3f}".rstrip("0").rstrip(".")
            glob["upscale_filter"] = self.filter
            if self.sharpness > 0:
                glob["sharpness"] = f"{self.sharpness / 100:.2f}".rstrip("0").rstrip(".")
        if self.hud > 0:
            glob["overlay"] = str(self.hud)
        if self.paused:
            glob["paused"] = "1"
        for o in OPTIONS:
            value = self.values[o["key"]]
            if value != o["default"]:
                glob[o["key"]] = value
        # « Auto » is target_fps = -1 (the refresh rate); a fixed multiplier
        # drops it, whatever the advanced row still shows.
        if (self.auto_mult or self.adaptive) and self.generate:
            glob["target_fps"] = "auto"
        elif glob.get("target_fps", "").lower() in ("-1", "auto"):
            glob.pop("target_fps")

    def steam_string(self):
        """Equivalent per-game Steam launch options (BDEX_FG_* ... %command%)."""
        e = ["BDEX_FG=1"]
        if self.preset != "auto":
            e.append(f"BDEX_FG_PRESET={self.preset}")
        e.append(f"BDEX_FG_MULTIPLIER={(auto_ceiling() if self.auto_mult or self.adaptive else self.multiplier) if self.generate else 1}")
        if (self.auto_mult or self.adaptive) and self.generate:
            e.append("BDEX_FG_TARGET_FPS=auto")
        if self.adaptive and self.generate:
            e.append("BDEX_FG_ADAPTIVE=1")
        if self.generate:
            e.append(f"BDEX_FG_MODE={self.mode}")
        e.append(f"BDEX_FG_PRESENT_MODE={self.present}")
        if self.low_latency:
            e.append("BDEX_FG_LOW_LATENCY=1")
        if self.upscale and self.render_scale < 100:
            e.append("BDEX_FG_RENDER_SCALE=" + f"{self.render_scale / 100:.3f}".rstrip("0").rstrip("."))
            e.append(f"BDEX_FG_UPSCALE_FILTER={self.filter}")
            if self.sharpness > 0:
                e.append("BDEX_FG_SHARPNESS=" + f"{self.sharpness / 100:.2f}".rstrip("0").rstrip("."))
        if self.hud > 0:
            e.append(f"BDEX_FG_OVERLAY={self.hud}")
        for o in OPTIONS:
            value = self.values[o["key"]]
            if value != o["default"]:
                e.append(f"BDEX_FG_{o['key'].upper()}={shlex.quote(value)}")
        return " ".join(e) + " %command%"


def find_layer():
    """(installed, path) — whether the loader can see the layer manifest."""
    dirs = [
        os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")),
                     "vulkan/implicit_layer.d"),
        "/usr/share/vulkan/implicit_layer.d",
        "/usr/local/share/vulkan/implicit_layer.d",
    ]
    for d in dirs:
        try:
            for f in os.listdir(d):
                if "bdex" in f.lower():
                    return True, os.path.join(d, f)
        except OSError:
            pass
    return False, None


def detect_gpus():
    """GPU names the Vulkan loader sees (best effort, via vulkaninfo)."""
    try:
        out = subprocess.run(["vulkaninfo", "--summary"], capture_output=True, text=True, timeout=8).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    names = []
    for line in out.splitlines():
        s = line.strip()
        if s.startswith("deviceName") and "=" in s:
            name = s.split("=", 1)[1].strip()
            if name and name not in names:
                names.append(name)
    return names


def status_dir():
    """Where the layer publishes one live status file per game (layer/src/status.h)
    and reads this panel's session: in the home, which Steam's container shares
    with Proton games (platformStatusDir)."""
    if "BDEX_FG_STATUS_DIR" in os.environ:
        return os.environ["BDEX_FG_STATUS_DIR"]
    home = os.environ.get("HOME")
    return os.path.join(home, ".cache", "bdex-framegen", "run") if home else f"/tmp/bdex-framegen-{os.getuid()}"


def session_path():
    """The session file the layer reads for require_app (platformAppSession)."""
    return os.path.join(status_dir(), "app.session")


# Game launchers installed as Flatpaks (packaging/linux/flatpak.sh installs the
# layer in their sandbox, which sees neither ~/.config nor ~/.cache).
FLATPAK_APPS = ("com.valvesoftware.Steam", "com.heroicgameslauncher.hgl", "net.lutris.Lutris",
                "com.usebottles.bottles")


# Snaps (Steam's on Ubuntu): their HOME is ~/snap/<name>/current, with the
# layer's manifest in its .local/share.
SNAP_APPS = ("steam",)


FLATPAK_EXTENSION = "org.freedesktop.Platform.VulkanLayer.BdexFramegen"


def flatpak_extension_branch(app, roots=None):
    """The Freedesktop runtime branch of a Flatpak app when the layer's
    extension is installed for it (it then loads the layer without a copy in
    the app's directory; packaging/linux/flatpak.sh), else None."""
    roots = roots or (os.path.expanduser("~/.local/share/flatpak"), "/var/lib/flatpak")
    for root in roots:
        try:
            with open(os.path.join(root, "app", app, "current", "active", "metadata")) as f:
                runtime = next((ln.split("=", 1)[1].strip() for ln in f if ln.startswith("runtime=")), "")
        except OSError:
            continue
        if not runtime.startswith("org.freedesktop.Platform/"):
            return None
        branch = runtime.rsplit("/", 1)[-1]
        arch = os.uname().machine
        if any(os.path.isdir(os.path.join(r, "runtime", FLATPAK_EXTENSION, arch, branch)) for r in roots):
            return branch
        return None
    return None


def sandbox_dirs():
    """(status dir, config file) inside each Flatpak or Snap launcher the layer
    is installed in: the paths a game started there reads."""
    out = []
    for app in FLATPAK_APPS:
        d = os.path.expanduser(f"~/.var/app/{app}")
        if os.path.isfile(os.path.join(d, "data/vulkan/implicit_layer.d/VK_LAYER_BDEX_framegen.json")) or \
                (os.path.isdir(d) and flatpak_extension_branch(app)):
            out.append((os.path.join(d, ".cache", "bdex-framegen", "run"), os.path.join(d, "config", "bdex-framegen.conf")))
    for app in SNAP_APPS:
        d = os.path.expanduser(f"~/snap/{app}/current")
        if os.path.isfile(os.path.join(d, ".local/share/vulkan/implicit_layer.d/VK_LAYER_BDEX_framegen.json")):
            out.append((os.path.join(d, ".cache", "bdex-framegen", "run"), os.path.join(d, ".config", "bdex-framegen.conf")))
    return out


def refresh_sandboxes():
    """Re-copies the layer into the Flatpak / Snap launchers whose copy an
    update left behind (a distribution package cannot write in the home):
    [names refreshed]. The copy goes through a new file, so running games keep
    the library they mapped."""
    here = os.path.dirname(os.path.realpath(__file__))
    prefix = os.path.normpath(os.path.join(here, ".."))
    for script in (os.path.join(prefix, "share", "bdex-framegen", "flatpak.sh"),
                   os.path.join(prefix, "packaging", "linux", "flatpak.sh")):
        if os.path.isfile(script):
            break
    else:
        return []
    try:
        out = subprocess.run(["bash", script, "--check", prefix], capture_output=True, text=True,
                             timeout=20).stdout
        stale = sorted({line.split(" ", 1)[0] for line in out.splitlines() if line.strip()})
        if stale:
            subprocess.run(["bash", script, prefix], capture_output=True, timeout=60, check=True)
        return stale
    except (OSError, subprocess.SubprocessError):
        return []


def proc_env(pid):
    """A process's environment (as it started)."""
    try:
        with open(f"/proc/{pid}/environ", "rb") as f:
            raw = f.read()
    except OSError:
        return {}
    env = {}
    for kv in raw.split(b"\0"):
        k, sep, v = kv.partition(b"=")
        if sep:
            env[k.decode(errors="replace")] = v.decode(errors="replace")
    return env


def inner_pid(pid):
    """A game's pid in its own pid namespace — a Flatpak app has one: the
    number the layer knows itself by (platformPid) and matches the session's
    target with."""
    try:
        with open(f"/proc/{pid}/status") as f:
            for line in f:
                if line.startswith("NSpid:"):
                    return int(line.split()[-1])
    except (OSError, ValueError, IndexError):
        pass
    return pid


def game_paths(pid):
    """(status dir, config file) of a running game as this panel reaches them:
    the paths of the game's own environment (a Flatpak app has its own HOME,
    XDG_CONFIG_HOME...), through /proc/<pid>/root, its view of the files. The
    same files as status_dir() / CONFIG_PATH for a game outside any sandbox."""
    env = proc_env(pid)
    home = env.get("HOME", "")
    sdir = env.get("BDEX_FG_STATUS_DIR") or (
        os.path.join(home, ".cache", "bdex-framegen", "run") if home else f"/tmp/bdex-framegen-{os.getuid()}")
    cfg = env.get("BDEX_FG_CONFIG") or os.path.join(
        env.get("XDG_CONFIG_HOME") or os.path.join(home, ".config"), "bdex-framegen.conf")
    root = f"/proc/{pid}/root"
    return root + sdir, root + cfg


def same_file(a, b):
    try:
        return os.path.samefile(a, b)
    except OSError:
        return os.path.abspath(a) == os.path.abspath(b)


def display_hz():
    """The highest refresh rate among the monitors (GDK reads it from the
    compositor / X server): the layer's target for « Auto » when it cannot
    measure the display itself (no present feedback, KDE + NVIDIA...)."""
    if HAVE_GTK:
        try:
            monitors = Gdk.Display.get_default().get_monitors()
            rates = [monitors.get_item(i).get_refresh_rate() for i in range(monitors.get_n_items())]
            return max(rates) / 1000.0 if rates else 0.0
        except Exception:  # no display, old GDK
            return 0.0
    # Text mode: the compositor's own tool first — under Wayland xrandr only
    # sees Xwayland's outputs (a made-up mode, or nothing) — then xrandr.
    return max(text_mode_rates(), default=0.0)


def _run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=4).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def rates_hyprctl(out):
    """`hyprctl monitors -j`: the current refresh rate of each monitor."""
    try:
        return [float(m["refreshRate"]) for m in json.loads(out) if not m.get("disabled")]
    except (ValueError, TypeError, KeyError):
        return []


def rates_kscreen(out):
    """`kscreen-doctor -j` (KDE): each enabled output's current mode."""
    try:
        rates = []
        for o in json.loads(out).get("outputs", []):
            if not o.get("enabled", True):
                continue
            for m in o.get("modes", []):
                if str(m.get("id")) == str(o.get("currentModeId")):
                    rates.append(float(m["refreshRate"]))
        return rates
    except (ValueError, TypeError, KeyError, AttributeError):
        return []


def rates_wlr(out):
    """`wlr-randr --json` (sway, river, Wayfire, labwc...): Hz of the current modes."""
    try:
        return [float(m["refresh"]) for o in json.loads(out) if o.get("enabled", True)
                for m in o.get("modes", []) if m.get("current")]
    except (ValueError, TypeError, KeyError, AttributeError):
        return []


def rates_mutter(out):
    """GNOME's DisplayConfig.GetCurrentState (as gdbus prints it): modes are
    ('1920x1080@143.998', 1920, 1080, 143.998..., ...{'is-current': <true>...})."""
    rates = []
    marks = [m for m in re.finditer(r"\('\d+x\d+@[\d.]+', \d+, \d+, ([\d.]+)", out)]
    for i, m in enumerate(marks):
        end = marks[i + 1].start() if i + 1 < len(marks) else len(out)
        if "'is-current': <true>" in out[m.end():end]:
            rates.append(float(m.group(1)))
    return rates


def rates_xrandr(out):
    """`xrandr --current`: the starred (current) mode of each output."""
    rates = []
    for line in out.splitlines():
        for tok in line.split()[1:]:
            if "*" in tok:
                try:
                    rates.append(float(tok.replace("*", "").replace("+", "")))
                except ValueError:
                    pass
    return rates


def text_mode_rates():
    if os.environ.get("WAYLAND_DISPLAY"):
        probes = []
        if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            probes.append((["hyprctl", "monitors", "-j"], rates_hyprctl))
        # (kscreen-doctor only answers in a Plasma session: elsewhere it waits.)
        if "KDE" in os.environ.get("XDG_CURRENT_DESKTOP", "") or os.environ.get("KDE_FULL_SESSION"):
            probes.append((["kscreen-doctor", "-j"], rates_kscreen))
        probes += [
                   (["wlr-randr", "--json"], rates_wlr),
                   (["gdbus", "call", "--session", "--dest", "org.gnome.Mutter.DisplayConfig",
                     "--object-path", "/org/gnome/Mutter/DisplayConfig",
                     "--method", "org.gnome.Mutter.DisplayConfig.GetCurrentState"], rates_mutter)]
        for cmd, parse in probes:
            if shutil.which(cmd[0]):
                rates = parse(_run(cmd))
                if rates:
                    return rates
    return rates_xrandr(_run(["xrandr", "--current"]))


def auto_ceiling():
    """The multiplier ceiling of « Auto » / « Adaptatif »: enough frames to
    fill the screen from ~40 fps (x4 up to 165 Hz, x6 up to 250 Hz, x8
    above), without allocating the output images of x8 for a 60 Hz screen."""
    hz = display_hz()
    return 4 if hz <= 165 else 6 if hz <= 250 else 8


def session_dirs():
    """Every status directory a game may read the session from: this user's,
    and the one inside each Flatpak or Snap launcher (its sandbox home is its
    app directory), so that a game started there sees the panel open."""
    return [status_dir()] + [run for run, _ in sandbox_dirs()]


def write_session(target=0):
    """"<panel pid> <target pid> <refresh Hz>": the panel is open; `target` (a
    host pid) generates frames. Written into every directory a game reads it
    from, the target's pid as the game knows itself (inner_pid). Rewritten
    every second: the layer takes an older file for a closed panel."""
    hz = display_hz()
    tdir = game_paths(target)[0] if target else None
    dirs = session_dirs()
    if tdir and not any(same_file(tdir, d) for d in dirs if os.path.isdir(d)):
        dirs.append(tdir)
    for i, d in enumerate(dirs):
        try:
            os.makedirs(d, mode=0o700, exist_ok=True)
            mine = target and tdir and same_file(tdir, d)
            path = os.path.join(d, "app.session")
            with open(path + ".tmp", "w") as f:
                f.write(f"{os.getpid()} {inner_pid(target) if mine else 0} {hz:.3f}\n")
            os.replace(path + ".tmp", path)
        except OSError:
            if i == 0:
                raise  # this user's own directory must work


def remove_session():
    dirs = session_dirs()
    for d in dirs:
        path = os.path.join(d, "app.session")
        try:
            with open(path) as f:
                if int(f.read().split()[0]) != os.getpid():
                    continue  # another panel owns it
            os.remove(path)
        except (OSError, ValueError, IndexError):
            pass


def read_running(keep=()):
    """Live status of the running games: [(pid, process, [entry dict, ...])]; stale files skipped
    (and removed — unless their pid is in `keep`: a game in a pid namespace of
    its own, whose number means another process here)."""
    out = []
    try:
        names = sorted(os.listdir(status_dir()))
    except OSError:
        return out
    for name in names:
        if not name.endswith(".status"):
            continue
        path = os.path.join(status_dir(), name)
        try:
            text = open(path, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        head, entries, cur = {}, [], None
        for line in text.splitlines():
            line = line.strip()
            if line.startswith("[") and line.endswith("]"):
                cur = {"kind": line[1:-1].split()[0]}
                entries.append(cur)
            elif "=" in line:
                k, _, v = line.partition("=")
                (cur if cur is not None else head)[k] = v
        try:
            pid = int(head.get("pid", "0"))
            if pid not in keep:
                os.kill(pid, 0)  # still running?
        except (ValueError, ProcessLookupError, PermissionError):
            try:
                os.unlink(path)  # left behind by a crashed game
            except OSError:
                pass
            continue
        out.append((pid, head.get("process", "?"), entries))
    return out


def read_status(pid):
    """The live status entries of a detected game, from the directory and
    under the pid it knows (a Flatpak game: its own)."""
    path = os.path.join(game_paths(pid)[0], f"{inner_pid(pid)}.status")
    try:
        text = open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return []
    entries, cur = [], None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("[") and line.endswith("]"):
            cur = {"kind": line[1:-1].split()[0]}
            entries.append(cur)
        elif "=" in line and cur is not None:
            k, _, v = line.partition("=")
            cur[k] = v
    return entries


def mirror_config():
    """Copies the settings file where sandboxed games read theirs: each
    Flatpak or Snap launcher's config directory, and any running game whose config
    path is another file (its own XDG_CONFIG_HOME, BDEX_FG_CONFIG)."""
    try:
        with open(CONFIG_PATH, "rb") as f:
            data = f.read()
    except OSError:
        return
    targets = [cfg for _, cfg in sandbox_dirs()]
    for pid, _name in detect_games():
        cfg = game_paths(pid)[1]
        if not same_file(cfg, CONFIG_PATH):
            targets.append(cfg)
    for path in targets:
        if os.path.exists(path) and same_file(path, CONFIG_PATH):
            continue
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path + ".tmp", "wb") as f:
                f.write(data)
            os.replace(path + ".tmp", path)
        except OSError:
            pass


# Vulkan programs that are not games: the layer loads into them too (keep in
# sync with platformIsNonGame in layer/src/platform.cpp).
NOT_GAMES = {"steam", "steamwebhelper", "gamescope", "gamescopereaper", "gamescope-wl", "mangoapp",
             "steam-runtime-check-requirements", "chrome", "chromium",
             "firefox", "librewolf", "brave", "zen", "electron", "discord", "vesktop", "code",
             "obs", "vulkaninfo", "vkcube", "bdex-framegen-gui"}


def layer_name(arg):
    """A process's name as the layer matches [sections] (normalizeName in platform.cpp)."""
    base = arg.replace("\\", "/").rsplit("/", 1)[-1].strip().lower()
    return base.split(".", 1)[0]


def detect_games():
    """Running programs the layer is loaded into — every Vulkan program, native or
    through Proton (DXVK / VKD3D) — minus known non-games and GTK 4 applications
    (drawn with Vulkan; platformIsDesktopApp): [(pid, name)]."""
    out, me = [], os.getpid()
    for p in os.listdir("/proc"):
        if not p.isdigit() or int(p) == me:
            continue
        try:
            with open(f"/proc/{p}/maps", "rb") as f:
                maps = f.read()
            if b"libVkLayer_bdex_framegen" not in maps or b"libgtk-4.so" in maps:
                continue
            with open(f"/proc/{p}/cmdline", "rb") as f:
                args = [a.decode(errors="replace") for a in f.read().split(b"\0") if a.strip()]
        except OSError:
            continue
        if not args:
            continue
        exe = [a for a in args if a.lower().endswith(".exe")]  # Proton: the game's .exe
        first = args[0]
        if " " in first and not os.path.exists(first):
            first = first.split(" ", 1)[0]   # Electron & co. rewrite argv as one string
        name = layer_name(exe[0] if exe else first)
        try:
            args.append(os.readlink(f"/proc/{p}/exe"))   # the binary, for NOT_GAMES
        except OSError:
            pass
        if name and not NOT_GAMES & ({layer_name(a) for a in args[:2] + args[-1:]} | {name}):
            out.append((int(p), name))
    return out


def describe_entry(e):
    """One line of French for a status entry."""
    if e.get("kind") == "device":
        if e.get("state") == "active":
            return None
        return f"Couche inactive : {e.get('reason', e.get('state', ''))}"
    state = e.get("state", "")
    if state == "ready":
        return "Prêt — sélectionne-le puis « Démarrer »"
    if state == "pass-through":
        return f"Transparente — {e.get('reason', 'raison inconnue')}"
    parts = []
    try:
        game, outp = float(e.get("game_fps", 0)), float(e.get("output_fps", 0))
        parts.append(f"{game:.0f} → {outp:.0f} i/s (×{e.get('multiplier', '?')}, "
                     f"{ {'extrapolate': 'extrapolation', 'hybrid': 'hybride'}.get(e.get('mode'), 'interpolation')})")
        hz, limit = float(e.get("refresh_hz", 0)), float(e.get("limit_hz", 0))
        if limit > 0:   # Steam's framerate limit (gamescope): nothing past it is shown
            parts.append(f"limite Steam {limit:.0f} i/s (rien au-delà ne s'affiche)")
        elif hz > 0:
            parts.append(f"écran {hz:.0f} Hz")
        lat = float(e.get("latency_ms", -1))
        if lat >= 0:
            parts.append(f"latence {lat:.0f} ms")
        lvl = int(e.get("gpu_budget_level", 0))
        if lvl > 0:
            parts.append(f"budget GPU : niveau {lvl}")
        if e.get("reason") == "fast":   # skip_fast
            parts.append("génération inutile : le jeu tient déjà la fréquence de l'écran")
    except ValueError:
        pass
    prefix = "En pause — " if state == "paused" else ""
    lines = [prefix + " · ".join(parts)]
    if e.get("passes"):
        lines.append("Passes : " + e["passes"].replace(",", ", "))
    if e.get("online_tune"):
        tune = e["online_tune"]
        if tune.startswith("trying "):
            tune = "essai de " + tune[len("trying "):].replace(" decided)", " décidées)").replace(" of ", " sur ")
        else:
            tune = tune.replace(" kept", " gardée").replace(" dropped", " écartée").replace("flow change", "variation du flux")
        lines.append("Réglage auto : " + tune)
    return "\n".join(lines)


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="bdex-framegen")
        self.set_default_size(600, 860)
        self.cfg = ConfigFile.load()
        self.opt = Options()
        self.opt.load_from(self.cfg.glob)
        self._loading = True   # suppress auto-save while building/populating

        self.toasts = Adw.ToastOverlay()
        self.set_content(self.toasts)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.toasts.set_child(box)

        header = Adw.HeaderBar()
        title = Adw.WindowTitle(title="bdex-framegen", subtitle="Génération d'images")
        header.set_title_widget(title)
        menu = Gtk.Button(icon_name="edit-copy-symbolic",
                          tooltip_text="Copier les options de lancement Steam équivalentes (par jeu)")
        menu.connect("clicked", self.on_copy)
        header.pack_end(menu)
        if HAVE_ADW:
            box.append(header)
        else:
            self.set_titlebar(header)

        # No horizontal scrolling: long texts wrap to the window's width.
        scroller = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        box.append(scroller)
        page = Adw.PreferencesPage()
        scroller.set_child(page)

        self._build_session(page)
        self._build_without_panel(page)
        self._build_status(page)
        self._build_running(page)
        self._build_framegen(page)
        self._build_hud(page)
        self._build_upscale(page)
        self._build_present(page)
        self._build_advanced(page)

        self._loading = False
        self.refresh_sensitivity()
        # Every game armed, the session decides (require_app): written once.
        if self.cfg.glob.get("require_app") != "1" or self.cfg.glob.get("enabled") != "1":
            self.save()
        self.target = None     # (pid, name) where « Démarrer » started the generation
        self.selected = None   # (pid, name) chosen in « Jeux détectés »
        try:
            write_session(0)   # open: upscaling applies to games started from now
        except OSError as e:
            self.toast(f"Session impossible : {e}")
        self._refresh_running()
        GLib.timeout_add_seconds(1, self._beat)
        GLib.idle_add(self._refresh_sandboxes)
        self.connect("close-request", self._on_close)

    def _refresh_sandboxes(self):
        apps = refresh_sandboxes()
        if apps:
            self.toast("Couche mise à jour dans : " + ", ".join(a.replace("snap:", "Snap ") for a in apps))
        return False

    def _beat(self):
        try:
            write_session(self.target[0] if self.target else 0)
        except OSError:
            pass
        return True

    def _on_close(self, *_):
        remove_session()       # the targeted game stops generating
        return False

