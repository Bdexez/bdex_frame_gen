    def sync(self):
        o = self.opt
        o.generate = self.gen_row.get_active()
        o.preset = PRESETS[self.preset_row.get_selected()][1]
        o.auto_mult = self.mult_row.get_selected() == 0
        o.adaptive = self.mult_row.get_selected() == 1
        if not o.auto_mult and not o.adaptive:
            o.multiplier = self.mult_row.get_selected()
        o.mode = MODES[self.mode_row.get_selected()][1]
        o.upscale = self.up_row.get_active()
        o.render_scale = int(self.scale_row.get_value())
        o.filter = FILTERS[self.filter_row.get_selected()][1]
        o.sharpness = int(self.sharp_row.get_value())
        o.present = PRESENT[self.present_row.get_selected()][1]
        o.low_latency = self.ll_row.get_active()
        o.hud = HUD_MODES[self.hud_row.get_selected()][1]
        o.paused = self.pause_row.get_active()
        o.without_panel = self.always_all_row.get_active()
        for key, (spec, row) in self.opt_rows.items():
            if spec["kind"] == "spin":
                v = row.get_value()
                o.values[key] = "auto" if spec["lower"] < 0 and v < 0 else _fmt_num(v, spec["digits"])
            elif spec["kind"] == "switch":
                o.values[key] = "1" if row.get_active() else "0"
            elif spec["kind"] == "choice":
                o.values[key] = spec["choices"][row.get_selected()][1]
            else:
                o.values[key] = row.get_text().strip()

    def refresh_sensitivity(self):
        o = self.opt
        for r in (self.preset_row, self.mult_row, self.mode_row):
            r.set_sensitive(o.generate)
        for r in (self.scale_row, self.filter_row, self.sharp_row):
            r.set_sensitive(o.upscale)
        for exp, needs_gen in self.section_rows.values():
            exp.set_sensitive(o.generate or not needs_gen)
        self.pause_row.set_sensitive(o.generate)

    def on_change(self, *_):
        if self._loading:
            return
        self.sync()
        self.refresh_sensitivity()
        self.save()
        self._refresh_session()   # « Tous les jeux » (sans le panneau) changes what « Démarrer » means

    def save(self):
        # Re-read first: lines edited by hand while the panel is open
        # ([game] sections, unmanaged keys) must survive its next save.
        self.cfg = ConfigFile.load()
        self.opt.write_into(self.cfg.glob)
        try:
            self.cfg.write()
        except OSError as e:
            self.toast(f"Échec de l'enregistrement : {e}")
            return
        mirror_config()   # sandboxed games (Flatpak Steam...) read their own copy

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast.new(text))

    # -- header actions ----------------------------------------------------

    def on_copy(self, _btn):
        self.sync()
        Gdk.Display.get_default().get_clipboard().set(self.opt.steam_string())
        self.toast("Options Steam (équivalent par jeu) copiées.")

    def on_install(self, btn):
        here = os.path.dirname(os.path.abspath(__file__))
        script = os.path.join(here, "install.sh")
        if not os.path.exists(script):
            self.toast("tools/install.sh introuvable.")
            return
        btn.set_sensitive(False)
        btn.set_label("Installation…")
        self.toast("Installation de la couche… (compilation, quelques instants)")

        def run():
            try:
                p = subprocess.run(["bash", script], capture_output=True, text=True, timeout=900)
                ok, msg = p.returncode == 0, (p.stderr.strip().splitlines() or [""])[-1]
            except (OSError, subprocess.SubprocessError) as e:
                ok, msg = False, str(e)
            GLib.idle_add(self._install_done, btn, ok, msg)

        threading.Thread(target=run, daemon=True).start()

    def _install_done(self, btn, ok, msg):
        if ok:
            self.status_row.set_subtitle("Installée — chargée automatiquement dans tous les jeux Vulkan")
            self.status_row.remove(btn)
            self.toast("Couche installée. Lance ton jeu — c'est actif.")
        else:
            btn.set_sensitive(True)
            btn.set_label("Réessayer")
            self.toast(f"Échec de l'installation : {msg}")
        return False


