def _text_options(opt):
    mult = ("adaptatif" if opt.adaptive else "Auto" if opt.auto_mult else f"×{opt.multiplier}") \
        if opt.generate else "désactivé"
    mode = {m: lab.split(" —")[0].split(" (")[0] for lab, m in MODES}.get(opt.mode, opt.mode)
    hud = dict((v, lab) for lab, v in HUD_MODES).get(opt.hud, str(opt.hud))
    return (f"multiplicateur {mult} · mode {mode} · préréglage {opt.preset} · compteur {hud}"
            + (" · mode Jeu : tous les jeux sans le panneau" if opt.without_panel else ""))


def _text_pick(title, table, current):
    print(title)
    for i, (label, value) in enumerate(table, 1):
        print(f"  {i}) {label}{'   ← actuel' if value == current else ''}")
    try:
        answer = input("Choix (Entrée : inchangé) : ").strip()
    except EOFError:
        return current
    if answer.isdigit() and 1 <= int(answer) <= len(table):
        return table[int(answer) - 1][1]
    return current


# Terminal emulators and how each takes a command (argv after the prefix):
# xdg-terminal-exec (the freedesktop default terminal, Fedora / GNOME 47+),
# Debian's alternative, then the desktops' own, then the standalone ones.
TERMINALS = (["xdg-terminal-exec"], ["x-terminal-emulator", "-e"], ["ptyxis", "--"], ["kgx", "--"],
             ["gnome-terminal", "--"], ["konsole", "-e"], ["xfce4-terminal", "-x"], ["mate-terminal", "-x"],
             ["lxterminal", "-e"], ["qterminal", "-e"], ["terminator", "-x"], ["foot"], ["kitty"],
             ["alacritty", "-e"], ["wezterm", "start", "--"], ["xterm", "-e"])


def terminal_commands(env=None):
    """The terminals to try, in order: $TERMINAL (the user's choice, with
    -e as most take it) first."""
    env = os.environ if env is None else env
    out = []
    user = env.get("TERMINAL", "").strip()
    if user:
        known = next((t for t in TERMINALS if t[0] == os.path.basename(user)), None)
        out.append([user] + (known[1:] if known else ["-e"]))
    return out + [list(t) for t in TERMINALS]


def text_main():
    if not sys.stdin.isatty() and "--in-terminal" not in sys.argv[1:] and \
            (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        # Started from the application menu: the text mode in a terminal.
        me = os.path.realpath(__file__)
        for term in terminal_commands():
            if not shutil.which(term[0]):
                continue
            try:
                os.execvp(term[0], term + [sys.executable, me, "--text", "--in-terminal"])
            except OSError:
                continue
    if not sys.stdin.isatty():
        sys.stderr.write("bdex-framegen-gui: GTK 4 (PyGObject) is not installed; run it in a terminal for "
                         "the text mode, or use bdex-framegen (--help)\n")
        return 1
    cfg = ConfigFile.load()
    opt = Options()
    opt.load_from(cfg.glob)
    state = {"target": None}
    stop = threading.Event()

    def save():
        opt.write_into(cfg.glob)
        cfg.write()
        mirror_config()

    def beat():
        while not stop.wait(1.0):
            try:
                write_session(state["target"][0] if state["target"] else 0)
            except OSError:
                pass

    if cfg.glob.get("require_app") != "1" or cfg.glob.get("enabled") != "1":
        save()
    for app in refresh_sandboxes():
        print(f"Couche mise à jour dans {app.replace('snap:', 'Snap ')} (copie d'une version précédente)")
    try:
        write_session(0)
    except OSError as e:
        print(f"Session impossible : {e}")
        return 1
    threading.Thread(target=beat, daemon=True).start()
    installed, _ = find_layer()
    print("bdex-framegen — panneau en mode texte" + ("" if HAVE_GTK else " (GTK 4 absent)"))
    if not installed:
        print("  La couche n'est pas installée pour ce compte (install.sh, ou le paquet de la distribution).")
    print("  Lance le jeu normalement, puis choisis-le ici. Tant que ce panneau est ouvert,")
    print("  le jeu choisi génère des images ; le fermer (q, Ctrl+C) arrête.")
    try:
        while True:
            games = detect_games()
            if state["target"] and state["target"][0] not in [pid for pid, _ in games]:
                state["target"] = None
            print()
            print("Jeux détectés :" if games else "Jeux détectés : aucun (lance un jeu Vulkan, puis r)")
            for i, (pid, name) in enumerate(games, 1):
                mark = "  ▶ génère" if state["target"] and state["target"][0] == pid else ""
                lines = [d for d in (describe_entry(e) for e in read_status(pid)) if d]
                print(f"  {i}) {name} (pid {pid}){mark}")
                for d in lines:
                    for ln in d.splitlines():
                        print(f"       {ln}")
            print("Options : " + _text_options(opt))
            print("[numéro] démarrer dans ce jeu · a arrêter · r actualiser · m multiplicateur · "
                  "o mode · p préréglage · h compteur · j mode Jeu · s options Steam · q quitter")
            try:
                cmd = input("> ").strip().lower()
            except EOFError:
                break
            if cmd == "q":
                break
            if cmd.isdigit() and 1 <= int(cmd) <= len(games):
                state["target"] = games[int(cmd) - 1]
                write_session(state["target"][0])
                print(f"Génération démarrée dans {state['target'][1]}.")
            elif cmd == "a":
                state["target"] = None
                write_session(0)
            elif cmd == "m":
                table = [("Désactivé (×1)", "1"), ("Auto — jusqu'à la fréquence de l'écran", "auto"),
                         ("Adaptatif — toute la fréquence, rapports fractionnaires", "adaptive")] + \
                        [(f"×{n}", str(n)) for n in range(2, 9)]
                cur = "1" if not opt.generate else "adaptive" if opt.adaptive else \
                      "auto" if opt.auto_mult else str(opt.multiplier)
                v = _text_pick("Multiplicateur :", table, cur)
                opt.generate = v != "1"
                opt.adaptive = v == "adaptive"
                opt.auto_mult = v == "auto"
                if v.isdigit() and v != "1":
                    opt.multiplier = int(v)
                save()
            elif cmd == "o":
                opt.mode = _text_pick("Mode :", MODES, opt.mode)
                save()
            elif cmd == "p":
                opt.preset = _text_pick("Préréglage :", PRESETS, opt.preset)
                save()
            elif cmd == "h":
                opt.hud = _text_pick("Compteur à l'écran :", HUD_MODES, opt.hud)
                save()
            elif cmd == "j":
                opt.without_panel = _text_pick(
                    "Mode Jeu (Steam Deck) — tous les jeux génèrent dès leur lancement, sans le panneau :",
                    [("Non — le panneau décide (« Démarrer »)", False), ("Oui", True)], opt.without_panel)
                save()
            elif cmd == "s":
                print("Options de lancement Steam équivalentes (par jeu) :")
                print("  " + opt.steam_string())
    except KeyboardInterrupt:
        print()
    finally:
        stop.set()
        remove_session()
    return 0


if __name__ == "__main__":
    if not HAVE_GTK or "--text" in sys.argv[1:]:
        sys.exit(text_main())
    sys.exit(App().run(sys.argv))
