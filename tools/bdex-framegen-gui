_EN_PATTERNS = [(re.compile("^" + "(.*?)".join(re.escape(p) for p in fr.split("{}")) + "$", re.S), en)
                for fr, en in _EN.items() if "{}" in fr]


def tr(text):
    """`text` (French) in the panel's language."""
    if FRENCH:
        return text
    en = _EN.get(text)
    if en is not None:
        return en
    for pattern, en in _EN_PATTERNS:
        m = pattern.match(text)
        if m:
            parts = en.split("{}")
            return parts[0] + "".join(g + p for g, p in zip(m.groups(), parts[1:]))
    return text

