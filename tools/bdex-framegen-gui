    mult = (tr("adaptatif") if opt.adaptive else "Auto" if opt.auto_mult else f"×{opt.multiplier}") \
        if opt.generate else tr("désactivé")
    mode = {m: lab.split(" —")[0].split(" (")[0] for lab, m in MODES}.get(opt.mode, opt.mode)
    hud = dict((v, lab) for lab, v in HUD_MODES).get(opt.hud, str(opt.hud))
    return (tr(f"multiplicateur {mult} · mode {mode} · préréglage {opt.preset} · compteur {hud}")
            + (tr(" · mode Jeu : tous les jeux sans le panneau") if opt.without_panel else ""))


def _text_pick(title, table, current):
    print(title)
    for i, (label, value) in enumerate(table, 1):
        print(f"  {i}) {label}{tr('   ← actuel') if value == current else ''}")
    try:
        answer = input(tr("Choix (Entrée : inchangé) : ")).strip()
    except EOFError:
        return current
    if answer.isdigit() and 1 <= int(answer) <= len(table):
        return table[int(answer) - 1][1]
    return current


# Terminal emulators and how each takes a command (argv after the prefix):
# xdg-terminal-exec (the freedesktop default terminal, Fedora / GNOME 47+),
# Debian's alternative, then the desktops' own, then the standalone ones.
TERMINALS = (["xdg-terminal-exec"], ["x-terminal-emulator", "-e"], ["ptyxis", "--"], ["kgx", "--"],
             ["gnome-terminal", "--"], ["konsole", "-e"], ["xfce4-terminal", "-x"], ["mate-terminal", "-x"],
             ["lxterminal", "-e"], ["qterminal", "-e"], ["terminator", "-x"], ["foot"], ["kitty"],
             ["alacritty", "-e"], ["wezterm", "start", "--"], ["xterm", "-e"])


def terminal_commands(env=None):
    """The terminals to try, in order: $TERMINAL (the user's choice, with
    -e as most take it) first."""
    env = os.environ if env is None else env
    out = []
    user = env.get("TERMINAL", "").strip()
    if user:
        known = next((t for t in TERMINALS if t[0] == os.path.basename(user)), None)
        out.append([user] + (known[1:] if known else ["-e"]))
    return out + [list(t) for t in TERMINALS]


def text_main():
    if not sys.stdin.isatty() and "--in-terminal" not in sys.argv[1:] and \
            (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        # Started from the application menu: the text mode in a terminal.
        me = os.path.realpath(__file__)
        for term in terminal_commands():
            if not shutil.which(term[0]):
                continue
            try:
                os.execvp(term[0], term + [sys.executable, me, "--text", "--in-terminal"])
            except OSError:
                continue
    if not sys.stdin.isatty():
        sys.stderr.write("bdex-framegen-gui: GTK 4 (PyGObject) is not installed; run it in a terminal for "
                         "the text mode, or use bdex-framegen (--help)\n")
        return 1
    cfg = ConfigFile.load()
    opt = Options()
    opt.load_from(cfg.glob)
    state = {"target": None, "how": None, "proc": None}
    stop = threading.Event()

    def save():
        opt.write_into(cfg.glob)
        cfg.write()
        mirror_config()

    def beat():
        while not stop.wait(1.0):
            try:
                layer = state["target"] and state["how"] and state["how"][0] == "layer"
                write_session(state["target"][0] if layer else 0)
            except OSError:
                pass

    def start(target, pick=False):
        """Injection or capture for `target` (plan()), as the window's « Démarrer »."""
        stop_capture(state["proc"])
        state["proc"] = None
        how = ("capture", tr("capture (fenêtre choisie)")) if pick else \
            plan(read_status(target[0]), opt, capture_binary() is not None)
        if not pick:
            ac = game_anticheat(target[0], read_status(target[0]))
            if ac:
                print(anticheat_warning(target[1], ac, how[0]))
        try:
            write_session(target[0] if how[0] == "layer" else 0)
            if how[0] == "capture":
                state["proc"] = start_capture(0 if pick else inner_pid(target[0]), opt.gpu)
        except OSError as e:
            print(tr(f"Échec : {e}"))
            state["target"], state["how"] = None, None
            return
        state["target"], state["how"] = target, how
        print(tr(f"Génération démarrée dans {target[1]}.") + f" ({how[1]})")

    if cfg.glob.get("require_app") != "1" or cfg.glob.get("enabled") != "1":
        save()
    for app in refresh_sandboxes():
        print(tr(f"Couche mise à jour dans {app.replace('snap:', 'Snap ')} (copie d'une version précédente)"))
    try:
        write_session(0)
    except OSError as e:
        print(tr(f"Session impossible : {e}"))
        return 1
    threading.Thread(target=beat, daemon=True).start()
    installed, _ = find_layer()
    print(tr("bdex-framegen — panneau en mode texte") + ("" if HAVE_GTK else tr(" (GTK 4 absent)")))
    if not installed:
        print(tr("  La couche n'est pas installée pour ce compte (install.sh, ou le paquet de la distribution)."))
    print(tr("  Lance le jeu normalement, puis choisis-le ici. Tant que ce panneau est ouvert,"))
    print(tr("  le jeu choisi génère des images ; le fermer (q, Ctrl+C) arrête."))
    try:
        while True:
            games = detect_games()
            if state["proc"] is not None and state["proc"].poll() is not None:
                state["proc"], state["target"], state["how"] = None, None, None
                print(tr("Capture terminée (journal : ~/.cache/bdex-framegen/capture.log)"))
            if state["target"] and state["target"][0] and state["target"][0] not in [pid for pid, _ in games]:
                stop_capture(state["proc"])
                state["proc"], state["target"], state["how"] = None, None, None
            print()
            print(tr("Jeux détectés :") if games else tr("Jeux détectés : aucun (lance un jeu Vulkan, puis r)"))
            for i, (pid, name) in enumerate(games, 1):
                mark = tr("  ▶ génère") if state["target"] and state["target"][0] == pid else ""
                entries = read_status(pid)
                lines = [d for d in (describe_entry(e) for e in entries) if d]
                lines.append("→ " + plan(entries, opt, capture_binary() is not None)[1])
                print(f"  {i}) {name} (pid {pid}){mark}")
                for d in lines:
                    for ln in d.splitlines():
                        print(f"       {ln}")
            print(tr("Options : ") + _text_options(opt))
            print(tr("[numéro] démarrer dans ce jeu · a arrêter · r actualiser · m multiplicateur · "
                  "o mode · p préréglage · h compteur · j mode Jeu · s options Steam · b signaler un problème · q quitter"))
            print(tr("w capturer une autre fenêtre · c méthode · g GPU de génération · e enregistrer (corpus)"))
            print(tr("k calibrer le GPU") + (tr(" · y fenêtre Wayland (portail)") if capture_wayland_available() else ""))
            try:
                cmd = input("> ").strip().lower()
            except EOFError:
                break
            if cmd == "q":
                break
            if cmd.isdigit() and 1 <= int(cmd) <= len(games):
                save()
                start(games[int(cmd) - 1])
            elif cmd == "w":
                save()
                start((0, tr("fenêtre choisie")), pick=True)
                print(tr("Clique sur la fenêtre du jeu"))
            elif cmd == "y" and capture_wayland_available():
                save()
                stop_capture(state["proc"])
                try:
                    state["proc"] = start_capture(0, opt.gpu, wayland=True)
                    state["target"], state["how"] = (0, tr("fenêtre Wayland")), ("capture", tr("capture (fenêtre choisie)"))
                    print(tr("Choisis la fenêtre du jeu dans la fenêtre du bureau"))
                except OSError as e:
                    print(tr(f"Échec : {e}"))
            elif cmd == "e":
                armed = [(n, (p, n)) for p, n in games if any(e.get("kind") == "swapchain" for e in read_status(p))]
                if not armed:
                    print(tr("Aucun jeu armé par la couche à enregistrer."))
                    continue
                game = _text_pick(tr("Jeu à enregistrer :"), armed, armed[0][1])
                try:
                    src = request_recording(*game)
                except OSError as e:
                    print(tr(f"Enregistrement impossible : {e}"))
                    continue
                print(tr(f"Enregistrement de {game[1]}… (le jeu peut ralentir quelques secondes)"))
                for _ in range(120):
                    if os.path.isfile(os.path.join(src, "DONE")):
                        print(tr(f"Enregistrement prêt : {finish_recording(src)}"))
                        break
                    time.sleep(1)
                else:
                    print(tr("L'enregistrement n'a pas abouti (le jeu est-il armé ?)"))
            elif cmd == "k":
                print(tr("Mesure en cours… (quelques secondes)"))
                d = run_calibration()
                if not d:
                    print(tr("La mesure a échoué") if calibrate_binary() else tr("bdex-calibrate absent"))
                    continue
                print(calibration_summary(d))
                if input(tr("Appliquer ? (o/n) ")).strip().lower() in ("o", "y", "oui", "yes"):
                    opt.preset = d["recommended"]["preset"]
                    opt.generate = True
                    if not (opt.auto_mult or opt.adaptive):
                        opt.multiplier = int(d["recommended"]["multiplier"])
                    save()
            elif cmd == "c":
                opt.method = _text_pick(tr("Méthode :"), METHODS, opt.method)
                save()
            elif cmd == "g":
                gpus = generation_gpus()
                cur = next((n for n in gpus if opt.gpu and opt.gpu.lower() in n.lower()), "")
                opt.gpu = _text_pick(tr("GPU de génération :"), [(tr("Automatique — celui du jeu"), "")] +
                                     [(n, n) for n in gpus], cur)
                save()
            elif cmd == "a":
                stop_capture(state["proc"])
                state["proc"], state["target"], state["how"] = None, None, None
                write_session(0)
            elif cmd == "m":
                table = [(tr("Désactivé (×1)"), "1"), (tr("Auto — jusqu'à la fréquence de l'écran"), "auto"),
                         (tr("Adaptatif — toute la fréquence, rapports fractionnaires"), "adaptive")] + \
                        [(f"×{n}", str(n)) for n in range(2, 9)]
                cur = "1" if not opt.generate else "adaptive" if opt.adaptive else \
                      "auto" if opt.auto_mult else str(opt.multiplier)
                v = _text_pick(tr("Multiplicateur :"), table, cur)
                opt.generate = v != "1"
                opt.adaptive = v == "adaptive"
                opt.auto_mult = v == "auto"
                if v.isdigit() and v != "1":
                    opt.multiplier = int(v)
                save()
            elif cmd == "o":
                opt.mode = _text_pick(tr("Mode :"), MODES, opt.mode)
                save()
            elif cmd == "p":
                opt.preset = _text_pick(tr("Préréglage :"), PRESETS, opt.preset)
                save()
            elif cmd == "h":
                opt.hud = _text_pick(tr("Compteur à l'écran :"), HUD_MODES, opt.hud)
                save()
            elif cmd == "j":
                opt.without_panel = _text_pick(
                    tr("Mode Jeu (Steam Deck) — tous les jeux génèrent dès leur lancement, sans le panneau :"),
                    [(tr("Non — le panneau décide (« Démarrer »)"), False), (tr("Oui"), True)], opt.without_panel)
                save()
            elif cmd == "s":
                print(tr("Options de lancement Steam équivalentes (par jeu) :"))
                print("  " + opt.steam_string())
            elif cmd == "b":
                path, url = write_report()
                if path:
                    print(tr(f"Rapport écrit dans {path} — à joindre au formulaire :"))
                    print("  " + (url or "(bdex-framegen --issue-url " + path + ")"))
                else:
                    print(tr("bdex-framegen introuvable : pas de rapport."))
    except KeyboardInterrupt:
        print()
    finally:
        stop.set()
        stop_capture(state["proc"])
        remove_session()
    return 0


if __name__ == "__main__":
    if not HAVE_GTK or "--text" in sys.argv[1:]:
        sys.exit(text_main())
    sys.exit(App().run(sys.argv))
