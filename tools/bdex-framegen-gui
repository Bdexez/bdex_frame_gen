# Every other layer option, in collapsed sections under "Réglages avancés".
# Each option maps a config key to a control:
#   spin   — a number (lower, upper, step, digits; digits 0 = integer)
#   switch — on/off, written as 1/0
#   choice — one of fixed values
#   text   — free text (paths)
# A value equal to its default is not written to the file (nor to the Steam
# string), so leaving these alone keeps the config minimal and the layer on
# its own defaults (config.h holds the same defaults).


def spin(key, title, sub, lower, upper, step, digits, default):
    return dict(kind="spin", key=key, title=title, sub=sub, lower=lower, upper=upper,
                step=step, digits=digits, default=_fmt_num(default, digits))


def switch(key, title, sub, default=False):
    return dict(kind="switch", key=key, title=title, sub=sub, default="1" if default else "0")


def choice(key, title, sub, choices, default):
    return dict(kind="choice", key=key, title=title, sub=sub, choices=choices, default=default)


def text(key, title, sub):
    return dict(kind="text", key=key, title=title, sub=sub, default="")


def _fmt_num(value, digits):
    if digits == 0:
        return str(int(round(value)))
    s = f"{value:.{digits}f}".rstrip("0").rstrip(".")
    return s or "0"


# The option sections are described once, in layer/options_ui.conf (labels,
# help, UI ranges), completed from the engine's option registry (kinds,
# defaults) by bdex_options at build time into options_ui.json — installed
# next to this panel, or found in the build tree when run from the sources.
def _m(text):
    """Plain text for an Adwaita row (its title and subtitle are Pango markup:
    "< 1" in a help text made the whole text vanish)."""
    return GLib.markup_escape_text(text)


def options_ui_path():
    here = os.path.dirname(os.path.realpath(__file__))
    for p in (os.environ.get("BDEX_FG_OPTIONS_UI"),
              os.path.join(here, "..", "share", "bdex-framegen", "options_ui.json"),
              os.path.join(here, "..", "build", "options_ui.json")):
        if p and os.path.isfile(p):
            return p
    return None


def load_sections():
    """[(id, title, subtitle, expanded, [option dict, ...])] for the panel."""
    path = options_ui_path()
    if not path:
        sys.stderr.write("bdex-framegen-gui: options_ui.json not found (build the project, or set "
                         "BDEX_FG_OPTIONS_UI); the advanced options are not shown\n")
        return []
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
    sections = []
    for sec in data:
        if not sec["gui"]:
            continue
        opts = []
        for o in sec["options"]:
            if not o["gui"]:
                continue
            k, key, label, sub = o["kind"], o["key"], o["label"], o["help"]
            if k == "switch":
                opts.append(switch(key, label, sub, o["default"] == "1"))
            elif k == "spin":
                opts.append(spin(key, label, sub, o["lo"], o["hi"], o["step"], o["digits"],
                                 float(o["default"] or 0)))
            elif k == "choice":
                opts.append(choice(key, label, sub, [(lab, val) for val, lab in o["choices"]], o["default"]))
            elif k == "text":
                opts.append(text(key, label, sub))
        sections.append((sec["id"], sec["title"], sec["subtitle"], sec["expanded"], opts))
    return sections


SECTIONS = load_sections()
OPTIONS = [o for _, _, _, _, opts in SECTIONS for o in opts]


def _parse_option(o, raw):
    """Canonical string of an option's value read from the file (default if absent/invalid)."""
    if raw is None:
        return o["default"]
    raw = raw.strip()
    if o["kind"] == "spin":
        if raw.lower() == "auto" and o["lower"] < 0:
            return _fmt_num(-1, o["digits"])  # "auto", shown as -1
        try:
            v = min(o["upper"], max(o["lower"], float(raw)))
        except ValueError:
            return o["default"]
        return _fmt_num(v, o["digits"])
    if o["kind"] == "switch":
        return "1" if raw.lower() in ("1", "true", "on", "yes") else "0"
    if o["kind"] == "choice":
        values = [v for _, v in o["choices"]]
        return raw.lower() if raw.lower() in values else o["default"]
    return raw


def _combo_index(table, value, default=0):
    for i, (_, v) in enumerate(table):
        if v == value:
            return i
    return default


# ---------------------------------------------------------------------------
# Config file: a tiny INI reader/writer that preserves keys the UI does not
# manage, so hand-written tuning in the file survives a save.
# ---------------------------------------------------------------------------

# Keys the UI owns in the global section; anything else found there is kept.
GLOBAL_KEYS = ("enabled", "require_app", "preset", "multiplier", "mode", "present_mode",
               "low_latency", "render_scale", "upscale_filter", "sharpness",
               "overlay", "hud", "paused") + tuple(o["key"] for o in OPTIONS)


class ConfigFile:
    def __init__(self):
        self.glob = {}                 # global ([*] / pre-section) key -> value
        self.games = []                # list of [name, dict(key->value)]

    @staticmethod
    def load(path=CONFIG_PATH):
        c = ConfigFile()
        try:
            with open(path) as f:
                lines = f.readlines()
        except OSError:
            return c
        section = None  # None = global preamble
        for raw in lines:
            t = raw.strip()
            if not t or t[0] in "#;":
                continue
            if t[0] == "[" and t[-1] == "]":
                name = t[1:-1].strip()
                section = None if name == "*" else name
                if section is not None and not c._game(section):
                    c.games.append([section, {}])
                continue
            if "=" not in t:
                continue
            k, v = t.split("=", 1)
            k, v = k.strip().lower(), v.strip()
            if section is None:
                c.glob[k] = v
            else:
                c._game(section)[1][k] = v
        return c

    def _game(self, name):
        for g in self.games:
            if g[0].lower() == name.lower():
                return g
        return None

    def game_dict(self, name):
        g = self._game(name)
        return g[1] if g else None

    def enabled_games(self):
        return [g[0] for g in self.games if g[1].get("enabled", "0") in ("1", "true", "on", "yes")]

    def set_game(self, name, on):
        g = self._game(name)
        if g is None:
            g = [name, {}]
            self.games.append(g)
        g[1]["enabled"] = "1" if on else "0"

    def remove_game(self, name):
        self.games = [g for g in self.games if g[0].lower() != name.lower()]

    def write(self, path=CONFIG_PATH):
        out = ["# bdex-framegen — written by the control panel (bdex-framegen-gui).\n",
               "# [*] applies to every game; a [name] section applies to that game only.\n",
               "\n[*]\n"]
        for k, v in self.glob.items():
            out.append(f"{k} = {v}\n")
        for name, d in self.games:
            out.append(f"\n[{name}]\n")
            for k, v in d.items():
                out.append(f"{k} = {v}\n")
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            f.write("".join(out))
        os.replace(tmp, path)


# ---------------------------------------------------------------------------
# UI state for the shared (global) options, mapped to config keys.
# ---------------------------------------------------------------------------

class Options:
    def __init__(self):
        self.generate = True
        self.preset = "auto"
        self.multiplier = 2
        self.auto_mult = True        # « Auto »: up to x4, never above the screen's refresh rate (target_fps = -1)
        self.mode = "interpolate"
        self.present = "auto"
        self.low_latency = False
        self.upscale = False
        self.render_scale = 67       # percent, 50..100
        self.filter = "lanczos"
        self.sharpness = 0           # percent, 0..100
        self.hud = 0                 # on-screen fps counter level, 0..4
        self.paused = False          # live pause (the layer reloads it while games run)
        self.values = {o["key"]: o["default"] for o in OPTIONS}   # canonical strings

    def load_from(self, glob):
        g = {k.lower(): v for k, v in glob.items()}

        def flag(key, default=False):
            return g.get(key, "1" if default else "0").lower() in ("1", "true", "on", "yes")

        self.preset = g.get("preset", "auto").lower()
        try:
            self.multiplier = int(float(g.get("multiplier", "2")))
        except ValueError:
            self.multiplier = 2
        self.generate = self.multiplier > 1
        if self.multiplier < 2:
            self.multiplier = 2
        # A file without a multiplier (new user) starts on « Auto ».
        self.auto_mult = "multiplier" not in g or g.get("target_fps", "").lower() in ("-1", "auto")
        self.mode = "extrapolate" if g.get("mode", "").lower().startswith("extrap") else "interpolate"
        self.present = g.get("present_mode", "auto").lower()
        self.low_latency = flag("low_latency")
        rs = g.get("render_scale")
        self.upscale = rs is not None and rs not in ("1", "1.0")
        try:
            self.render_scale = int(round(float(rs) * 100)) if rs else 67
        except ValueError:
            self.render_scale = 67
        self.filter = g.get("upscale_filter", "lanczos").lower()
        try:
            self.sharpness = int(round(float(g.get("sharpness", "0")) * 100))
        except ValueError:
            self.sharpness = 0
        hud = g.get("hud", g.get("overlay", "0")).lower()
        if hud in HUD_NAMED:
            self.hud = HUD_NAMED[hud]
        else:
            try:
                self.hud = max(0, min(4, int(float(hud))))
            except ValueError:
                self.hud = 0
        self.paused = flag("paused")
        for o in OPTIONS:
            self.values[o["key"]] = _parse_option(o, g.get(o["key"]))

    def write_into(self, glob):
        """Update the managed keys in `glob` in place, keeping unknown ones."""
        for k in GLOBAL_KEYS:
            glob.pop(k, None)
        glob["enabled"] = "1"       # every game armed ...
        glob["require_app"] = "1"   # ... generating only where this panel's « Démarrer » targets
        glob["preset"] = self.preset
        glob["multiplier"] = str((4 if self.auto_mult else self.multiplier) if self.generate else 1)
        if self.generate:
            glob["mode"] = self.mode
        glob["present_mode"] = self.present
        if self.low_latency:
            glob["low_latency"] = "1"
        if self.upscale and self.render_scale < 100:
            glob["render_scale"] = f"{self.render_scale / 100:.3f}".rstrip("0").rstrip(".")
            glob["upscale_filter"] = self.filter
            if self.sharpness > 0:
                glob["sharpness"] = f"{self.sharpness / 100:.2f}".rstrip("0").rstrip(".")
        if self.hud > 0:
            glob["overlay"] = str(self.hud)
        if self.paused:
            glob["paused"] = "1"
        for o in OPTIONS:
            value = self.values[o["key"]]
            if value != o["default"]:
                glob[o["key"]] = value
        # « Auto » is target_fps = -1 (the refresh rate); a fixed multiplier
        # drops it, whatever the advanced row still shows.
        if self.auto_mult and self.generate:
            glob["target_fps"] = "auto"
        elif glob.get("target_fps", "").lower() in ("-1", "auto"):
            glob.pop("target_fps")

    def steam_string(self):
        """Equivalent per-game Steam launch options (BDEX_FG_* ... %command%)."""
        e = ["BDEX_FG=1"]
        if self.preset != "auto":
            e.append(f"BDEX_FG_PRESET={self.preset}")
        e.append(f"BDEX_FG_MULTIPLIER={(4 if self.auto_mult else self.multiplier) if self.generate else 1}")
        if self.auto_mult and self.generate:
            e.append("BDEX_FG_TARGET_FPS=auto")
        if self.generate:
            e.append(f"BDEX_FG_MODE={self.mode}")
        e.append(f"BDEX_FG_PRESENT_MODE={self.present}")
        if self.low_latency:
            e.append("BDEX_FG_LOW_LATENCY=1")
        if self.upscale and self.render_scale < 100:
            e.append("BDEX_FG_RENDER_SCALE=" + f"{self.render_scale / 100:.3f}".rstrip("0").rstrip("."))
            e.append(f"BDEX_FG_UPSCALE_FILTER={self.filter}")
            if self.sharpness > 0:
                e.append("BDEX_FG_SHARPNESS=" + f"{self.sharpness / 100:.2f}".rstrip("0").rstrip("."))
        if self.hud > 0:
            e.append(f"BDEX_FG_OVERLAY={self.hud}")
        for o in OPTIONS:
            value = self.values[o["key"]]
            if value != o["default"]:
                e.append(f"BDEX_FG_{o['key'].upper()}={shlex.quote(value)}")
        return " ".join(e) + " %command%"


def find_layer():
    """(installed, path) — whether the loader can see the layer manifest."""
    dirs = [
        os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")),
                     "vulkan/implicit_layer.d"),
        "/usr/share/vulkan/implicit_layer.d",
        "/usr/local/share/vulkan/implicit_layer.d",
    ]
    for d in dirs:
        try:
            for f in os.listdir(d):
                if "bdex" in f.lower():
                    return True, os.path.join(d, f)
        except OSError:
            pass
    return False, None


def detect_gpus():
    """GPU names the Vulkan loader sees (best effort, via vulkaninfo)."""
    try:
        out = subprocess.run(["vulkaninfo", "--summary"], capture_output=True, text=True, timeout=8).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    names = []
    for line in out.splitlines():
        s = line.strip()
        if s.startswith("deviceName") and "=" in s:
            name = s.split("=", 1)[1].strip()
            if name and name not in names:
                names.append(name)
    return names


def status_dir():
    """Where the layer publishes one live status file per game (layer/src/status.h)
    and reads this panel's session: in the home, which Steam's container shares
    with Proton games (platformStatusDir)."""
    if "BDEX_FG_STATUS_DIR" in os.environ:
        return os.environ["BDEX_FG_STATUS_DIR"]
    home = os.environ.get("HOME")
    return os.path.join(home, ".cache", "bdex-framegen", "run") if home else f"/tmp/bdex-framegen-{os.getuid()}"


def session_path():
    """The session file the layer reads for require_app (platformAppSession)."""
    return os.path.join(status_dir(), "app.session")


def display_hz():
    """The highest refresh rate among the monitors (GDK reads it from the
    compositor / X server): the layer's target for « Auto » when it cannot
    measure the display itself (no present feedback, KDE + NVIDIA...)."""
    try:
        monitors = Gdk.Display.get_default().get_monitors()
        rates = [monitors.get_item(i).get_refresh_rate() for i in range(monitors.get_n_items())]
        return max(rates) / 1000.0 if rates else 0.0
    except Exception:  # no display, old GDK
        return 0.0


def write_session(target=0):
    """"<panel pid> <target pid> <refresh Hz>": the panel is open; `target`
    generates frames. Rewritten every second: the layer takes an older file for
    a closed panel."""
    os.makedirs(status_dir(), mode=0o700, exist_ok=True)
    tmp = session_path() + ".tmp"
    with open(tmp, "w") as f:
        f.write(f"{os.getpid()} {target} {display_hz():.3f}\n")
    os.replace(tmp, session_path())


def remove_session():
    try:
        with open(session_path()) as f:
            if int(f.read().split()[0]) != os.getpid():
                return  # another panel owns it
        os.remove(session_path())
    except (OSError, ValueError, IndexError):
        pass


def read_running():
    """Live status of the running games: [(pid, process, [entry dict, ...])]; stale files skipped."""
    out = []
    try:
        names = sorted(os.listdir(status_dir()))
    except OSError:
        return out
    for name in names:
        if not name.endswith(".status"):
            continue
        path = os.path.join(status_dir(), name)
        try:
            text = open(path, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        head, entries, cur = {}, [], None
        for line in text.splitlines():
            line = line.strip()
            if line.startswith("[") and line.endswith("]"):
                cur = {"kind": line[1:-1].split()[0]}
                entries.append(cur)
            elif "=" in line:
                k, _, v = line.partition("=")
                (cur if cur is not None else head)[k] = v
        try:
            pid = int(head.get("pid", "0"))
            os.kill(pid, 0)  # still running?
        except (ValueError, ProcessLookupError, PermissionError):
            try:
                os.unlink(path)  # left behind by a crashed game
            except OSError:
                pass
            continue
        out.append((pid, head.get("process", "?"), entries))
    return out


# Vulkan programs that are not games: the layer loads into them too (keep in
# sync with platformIsNonGame in layer/src/platform.cpp).
NOT_GAMES = {"steam", "steamwebhelper", "gamescope", "gamescopereaper", "chrome", "chromium",
             "firefox", "librewolf", "brave", "zen", "electron", "discord", "vesktop", "code",
             "obs", "vulkaninfo", "vkcube", "bdex-framegen-gui"}


def layer_name(arg):
    """A process's name as the layer matches [sections] (normalizeName in platform.cpp)."""
    base = arg.replace("\\", "/").rsplit("/", 1)[-1].strip().lower()
    return base.split(".", 1)[0]


def detect_games():
    """Running programs the layer is loaded into — every Vulkan program, native or
    through Proton (DXVK / VKD3D) — minus known non-games and GTK 4 applications
    (drawn with Vulkan; platformIsDesktopApp): [(pid, name)]."""
    out, me = [], os.getpid()
    for p in os.listdir("/proc"):
        if not p.isdigit() or int(p) == me:
            continue
        try:
            with open(f"/proc/{p}/maps", "rb") as f:
                maps = f.read()
            if b"libVkLayer_bdex_framegen" not in maps or b"libgtk-4.so" in maps:
                continue
            with open(f"/proc/{p}/cmdline", "rb") as f:
                args = [a.decode(errors="replace") for a in f.read().split(b"\0") if a.strip()]
        except OSError:
            continue
        if not args:
            continue
        exe = [a for a in args if a.lower().endswith(".exe")]  # Proton: the game's .exe
        first = args[0]
        if " " in first and not os.path.exists(first):
            first = first.split(" ", 1)[0]   # Electron & co. rewrite argv as one string
        name = layer_name(exe[0] if exe else first)
        try:
            args.append(os.readlink(f"/proc/{p}/exe"))   # the binary, for NOT_GAMES
        except OSError:
            pass
        if name and not NOT_GAMES & ({layer_name(a) for a in args[:2] + args[-1:]} | {name}):
            out.append((int(p), name))
    return out


def describe_entry(e):
    """One line of French for a status entry."""
    if e.get("kind") == "device":
        if e.get("state") == "active":
            return None
        return f"Couche inactive : {e.get('reason', e.get('state', ''))}"
    state = e.get("state", "")
    if state == "ready":
        return "Prêt — sélectionne-le puis « Démarrer »"
    if state == "pass-through":
        return f"Transparente — {e.get('reason', 'raison inconnue')}"
    parts = []
    try:
        game, outp = float(e.get("game_fps", 0)), float(e.get("output_fps", 0))
        parts.append(f"{game:.0f} → {outp:.0f} i/s (×{e.get('multiplier', '?')}, "
                     f"{'extrapolation' if e.get('mode') == 'extrapolate' else 'interpolation'})")
        hz = float(e.get("refresh_hz", 0))
        if hz > 0:
            parts.append(f"écran {hz:.0f} Hz")
        lat = float(e.get("latency_ms", -1))
        if lat >= 0:
            parts.append(f"latence {lat:.0f} ms")
        lvl = int(e.get("gpu_budget_level", 0))
        if lvl > 0:
            parts.append(f"budget GPU : niveau {lvl}")
    except ValueError:
        pass
    prefix = "En pause — " if state == "paused" else ""
    lines = [prefix + " · ".join(parts)]
    if e.get("passes"):
        lines.append("Passes : " + e["passes"].replace(",", ", "))
    if e.get("online_tune"):
        tune = e["online_tune"]
        if tune.startswith("trying "):
            tune = "essai de " + tune[len("trying "):].replace(" decided)", " décidées)").replace(" of ", " sur ")
        else:
            tune = tune.replace(" kept", " gardée").replace(" dropped", " écartée").replace("flow change", "variation du flux")
        lines.append("Réglage auto : " + tune)
    return "\n".join(lines)


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="bdex-framegen")
        self.set_default_size(600, 860)
        self.cfg = ConfigFile.load()
        self.opt = Options()
        self.opt.load_from(self.cfg.glob)
        self._loading = True   # suppress auto-save while building/populating

        self.toasts = Adw.ToastOverlay()
        self.set_content(self.toasts)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.toasts.set_child(box)

        header = Adw.HeaderBar()
        title = Adw.WindowTitle(title="bdex-framegen", subtitle="Génération d'images")
        header.set_title_widget(title)
        menu = Gtk.Button(icon_name="edit-copy-symbolic",
                          tooltip_text="Copier les options de lancement Steam équivalentes (par jeu)")
        menu.connect("clicked", self.on_copy)
        header.pack_end(menu)
        if HAVE_ADW:
            box.append(header)
        else:
            self.set_titlebar(header)

        # No horizontal scrolling: long texts wrap to the window's width.
        scroller = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        box.append(scroller)
        page = Adw.PreferencesPage()
        scroller.set_child(page)

        self._build_session(page)
        self._build_status(page)
        self._build_running(page)
        self._build_framegen(page)
        self._build_hud(page)
        self._build_upscale(page)
        self._build_present(page)
        self._build_advanced(page)

        self._loading = False
        self.refresh_sensitivity()
        # Every game armed, the session decides (require_app): written once.
        if self.cfg.glob.get("require_app") != "1" or self.cfg.glob.get("enabled") != "1":
            self.save()
        self.target = None     # (pid, name) where « Démarrer » started the generation
        self.selected = None   # (pid, name) chosen in « Jeux détectés »
        try:
            write_session(0)   # open: upscaling applies to games started from now
        except OSError as e:
            self.toast(f"Session impossible : {e}")
        self._refresh_running()
        GLib.timeout_add_seconds(1, self._beat)
        self.connect("close-request", self._on_close)

    def _beat(self):
        try:
            write_session(self.target[0] if self.target else 0)
        except OSError:
            pass
        return True

    def _on_close(self, *_):
        remove_session()       # the targeted game stops generating
        return False

    # -- sections ----------------------------------------------------------

    def _build_session(self, page):
        g = Adw.PreferencesGroup()
        page.add(g)
        self.session_row = Adw.ActionRow()
        self.session_icon = Gtk.Image(valign=Gtk.Align.CENTER)
        self.session_row.add_prefix(self.session_icon)
        self.session_btn = Gtk.Button(valign=Gtk.Align.CENTER)
        self.session_btn.connect("clicked", self.on_session)
        self.session_row.add_suffix(self.session_btn)
        g.add(self.session_row)

    def _refresh_session(self):
        on = self.target is not None
        if on:
            self.session_row.set_title(f"Génération en cours : {self.target[1]}")
            self.session_row.set_subtitle("Les réglages s'appliquent en direct. « Arrêter » ou fermer "
                                          "cette fenêtre coupe la génération.")
        else:
            self.session_row.set_title("Framegen arrêté")
            self.session_row.set_subtitle(
                f"Jeu sélectionné : {self.selected[1]} — clique « Démarrer »." if self.selected else
                "Lance ton jeu, sélectionne-le dans « Jeux détectés », puis « Démarrer ».")
        self.session_icon.set_from_icon_name("media-playback-start-symbolic" if on
                                             else "media-playback-stop-symbolic")
        self.session_btn.set_label("Arrêter" if on else "Démarrer")
        self.session_btn.set_sensitive(on or self.selected is not None)
        for c in ("suggested-action", "destructive-action"):
            self.session_btn.remove_css_class(c)
        self.session_btn.add_css_class("destructive-action" if on else "suggested-action")

    def _set_target(self, target):
        try:
            if target:
                self.save()   # the game reads the options shown here
            write_session(target[0] if target else 0)
        except OSError as e:
            self.toast(f"Échec : {e}")
            return
        self.target = target
        self._refresh_session()

    def on_session(self, _btn):
        self._set_target(None if self.target else self.selected)
        GLib.timeout_add(1500, self._refresh_after_switch)

    def _refresh_after_switch(self):
        self._refresh_running()   # the game's status follows within ~0.5 s
        return False

    def _build_status(self, page):
        g = Adw.PreferencesGroup(title="État")
        page.add(g)
        installed, path = find_layer()
        self.installed = installed
        self.status_row = Adw.ActionRow(
            title="Couche Vulkan",
            subtitle=("Installée — chargée automatiquement dans tous les jeux Vulkan"
                      if installed else
                      "Non installée : lance tools/install.sh pour qu'elle s'active sans options Steam"))
        self.status_row.add_prefix(Gtk.Image(
            icon_name="emblem-ok-symbolic" if installed else "dialog-warning-symbolic",
            valign=Gtk.Align.CENTER))
        if not installed:
            btn = Gtk.Button(label="Installer", valign=Gtk.Align.CENTER)
            btn.add_css_class("suggested-action")
            btn.connect("clicked", self.on_install)
            self.status_row.add_suffix(btn)
        g.add(self.status_row)

        gpus = detect_gpus()
        gpu_row = Adw.ActionRow(
            title="Carte graphique",
            subtitle=(" · ".join(gpus) + "\nProfil « Auto » : réglé selon ce GPU" if gpus else "non détectée"))
        gpu_row.add_prefix(Gtk.Image(icon_name="video-display-symbolic", valign=Gtk.Align.CENTER))
        g.add(gpu_row)

    def _build_running(self, page):
        """The games running now (Vulkan programs the layer is loaded into), like
        the Windows launcher's window list: pick one, then « Démarrer »."""
        self.running_group = Adw.PreferencesGroup(
            title="Jeux détectés",
            description="Jeux Vulkan en cours (natifs ou via Proton). Sélectionne celui où "
                        "générer des images, puis « Démarrer » en haut.")
        page.add(self.running_group)
        refresh = Gtk.Button(label="Actualiser la liste", valign=Gtk.Align.CENTER)
        refresh.connect("clicked", lambda *_: self._refresh_running())
        self.running_group.set_header_suffix(refresh)
        self.running_rows = []

    def _refresh_running(self):
        for row in self.running_rows:
            self.running_group.remove(row)
        self.running_rows = []
        status = {pid: entries for pid, _process, entries in read_running()}
        games, seen = [], set()
        for pid, name in sorted(detect_games(), key=lambda g: g[1]):
            if name not in seen:
                seen.add(name)
                games.append((pid, name, status.get(pid, [])))
        pids = {g[0] for g in games}
        if self.target and self.target[0] not in pids:   # the game has exited
            self._set_target(None)
        if self.selected and self.selected[0] not in pids:
            self.selected = None
        if not self.selected and len(games) == 1:
            self.selected = games[0][:2]
        self._refresh_session()
        if not games:
            row = Adw.ActionRow(title="Aucun jeu en cours",
                                subtitle="Lance un jeu Vulkan (natif ou via Proton), puis « Actualiser la liste »")
            self.running_group.add(row)
            self.running_rows.append(row)
            return
        group = None
        for pid, name, entries in games:
            lines = [d for d in (describe_entry(e) for e in entries) if d]
            armed = any(e.get("kind") == "swapchain" for e in entries)
            row = Adw.ActionRow(title=name, subtitle="\n".join(lines) if lines else
                                "Lancé avant l'installation de cette version — relance le jeu")
            radio = Gtk.CheckButton(valign=Gtk.Align.CENTER, sensitive=armed)
            if group is None:
                group = radio
            else:
                radio.set_group(group)
            radio.set_active(self.selected is not None and self.selected[0] == pid)
            radio.connect("toggled", self.on_pick, (pid, name))
            row.add_prefix(radio)
            row.set_activatable_widget(radio)
            self.running_group.add(row)
            self.running_rows.append(row)

    def on_pick(self, radio, game):
        if not radio.get_active():
            return
        self.selected = game
        if self.target and self.target != game:
            self._set_target(game)   # generating: move it to the chosen game
        self._refresh_session()

