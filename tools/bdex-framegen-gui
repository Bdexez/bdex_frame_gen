    def calibrate(self):
        self.cal_btn.set_sensitive(False)
        self.cal_row.set_subtitle(tr("Mesure en cours… (quelques secondes)"))

        def work():
            d = run_calibration()

            def done():
                self.cal_btn.set_sensitive(True)
                self.cal_apply.set_sensitive(d is not None)
                self.cal_row.set_subtitle(calibration_summary(d) if d else tr("La mesure a échoué"))
                return False
            GLib.idle_add(done)
        threading.Thread(target=work, daemon=True).start()

    def on_calibration_apply(self, _btn):
        d = read_calibration()
        if not d:
            return
        r = d["recommended"]
