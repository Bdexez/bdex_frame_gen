        refresh.connect("clicked", lambda *_: self._refresh_running())
        pick = Gtk.Button(label=tr("Capturer une autre fenêtre…"), valign=Gtk.Align.CENTER,
                          tooltip_text=tr("Un jeu absent de la liste (OpenGL, anti-triche…) : clique ensuite sur sa fenêtre"))
