#!/usr/bin/env python3
"""Control panel for the bdex-framegen Vulkan layer.

The layer is an *implicit* Vulkan layer: once installed it loads into every
Vulkan game automatically and stays a pure pass-through until it is turned on.
This window works like the Windows launcher: launch your game normally
(Steam...), pick it in "Jeux détectés", set the options, press "Démarrer" —
frame generation starts in the running game, "Arrêter" stops it, and the
options apply live. The panel always writes `enabled = 1` and `require_app =
1`: every Vulkan game is armed (the layer takes its swapchain and passes the
frames through) and only the game this window targets generates frames;
nothing happens with the window closed. Upscaling changes what the game
renders, so it applies to games started while this window is open.

Everything here is stored in the layer's config file
(~/.config/bdex-framegen.conf); the layer reads it on its own, so changes take
effect the next time a game starts.

Depends only on Python 3 and PyGObject with GTK 4 (packages python-gobject,
gtk4 on most distributions). libadwaita 1.4+ is used when installed; without
it (SteamOS, Debian 12, Ubuntu 22.04) the same widgets are built from plain
GTK 4 (_Compat).
"""
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import threading
import time


def _french():
    """The panel's language: French when the system's is (LANGUAGE, LC_ALL,
    LC_MESSAGES, LANG, the first one set), English otherwise; BDEX_LANG=fr|en
    chooses."""
    v = os.environ.get("BDEX_LANG", "")
    for var in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
        if v:
            break
        v = os.environ.get(var, "")
    return v.split(":")[0].lower().startswith("fr")


