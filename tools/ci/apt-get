#!/bin/sh
# apt-get for the CI containers: retries when a mirror cannot be reached.
# apt-get update only warns then and exits 0, and the install that follows
# finds no candidate — the job failed with nothing pointing at the network.
# Only network errors are retried: a missing package or a 404 (a release past
# its end of life) fails at once, as before, for the scripts' own fallbacks.
# Mounted as /opt/bdex-ci/apt-get, outside PATH (the scripts detect apt with
# `command -v apt-get`); each job puts it first only where /usr/bin/apt-get
# exists. Each attempt is bounded: a stalled mirror otherwise keeps apt-get
# waiting indefinitely (the runner's own apt hung 4 hours on 2026-10-08, see
# runner-apt.sh); a timed-out attempt counts as a network error.
net='Connection failed|Could not connect|Connection timed out|Temporary failure|Could not resolve|Unable to connect|Hash Sum mismatch|Network is unreachable'
log="$(mktemp)"
i=0
while :; do
  timeout 900 /usr/bin/apt-get -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 \
    "$@" >"$log" 2>&1
  rc=$?
  [ "$rc" -eq 124 ] && echo "Connection timed out (apt-get killed after 900 s)" >>"$log"
  if ! grep -Eq "$net" "$log"; then
    cat "$log"; rm -f "$log"; exit "$rc"
  fi
  i=$((i + 1))
  if [ "$i" -ge 5 ]; then
    cat "$log" >&2; echo "apt-get $1: mirror unreachable after $i tries" >&2
    rm -f "$log"; exit 100
  fi
  echo "apt-get $1: network error, retry $i in $((i * 15)) s" >&2
  grep -E "$net" "$log" | head -3 >&2
  sleep $((i * 15))
  # An install after a failed fetch needs fresh indexes.
  [ "$1" = update ] || /usr/bin/apt-get update -qq >/dev/null 2>&1 || true
done
