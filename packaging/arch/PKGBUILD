# Maintainer: Bdexez
# Development package built from the repository's main branch. Install with
# `makepkg -si` from this directory. The 32-bit layer (for 32-bit games) needs
# multilib and is not built here; see tools/install.sh.
pkgname=bdex-framegen-git
pkgver=0.3.0.r0.g0000000
pkgrel=1
pkgdesc="Frame generation (optical-flow interpolation/extrapolation) as a Vulkan layer, with a GTK control panel"
arch=('x86_64')
url="https://github.com/Bdexez/bdex_frame_gen"
license=('MIT')
depends=('vulkan-icd-loader' 'python-gobject' 'gtk4' 'libadwaita')
makedepends=('git' 'cmake' 'shaderc' 'vulkan-headers' 'glfw')
optdepends=('vulkan-tools: bdex-framegen --check and --report'
            'python-numpy: quality evaluation tools'
            'python-pillow: quality evaluation tools')
provides=('bdex-framegen')
conflicts=('bdex-framegen')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  # The project version from CMakeLists.txt, plus the commit count and hash
  # (not `git describe`: the release tags are not all ancestors of main).
  local v
  v="$(sed -n 's/^project(bdex_framegen VERSION \([0-9.]*\).*/\1/p' CMakeLists.txt)"
  printf '%s.r%s.g%s' "$v" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cmake -S "$pkgname" -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DBDEX_BUILD_TESTS=OFF -DBDEX_BUILD_DEMO=OFF -DBDEX_BUILD_OFFLINE=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
